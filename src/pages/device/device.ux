  .code { font-size: 38px; color: #3fb950; font-weight: bold; letter-spacing: 2px; lines: 1; text-align: center; }
  .status { font-size: 22px; color: #8b949e; margin-top: 14px; text-align: center; }
  .status.ok { color: #3fb950; }
  .check { font-size: 21px; color: #d29922; margin-top: 16px; padding: 12px 24px; }
  .cancel { font-size: 22px; color: #58a6ff; margin-top: 18px; padding: 12px 24px; }
  .retry { color: #3fb950; }
  .err-t { font-size: 25px; color: #f85149; text-align: center; padding: 0 10px; }
</style>

<script>import router from '@system.router';
