<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">{{full}}</text>
    </div>

    <!-- BandQQ v2.9.6 同构：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
    <scroll class="body" scroll-y="true">
      <div class="wrap">
        <!-- 描述卡 -->
        <div class="card">
          <text class="r-desc" show="{{!!desc}}">{{desc}}</text>
          <div class="meta">
            <div class="dot" show="{{!!lang}}" style="background-color: {{langc}}"></div>
            <text class="meta-t" show="{{!!lang}}">{{lang}}</text>
            <image class="meta-ic" src="/common/icons/star.png" />
            <text class="meta-t">{{stars}}</text>
            <image class="meta-ic" src="/common/icons/fork.png" />
            <text class="meta-t">{{forks}}</text>
            <image class="meta-ic" src="/common/icons/clock.png" />
            <text class="meta-t">{{updated}}</text>
          </div>
          <text class="r-sub">Watch {{watchers}} · Issues {{openIssues}} · {{license}}</text>
        </div>

        <!-- 操作区 -->
        <div class="grid">
          <div class="gcell" onclick="goReadme">
            <image class="gicon" src="/common/icons/book.png" />
            <text class="glabel">README</text>
          </div>
          <div class="gcell" onclick="goIssues">
            <image class="gicon" src="/common/icons/issue.png" />
            <text class="glabel">Issues</text>
          </div>
          <div class="gcell" onclick="goCode">
            <image class="gicon" src="/common/icons/code.png" />
            <text class="glabel">代码</text>
          </div>
          <div class="gcell" onclick="goReleases">
            <image class="gicon" src="/common/icons/book.png" />
            <text class="glabel">Releases</text>
          </div>
          <div class="gcell" onclick="goActions">
            <image class="gicon" src="/common/icons/gear.png" />
            <text class="glabel">Actions</text>
          </div>
          <div class="gcell" onclick="goAI">
            <image class="gicon" src="/common/icons/ai.png" />
            <text class="glabel">问 AI</text>
          </div>
          <div class="gcell" onclick="toggleStar">
            <image class="gicon" src="{{starred ? '/common/icons/star-fill.png' : '/common/icons/star.png'}}" />
            <text class="glabel">{{starred ? '已 Star' : 'Star'}}</text>
          </div>
          <!-- v1.9.0 新功能：PR 列表 + 订阅三态（off→on→ignore，配合通知降噪） -->
          <div class="gcell" onclick="goPulls">
            <image class="gicon" src="/common/icons/pull.png" />
            <text class="glabel">PR</text>
          </div>
          <div class="gcell" onclick="toggleSub">
            <image class="gicon" src="/common/icons/bell.png" />
            <text class="glabel">{{subState === 'on' ? '已订阅' : (subState === 'ignore' ? '已忽略' : '订阅')}}</text>
          </div>
        </div>

        <text class="hint" show="{{starHint}}">Star 需登录 Token</text>
        <text class="hint" show="{{subHint}}">订阅需登录 Token</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="reload">点此重试</text>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 44px; height: 44px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 64px; height: 64px; align-items: center; justify-content: center; margin-left: -10px; }
  .hd-title { font-size: 24px; font-weight: bold; color: #e6edf3; margin-left: 7px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .wrap { flex-direction: column; padding: 5px 12px 19px; }
  .card { background-color: #161b22; border-radius: 12px; padding: 12px; }
  .r-desc { font-size: 21px; color: #c9d1d9; lines: 3; text-overflow: ellipsis; }
  .meta { flex-direction: row; align-items: center; margin-top: 10px; }
  .dot { width: 11px; height: 11px; border-radius: 6px; margin-right: 4px; }
  .meta-ic { width: 14px; height: 14px; margin-left: 12px; margin-right: 2px; }
  .meta-t { font-size: 19px; color: #8b949e; }
  .r-sub { font-size: 20px; color: #484f58; margin-top: 7px; }
  .grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-top: 12px; }
  .gcell { width: 113px; height: 67px; background-color: #161b22; border-radius: 12px; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 10px; }
  .gicon { width: 24px; height: 24px; }
  .glabel { font-size: 19px; color: #e6edf3; margin-top: 5px; }
  .hint { font-size: 20px; color: #d29922; text-align: center; width: 100%; }
  .state { position: absolute; left: 0; top: 94px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; background-color: #0d1117; }
  .state-t { font-size: 22px; color: #8b949e; text-align: center; padding: 0 29px; }
  .state-btn { font-size: 21px; color: #58a6ff; margin-top: 12px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/gh' /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
  import { compact, relTime, langColor } from '../../utils/fmt'
  import { query } from '../../utils/view'

  export default {
    protected: {
      full: ''
    },
    private: {
      desc: '',
      lang: '',
      langc: '#30363d',
      stars: '0',
      forks: '0',
      watchers: '0',
      openIssues: '0',
      license: '',
      updated: '',
      starred: false,
      starHint: false,
      subState: 'off',
      subHint: false,
      state: 'loading',
      errMsg: ''
    },
    onInit(params) {
      const p = query(params, this)
      if (p.full) this.full = p.full
    },
    onShow() {
      if (this.full && this.state !== 'ok') this.reload()
    },
    async reload() {
      this.state = 'loading'
      try {
        const r = await api.getRepo(this.full)
        if (!r || typeof r !== 'object') {
          throw { message: '仓库响应不完整，请重试' }
        }
        this.desc = r.description || ''
        this.lang = r.language || ''
        this.langc = langColor(r.language)
        this.stars = compact(r.stargazers_count)
        this.forks = compact(r.forks_count)
        this.watchers = compact(r.subscribers_count)
        this.openIssues = compact(r.open_issues_count)
        this.license = r.license && r.license.spdx_id ? r.license.spdx_id : '无协议'
        this.updated = '更新于 ' + relTime(r.pushed_at)
        this.state = 'ok'
        this.checkStar()
        this.checkSub()
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '加载失败'
      }
    },
    async checkStar() {
      await api.loadToken()
      if (!api.hasToken()) return
      try {
        this.starred = await api.isStarred(this.full)
      } catch (e) {
        // 忽略 Star 状态查询失败
      }
    },
    /* ---- v1.9.0：订阅三态（off→on→ignore→off）——在手表上直接关掉噪音仓库通知 ---- */
    async checkSub() {
      if (!api.hasToken()) return
      try {
        const s = await api.getRepoSubscription(this.full)
        this.subState = (s && s.state) || 'off'
      } catch (e) {
        // 忽略订阅态查询失败
      }
    },
    async toggleSub() {
      await api.loadToken()
      if (!api.hasToken()) {
        this.subHint = true
        prompt.showToast({ message: '订阅需登录 Token', duration: 1500 })
        return
      }
      try {
        const order = ['off', 'on', 'ignore']
        const next = order[(order.indexOf(this.subState) + 1) % order.length]
        await api.setRepoSubscription(this.full, next)
        this.subState = next
        prompt.showToast({
          message: next === 'on' ? '已订阅通知' : (next === 'ignore' ? '已忽略此仓库通知' : '已取消订阅'),
          duration: 1600
        })
      } catch (e) {
        prompt.showToast({ message: (e && e.message) || '操作失败', duration: 2000 })
      }
    },
    async toggleStar() {
      await api.loadToken()
      if (!api.hasToken()) {
        this.starHint = true
        prompt.showToast({ message: 'Star 需登录 Token', duration: 1500 })
        return
      }
      try {
        const target = !this.starred
        await api.setStarred(this.full, target)
        this.starred = target
        prompt.showToast({ message: target ? '已 Star ⭐' : '已取消 Star', duration: 1500 })
      } catch (e) {
        prompt.showToast({ message: (e && e.message) || '操作失败', duration: 2000 })
      }
    },
    goReadme() {
      this.$app.$def.hook = { full: this.full }
      router.push({ uri: 'pages/readme' })
    },
    goIssues() {
      this.$app.$def.hook = { full: this.full }
      router.push({ uri: 'pages/issues' })
    },
    /* v1.9.0：PR 列表页 */
    goPulls() {
      this.$app.$def.hook = { full: this.full }
      router.push({ uri: 'pages/pulls' })
    },
    goCode() {
      this.$app.$def.hook = { full: this.full }
      router.push({ uri: 'pages/code' })
    },
    goReleases() {
      this.$app.$def.hook = { full: this.full }
      router.push({ uri: 'pages/releases' })
    },
    goActions() {
      this.$app.$def.hook = { full: this.full }
      router.push({ uri: 'pages/actions' })
    },
    /* v1.3.0：仓库上下文注入 Copilot 专区（README 摘要由 AI 页发送时补拉） */
    goAI() {
      this.$app.$def.aiCtx = { full: this.full, path: '', text: '当前仓库：' + this.full + (this.desc ? ('\n仓库简介：' + this.desc) : '') }
      router.push({ uri: 'pages/ai' })
    },
    goBack() {
      router.back()
    }
  }
</script>
