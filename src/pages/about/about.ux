<template>
  <div class="page">
    <div class="top-row">
      <div class="btn-wrap" onclick="goBack"><image class="btn" src="/common/icons/back.png"></image></div>
    </div>
    <div class="title-bar">
      <text class="page-title">关于</text>
    </div>
    <!-- BandQQ v2.9.6 同构：与 settings/index 同构，scroll absolute 铺满不依赖引擎 flex -->
    <div class="body-wrap">
    <scroll class="body" scroll-y="true">
      <div class="hero">
        <image class="icon" src="/common/icons/logo.png"></image>
        <text class="app-name">GitHub for Vela</text>
        <text class="ver">v2.0.2-pro · 手环 9/10 Pro · AGPL-3.0</text>
      </div>
      <div class="card col">
        <text class="line">运行在小米 Vela OS 手环上的 GitHub 客户端（手环 9 Pro / 10 Pro）：通知中心、仓库、README、Issues、PR、Releases、代码浏览、搜索与趋势，内置 GitHub Copilot AI 对话（设备授权免打字），支持 AstroBox 网桥为砍网机型恢复联网。</text>
      </div>
      <!-- v1.9.0：作者/联系方式与 BandQQ 同步（同一作者同一群） -->
      <div class="card col">
        <text class="k">作者</text>
        <text class="v">一秋</text>
      </div>
      <div class="card col">
        <text class="k">联系方式</text>
        <text class="v">QQ群 885186458</text>
      </div>
      <div class="card col" @click="copyIssues">
        <text class="k">问题反馈（点击复制链接）</text>
        <text class="v">github.com/Gsjsjzhznsz/vela-github-client/issues</text>
      </div>
      <div class="card col" @click="copyRepo">
        <text class="k">GitHub（点击复制链接）</text>
        <text class="v">github.com/Gsjsjzhznsz/vela-github-client</text>
      </div>
      <div class="card col">
        <text class="k">参考致谢</text>
        <text class="v2">BandQQ · Vela_input_method · 弦电子书</text>
      </div>
    </scroll>
    </div>
  </div>
</template>

<style>
  /* band-pro v2.0 BDS-336：BandQQ bandpro 同构（336 原生），主题统一 GitHub Dark #0d1117；
   * 主文本 22-24，卡片 radius 20（手环 9/10 Pro 336×480） */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .top-row { height: 96px; align-items: flex-start; justify-content: flex-start; padding-top: 10px; }
  .btn { width: 64px; height: 64px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .btn-wrap { width: 96px; height: 96px; align-items: center; justify-content: center; margin-left: -8px; }
  .title-bar { height: 44px; align-items: center; justify-content: center; }
  .page-title { font-size: 26px; color: #ffffff; }
  /* BandQQ v2.9.6：wrap flex:1 + scroll absolute 铺满（index/settings 同构方案） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .hero { flex-direction: column; align-items: center; margin: 12px 8px 6px 8px; }
  .icon { width: 80px; height: 80px; border-radius: 20px; }
  .app-name { font-size: 26px; color: #ffffff; margin-top: 8px; font-weight: bold; }
  .ver { font-size: 20px; color: rgba(255, 255, 255, 0.55); margin-top: 3px; }
  .card { border-width: 1px; border-color: rgba(255, 255, 255, 0.06); border-radius: 20px; background-color: #161b22; margin: 5px 10px; padding: 12px 14px; flex-direction: column; }
  .col { flex-direction: column; }
  .line { font-size: 22px; color: #dddddd; line-height: 32px; }
  .k { font-size: 19px; color: rgba(255, 255, 255, 0.45); }
  .v { font-size: 23px; color: #5b9bff; margin-top: 3px; }
  .v2 { font-size: 23px; color: #5b9bff; margin-top: 3px; line-height: 32px; }
</style>

<script>
  /* 关于页 —— 照搬 BandQQ pages/about（v2.28.2）结构与样式，仅替换本项目相关信息：
   *  - 布局同构：78px 顶部安全区 + 标题条 + wrap/absolute 铺满 scroll（RW5 黑屏根修）
   *  - 卡片语言：hero → 简介 → 作者 → 联系方式（v1.9.0 与 BandQQ 同步：一秋/QQ群）
   *    → 问题反馈 → GitHub → 致谢；链接点击复制到剪贴板（BandQQ 同款方案）
   *  - BandQQ 的演示模式彩蛋（连点 7 次）不适用本项目，已移除
   * 注：卡片 @click 与固件 div onclick 同义（BandQQ 原样保留，全项目混用已实证均可） */
  import router from '@system.router'
  import prompt from '@system.prompt'
  import clipboard from '@system.clipboard'

  const REPO_URL = 'https://github.com/Gsjsjzhznsz/vela-github-client'
  const ISSUES_URL = 'https://github.com/Gsjsjzhznsz/vela-github-client/issues'

  export default {
    private: {},
    goBack() {
      router.back()
    },
    /** GitHub 行点击复制仓库链接（快应用无法打开系统浏览器，复制后到手机粘贴访问） */
    copyRepo() {
      try {
        clipboard.set({
          text: REPO_URL,
          success: () => prompt.showToast({ message: '仓库链接已复制' }),
          fail: () => prompt.showToast({ message: '复制失败：github.com/Gsjsjzhznsz/vela-github-client' })
        })
      } catch (e) {
        prompt.showToast({ message: 'github.com/Gsjsjzhznsz/vela-github-client' })
      }
    },
    /** Issues 行点击复制反馈链接 */
    copyIssues() {
      try {
        clipboard.set({
          text: ISSUES_URL,
          success: () => prompt.showToast({ message: '反馈链接已复制' }),
          fail: () => prompt.showToast({ message: '复制失败：见 README 反馈指引' })
        })
      } catch (e) {
        prompt.showToast({ message: 'github.com/Gsjsjzhznsz/…/issues' })
      }
    }
  }
</script>
