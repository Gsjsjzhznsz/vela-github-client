<template>
  <!-- 键盘组件（参考 BandQQ InputMethod 架构）：
       1. 根容器显式定高，全链路无 auto 测量点，规避固件首帧坍缩问题
       2. if 懒建 + 保活：首次弹出才创建子树，之后 show 显隐不重建
       3. 事件回传：@key{ch} / @del / @ok，由宿主页维护文本缓冲
       4. 四行按键为顶层独立数组（row0..row3），全部走官方 $item 默认循环，
          无嵌套 for，无命名循环变量 -->
  <div class="kb-root" if="{{kbCreated}}" show="{{visible}}">
    <div class="kb-pad">
      <div class="kb-row">
        <div class="kb-key {{$item.cls}}" for="{{row0}}" onclick="onKey($item)">
          <text class="kb-key-text {{$item.small ? 'small' : ''}}">{{$item.label}}</text>
        </div>
      </div>
      <div class="kb-row">
        <div class="kb-key {{$item.cls}}" for="{{row1}}" onclick="onKey($item)">
          <text class="kb-key-text {{$item.small ? 'small' : ''}}">{{$item.label}}</text>
        </div>
      </div>
      <div class="kb-row">
        <div class="kb-key {{$item.cls}}" for="{{row2}}" onclick="onKey($item)">
          <text class="kb-key-text {{$item.small ? 'small' : ''}}">{{$item.label}}</text>
        </div>
      </div>
      <div class="kb-row">
        <div class="kb-key {{$item.cls}}" for="{{row3}}" onclick="onKey($item)">
          <text class="kb-key-text {{$item.small ? 'small' : ''}}">{{$item.label}}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .kb-root {
    width: 100%;
    height: 152px;
    background-color: #161b22;
    border-top: 1px solid #30363d;
    flex-direction: column;
  }
  .kb-pad {
    flex-direction: column;
    justify-content: flex-start;
    width: 100%;
    height: 152px;
    padding: 4px 6px;
  }
  .kb-row {
    flex-direction: row;
    height: 32px;
    margin-bottom: 4px;
    width: 100%;
  }
  .kb-key {
    flex: 1;
    height: 32px;
    margin: 0 2px;
    justify-content: center;
    align-items: center;
    background-color: #21262d;
    border-radius: 4px;
  }
  .kb-key-text {
    font-size: 13px;
    color: #e6edf3;
    text-align: center;
    lines: 1;
    text-overflow: clip;
  }
  .small {
    font-size: 10px;
  }
  .k-fn {
    flex: 1.4;
    background-color: #30363d;
  }
  .k-on {
    background-color: #1f6feb;
  }
  .k-space {
    flex: 4;
  }
  .k-ok {
    flex: 3;
    background-color: #238636;
  }
</style>

<script>
  import vibrator from '@system.vibrator'

  const LOWER = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm']
  const NUM1 = '1234567890'
  const NUM2 = '-_./:@#&+'
  const NUM3 = "$%()!?;'\""
  const TAIL = [',', '.', '_', '-']

  function charKey(ch, shift) {
    return { label: shift ? ch.toUpperCase() : ch, act: 'char', ch: ch, cls: '', small: false, on: true }
  }

  function fnKey(label, act, on) {
    return { label: label, act: act, cls: 'k-fn', on: on, small: true }
  }

  function buildRows(mode, shift) {
    const rows = []
    if (mode === 'abc') {
      rows.push(LOWER[0].split('').map((c) => charKey(c, shift)))
      rows.push(LOWER[1].split('').map((c) => charKey(c, shift)))
      const r2 = [fnKey('↑', 'shift', shift)]
      LOWER[2].split('').forEach((c) => r2.push(charKey(c, shift)))
      r2.push(fnKey('←', 'del', true))
      rows.push(r2)
    } else {
      rows.push(NUM1.split('').map((c) => charKey(c, false)))
      rows.push(NUM2.split('').map((c) => charKey(c, false)))
      const r2 = [fnKey('#', 'noop', false)]
      NUM3.split('').forEach((c) => r2.push(charKey(c, false)))
      r2.push(fnKey('←', 'del', true))
      rows.push(r2)
    }
    const r3 = [fnKey(mode === 'abc' ? '123' : 'abc', 'mode', true)]
    TAIL.forEach((c) => r3.push(charKey(c, false)))
    r3.push({ label: '空格', act: 'space', cls: 'k-space', small: true, on: true })
    r3.push({ label: '完成', act: 'ok', cls: 'k-ok', small: true, on: true })
    rows.push(r3)
    return rows // 4 组：0/1/2 字符排，3 为底部功能排
  }

  export default {
    props: {
      visible: { default: false },
      haptic: { default: true }
    },
    data: {
      kbCreated: false,
      mode: 'abc',
      shift: false,
      row0: [],
      row1: [],
      row2: [],
      row3: []
    },
    onInit() {
      const rs = buildRows(this.mode, this.shift)
      this.row0 = rs[0]
      this.row1 = rs[1]
      this.row2 = rs[2]
      this.row3 = rs[3]
      this.$watch('visible', 'onVisibleChange')
    },
    onVisibleChange(newV) {
      if (newV && !this.kbCreated) {
        // 首次弹出才懒建子树，之后保活
        this.kbCreated = true
      }
    },
    buzz() {
      if (!this.haptic) return
      try {
        vibrator.vibrate({ mode: 'short' })
      } catch (e) {
        // 振动失败不影响输入
      }
    },
    onKey(item) {
      if (!item || !item.act) return
      this.buzz()
      const act = item.act
      if (act === 'char') {
        this.$emit('key', { ch: this.shift ? String(item.ch).toUpperCase() : item.ch })
        if (this.shift && this.mode === 'abc') {
          // 大写输入一次后自动回落
          this.shift = false
          this.refreshRows()
        }
      } else if (act === 'del') {
        this.$emit('del', {})
      } else if (act === 'space') {
        this.$emit('key', { ch: ' ' })
      } else if (act === 'ok') {
        this.$emit('ok', {})
      } else if (act === 'mode') {
        this.mode = this.mode === 'abc' ? '123' : 'abc'
        this.shift = false
        this.refreshRows()
      } else if (act === 'shift') {
        if (this.mode === 'abc') {
          this.shift = !this.shift
          this.refreshRows()
        }
      }
    },
    refreshRows() {
      // 原地更新按键标签，避免整树重建
      const next = buildRows(this.mode, this.shift)
      const cur = [this.row0, this.row1, this.row2, this.row3]
      for (let ri = 0; ri < 4; ri++) {
        for (let ki = 0; ki < next[ri].length && ki < cur[ri].length; ki++) {
          cur[ri][ki].label = next[ri][ki].label
          cur[ri][ki].cls = next[ri][ki].cls
          cur[ri][ki].on = next[ri][ki].on
        }
      }
    }
  }
</script>
