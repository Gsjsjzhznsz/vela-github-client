<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <div class="hd-main">
        <text class="hd-title">{{full}}</text>
        <text class="hd-sub">README · 共 {{totalBlocks}} 段</text>
      </div>
    </div>

    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll">
      <div class="li" for="{{it in items}}" tid="id">
        <!-- 固件 elif 指令不可靠（BandQQ/InputMethod 全程零 elif 实证），
             块渲染统一为单 text 节点 + 动态 class（code.ux/BandQQ 同款已验证模式），
             显式 height 由 md.estBlockH 按 CSS 对齐估算（缺省 → undefinedpx 塌陷隐形） -->
        <text class="b-{{it.t}}" style="height: {{it.h}}px">{{it.s}}</text>
      </div>
      <div class="li" show="{{state === 'ok' && rendered < totalBlocks}}">
        <text class="foot" onclick="loadMoreBlocks">上滑加载更多…</text>
      </div>
      <div class="li" show="{{state === 'ok' && totalBlocks > 0 && rendered >= totalBlocks}}">
        <text class="foot">— 全文完 —</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载 README…</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="reload">点此重试</text>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 44px; height: 44px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 64px; height: 64px; align-items: center; justify-content: center; margin-left: -10px; }
  .hd-main { flex: 1; flex-direction: column; margin-left: 7px; }
  .hd-title { font-size: 24px; font-weight: bold; color: #e6edf3; lines: 1; text-overflow: ellipsis; }
  .hd-sub { font-size: 13px; color: #484f58; margin-top: 1px; }
  /* RW5 固件根修：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 60px; }
  .li { padding: 3px 14px; }
  /* 块样式与 md.js H_TABLE 严格对齐：显式 line-height 保证高度估算确定性 */
  .b-h { font-size: 22px; line-height: 30px; color: #58a6ff; font-weight: bold; margin-top: 5px; }
  .b-p { font-size: 17px; line-height: 24px; color: #e6edf3; }
  .b-c { font-size: 16px; line-height: 21px; color: #a5d6ff; background-color: #161b22; border-left: 2px solid #30363d; padding: 7px 10px; margin: 3px 0; }
  .b-q { font-size: 17px; line-height: 23px; color: #8b949e; border-left: 2px solid #30363d; padding-left: 10px; }
  .b-l { font-size: 17px; line-height: 24px; color: #e6edf3; }
  .b-r { font-size: 14px; line-height: 18px; color: #30363d; text-align: center; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 7px 0; }
  .state { position: absolute; left: 0; top: 94px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 19px; color: #8b949e; text-align: center; padding: 0 29px; }
  .state-btn { font-size: 17px; color: #58a6ff; margin-top: 12px; }
</style>

<script>
  import router from '@system.router'
  import api from '../../utils/api'
  import b64 from '../../utils/b64'
  import { mdToBlocks } from '../../utils/md'
  import { query } from '../../utils/view'

  const PAGE_CHUNK = 40

  export default {
    protected: {
      full: ''
    },
    private: {
      items: [],
      totalBlocks: 0,
      rendered: 0,
      state: 'loading',
      errMsg: ''
    },
    onInit(params) {
      const p = query(params, this)
      if (p.full) this.full = p.full
    },
    onShow() {
      if (this.full && this.state !== 'ok') this.reload()
    },
    async reload() {
      this.state = 'loading'
      try {
        let md = ''
        // v1.2.0 首选：raw.githubusercontent Range 分块（任意大小完整可达）
        let viaRaw = false
        try {
          const rr = await api.getReadmeText(this.full)
          if (rr && typeof rr.text === 'string' && rr.text) {
            md = rr.text
            viaRaw = true
          }
        } catch (e1) { /* 分块通道失败 → 回退 base64 通道 */ }
        if (!viaRaw) {
          const r = await api.getReadme(this.full)
          // 蓝牙代理对长响应可能截断/丢弃：r 非对象或缺 content 一律按失败处理，绝不渲染空文档
          if (!r || typeof r !== 'object' || typeof r.content !== 'string' || !r.content) {
            throw { message: 'README 响应不完整，请重试' }
          }
          md = b64.decode(r.content)
        }
        // 非响应式大数组挂在 this._ 前缀，遵循官方内存规范
        const blocks = mdToBlocks(md)
        if (!blocks || blocks.length === 0) {
          throw { message: 'README 为空或解码失败' }
        }
        this._allBlocks = blocks
        this.totalBlocks = blocks.length
        this.rendered = 0
        this.items = []
        this.appendMore()
        this.state = 'ok'
      } catch (e) {
        this._allBlocks = null
        this.totalBlocks = 0
        this.rendered = 0
        this.items = []
        this.state = 'error'
        this.errMsg = (e && e.message) || 'README 加载失败'
      }
    },
    appendMore() {
      if (!this._allBlocks) return
      const end = Math.min(this.totalBlocks, this.rendered + PAGE_CHUNK)
      for (let i = this.rendered; i < end; i++) {
        const b = this._allBlocks[i]
        // h 必须随块传给模板：style height 引用 it.h（v1.1.1 之前丢传 → 全部塌陷隐形）
        this.items.push({ id: 'b' + i, t: b.t, s: b.s, h: b.h })
      }
      this.rendered = end
    },
    onListScroll(e) {
      const y = (e && e.scrollY) || 0
      this._sy = y
      if (this.state === 'ok' && this.rendered < this.totalBlocks) {
        const near = this.items.length * 60 - 340
        if (near > 0 && y >= near) this.loadMoreBlocks()
      }
    },

    loadMoreBlocks() {
      if (this.state !== 'ok' || this.rendered >= this.totalBlocks) return
      this.appendMore()
    },
    onDestroy() {
      this._allBlocks = null
      this.items = []
    },
    goBack() {
      router.back()
    }
  }
</script>
