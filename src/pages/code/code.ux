              }
              const _temp = function () {
                if (list && typeof list === 'object' && list.type === 'file' && list.path) {
                  _this._filePath = list.path;
                  return Promise.resolve(_this.openFileText(list.path, list.name, list.size || 0)).then(function () {
                    _exit2 = true;
                  });
                }
              }();
              // 内容接口对单文件返回对象：仅当结构完整才按文件查看，
              // 其余（残缺 JSON / 字符串 / 空对象）一律报错，绝不渲染垃圾数据
              return _temp && _temp.then ? _temp.then(_temp2) : _temp2(_temp);
            }
          }();
          return _temp3 && _temp3.then ? _temp3.then(_temp4) : _temp4(_temp3);
        }
        let list = null;
        /* v1.4.0：GraphQL 瘦字段目录列表主通道（单条目 ~70B，响应缩 4-7 倍，
         * 中型目录在截断阈值内直达）；游客/限流/网络/路径是文件 → 回落
         * REST 阶梯（contents → 截断 → getTreeEx 下载器整树，v1.3.0 逻辑不变）；
         * 404（GitHub 路径区分大小写）直接抛明确文案。 */
        const _temp5 = _catch(function () {
          return Promise.resolve(api.getDirList(_this.full, _this.currentPath(), _this._branch)).then(function (_api$getDirList) {
            list = _api$getDirList;
          });
        }, function (eG) {
          if (eG && eG.status === 404) throw eG;
          return _catch(function () {
            return Promise.resolve(api.getContents(_this.full, _this.currentPath(), _this._branch)).then(function (_api$getContents) {
              list = _api$getContents;
            });
          }, function (e) {
            return function () {
              if (e && e.incomplete) {
                // v1.1.3：目录响应被蓝牙代理截断（contents 接口无 per_page 可降）——
                // 回退 git trees API：条目瘦 3-4 倍，大目录可完整到达；
                // 子树定位用上一级缓存的目录 sha（根用 HEAD）
                // v1.3.0：改用 getTreeEx——trees 的 fetch 响应对巨型目录仍会截断，
                // 原生下载器整树一次到齐（深目录数据不完整的根治）
                const sha = _this._shaStack.length ? _this._shaStack[_this._shaStack.length - 1] : 'HEAD';
                return Promise.resolve(api.getTreeEx(_this.full, sha)).then(function (t) {
                  const arr = t && Array.isArray(t.tree) ? t.tree : null;
                  if (!arr) throw {
                    message: '目录响应不完整，请重试'
                  };
                  list = [];
                  for (let i = 0; i < arr.length; i++) {
                    const x = arr[i];
                    list.push({
                      name: x.path.split('/').pop(),
                      path: x.path,
                      type: x.type === 'tree' ? 'dir' : 'file',
                      size: x.size || 0,
                      sha: x.sha || ''
                    });
                  }
                });
              } else {
                throw e;
              }
            }();
          });
        });
        return _temp5 && _temp5.then ? _temp5.then(_temp6) : _temp6(_temp5);
      }, function (e) {
        _this.state = 'error';
        _this.errMsg = e && e.message || '加载失败';
      }));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  /* 目录渲染统一出口：缓存命中/网络拉取共用（分页 + 滚动复位 + 路径文本） */
  applyDirList(out) {
    this._dirEntries = out;
    this.dirPages = Math.max(1, Math.ceil(out.length / PAGE_DIR));
    this.renderDirPage(1);
