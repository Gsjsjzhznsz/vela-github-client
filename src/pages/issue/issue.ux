
<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <div class="hd-main">
        <text class="hd-title">{{full}} #{{n}}</text>
        <text class="hd-sub">{{commentN}} 条评论</text>
      </div>
    </div>

    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll">
      <!-- 标题头 -->
      <div class="li">
        <div class="head-card">
          <div class="badge {{open ? 'b-open' : 'b-closed'}}">
            <text class="badge-t">{{isPR ? (open ? 'PR · 开放' : 'PR · 已合并/关闭') : (open ? 'Issue · 开放' : 'Issue · 已关闭')}}</text>
          </div>
          <text class="h-title">{{title}}</text>
          <text class="h-meta">{{author}} · 创建于 {{created}}</text>
          <text class="lb" show="{{labelsText}}" style="color: {{labelColor}}">{{labelsText}}</text>
        </div>
      </div>

      <!-- 正文块：单 text 节点 + 动态 class（固件 elif 不可靠，readme 页同款修复） -->
      <div class="li" for="{{it in bodyBlocks}}" tid="id">
        <text class="b-{{it.t}}" style="height: {{it.h}}px">{{it.s}}</text>
      </div>

      <!-- 评论分隔 -->
      <div class="li">
        <text class="sepa-t">—— 评论 ——</text>
      </div>

      <!-- 写评论入口 -->
      <div class="li">
        <div class="cmt-card" onclick="openComposer">
          <text class="compose-label">写评论{{sending ? ' · 发送中…' : ''}}</text>
          <text class="compose-hint">{{canCmt ? '点击用拼音键盘发表评论' : '需登录 Token 后使用'}}</text>
        </div>
      </div>

      <!-- 评论项 -->
      <div class="li" for="{{it in comments}}" tid="id">
        <div class="cmt-card">
          <div class="cmt-hd">
            <div class="ava" style="background-color: {{it.avc}}">
              <text class="ava-t">{{it.avn}}</text>
            </div>
            <text class="cmt-author">{{it.author}}</text>
            <text class="cmt-time">{{it.time}}</text>
          </div>
          <text class="cmt-body" show="{{it.text}}">{{it.text}}</text>
          <text class="cmt-empty" show="{{!it.text}}">（无正文）</text>
        </div>
      </div>

      <div class="li" show="{{loadingComments}}">
        <text class="foot">加载评论中…</text>
      </div>
      <div class="li" show="{{state === 'ok' && !hasMoreComments && comments.length > 0}}">
        <text class="foot">— 到底了 —</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="reload">点此重试</text>
    </div>

  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 44px; height: 44px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 64px; height: 64px; align-items: center; justify-content: center; margin-left: -10px; }
  .hd-main { flex: 1; flex-direction: column; margin-left: 7px; }
  .hd-title { font-size: 24px; font-weight: bold; color: #e6edf3; lines: 1; text-overflow: ellipsis; }
  .hd-sub { font-size: 13px; color: #484f58; margin-top: 1px; }
  /* RW5 固件根修：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 60px; }
  .li { padding: 3px 14px; }
  .head-card { background-color: #161b22; border-radius: 12px; padding: 12px; width: 100%; flex-direction: column; }
  .badge { align-self: flex-start; border-radius: 12px; padding: 2px 10px; }
  .b-open { background-color: #238636; }
  .b-closed { background-color: #8957e5; }
  .badge-t { font-size: 14px; color: #ffffff; }
  .h-title { font-size: 20px; color: #e6edf3; font-weight: bold; margin-top: 7px; lines: 3; text-overflow: ellipsis; }
  .h-meta { font-size: 14px; color: #8b949e; margin-top: 5px; }
  .labels { flex-direction: row; flex-wrap: wrap; margin-top: 7px; }
  .lb { font-size: 13px; margin-right: 7px; border: 1px solid #30363d; border-radius: 10px; padding: 1px 7px; }
  /* 块样式与 md.js H_TABLE 严格对齐（readme 页同款）：显式 line-height 保证估算确定性 */
  .b-h { font-size: 22px; line-height: 30px; color: #58a6ff; font-weight: bold; margin-top: 5px; }
  .b-p { font-size: 17px; line-height: 24px; color: #e6edf3; }
  .b-c { font-size: 16px; line-height: 21px; color: #a5d6ff; background-color: #161b22; border-left: 2px solid #30363d; padding: 7px 10px; margin: 3px 0; }
  .b-q { font-size: 17px; line-height: 23px; color: #8b949e; border-left: 2px solid #30363d; padding-left: 10px; }
  .b-l { font-size: 17px; line-height: 24px; color: #e6edf3; }
  .b-r { font-size: 14px; line-height: 18px; color: #30363d; text-align: center; }
  .sepa-t { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 7px 0; }
  .cmt-card { background-color: #161b22; border-radius: 12px; padding: 11px 12px; width: 100%; flex-direction: column; }
  .cmt-hd { flex-direction: row; align-items: center; }
  .ava { width: 24px; height: 24px; border-radius: 12px; justify-content: center; align-items: center; }
  .ava-t { font-size: 14px; color: #ffffff; font-weight: bold; }
  .cmt-author { font-size: 17px; color: #58a6ff; margin-left: 7px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .cmt-time { font-size: 13px; color: #484f58; }
  .cmt-body { font-size: 17px; color: #c9d1d9; line-height: 22px; margin-top: 7px; }
  .cmt-empty { font-size: 16px; color: #484f58; margin-top: 5px; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 7px 0; }
  .state { position: absolute; left: 0; top: 94px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 19px; color: #8b949e; text-align: center; padding: 0 29px; }
  .state-btn { font-size: 17px; color: #58a6ff; margin-top: 12px; }
  .compose-label { font-size: 18px; color: #58a6ff; font-weight: bold; }
  .compose-hint { font-size: 14px; color: #484f58; margin-top: 4px; }
</style>

<script>
  import router from '@system.router'
  import api from '../../utils/api'
  import { mdToBlocks } from '../../utils/md'
  import { relTime, truncate, avatar } from '../../utils/fmt'
  import { mapIssue } from '../../utils/view'
  import { query } from '../../utils/view'

  export default {
    protected: {
      full: '',
      n: ''
    },
    private: {
      title: '',
      open: true,
      isPR: false,
      author: '',
      created: '',
      labelsText: '',
      labelColor: '#8b949e',
      commentN: 0,
      bodyBlocks: [],
      comments: [],
      state: 'loading',
      errMsg: '',
      loadingComments: false,
      hasMoreComments: false,
      sending: false,
      canCmt: false
    },
    onInit(params) {
      const p = query(params, this)
      if (p.full) this.full = p.full
      if (p.n) this.n = String(p.n)
    },
    onShow() {
      // 消费独立输入页回传的评论草稿
      const app = this.$app.$def
      const r = app && app.inputResult
      if (r && r.type === 'comment' && r.text) {
        app.inputResult = null
        this.sendComment(r.text)
      }
      this.canCmt = api.hasToken()
      if (this.full && this.n && this.state !== 'ok') this.reload()
    },
    async reload() {
      this.state = 'loading'
      try {
        const iss = await api.getIssue(this.full, this.n)
        if (!iss || typeof iss !== 'object') {
          throw { message: 'Issue 响应不完整，请重试' }
        }
        const m = mapIssue(iss)
        this.title = m.title
        this.open = m.open
        this.isPR = !!iss.pull_request
        this.author = m.author
        this.created = m.time
        this.labelsText = (iss.labels || []).map((l) => l.name).join(' · ')
        this.labelColor = iss.labels && iss.labels[0] && iss.labels[0].color ? '#' + iss.labels[0].color : '#8b949e'
        this.commentN = iss.comments || 0
        this.canCmt = api.hasToken()
        const body = mdToBlocks(iss.body || '')
        const blocks = []
        for (let i = 0; i < body.length && i < 80; i++) {
          // h 必须随块传给模板（同 readme 页根因修复）
          blocks.push({ id: 'b' + i, t: body[i].t, s: body[i].s, h: body[i].h })
        }
        this.bodyBlocks = blocks
        this._cmtsUrl = iss.comments_url || ''
        this.comments = []
        this._cPage = 0
        this.hasMoreComments = this.commentN > 0
        this.state = 'ok'
        this.loadMoreComments()
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '加载失败'
      }
    },
    onListScroll(e) {
      const y = (e && e.scrollY) || 0
      this._sy = y
      if (this.state === 'ok' && this.hasMoreComments && !this.loadingComments) {
        const near = (this.bodyBlocks.length * 40 + this.comments.length * 90) - 340
        if (near > 0 && y >= near) this.loadMoreComments()
      }
    },

    async loadMoreComments() {
      if (this.state !== 'ok' || this.loadingComments || !this.hasMoreComments) return
      this.loadingComments = true
      try {
        const next = this._cPage + 1
        const list = await api.getComments(this._cmtsUrl, next)
        for (let i = 0; i < list.length; i++) {
          const c = list[i]
          const av = avatar(c.user ? c.user.login : '?')
          this.comments.push({
            id: String(c.id),
            author: c.user ? c.user.login : '未知',
            time: relTime(c.created_at),
            text: truncate((c.body || '').replace(/\r/g, ''), 500),
            avn: av.ch,
            avc: av.color
          })
        }
        this._cPage = next
        this.hasMoreComments = list.length >= api.lastListPerPage()
      } catch (e) {
        // 评论加载失败不打断页面
      }
      this.loadingComments = false
    },
    onDestroy() {
      this.bodyBlocks = []
      this.comments = []
    },
    /* ---- 评论发表（T9 拼音键盘） ---- */
    /* 写评论：跳 BandQQ compose 同构输入页（键盘常驻），onShow 消费草稿并发送 */
    openComposer() {
      if (!api.hasToken()) {
        prompt.showToast({ message: '发表评论需登录 Token（设置页）', duration: 2000 })
        return
      }
      this.$app.$def.hook = { type: 'comment', initial: '' }
      router.push({ uri: 'pages/input' })
    },

    async sendComment(body) {
      if (!body) return
      if (!this._cmtsUrl || this.sending) return
      this.sending = true
      try {
        const c = await api.addComment(this._cmtsUrl, body)
        const av = avatar(c.user ? c.user.login : '?')
        this.comments.push({
          id: String(c.id),
          author: c.user ? c.user.login : '我',
          time: '刚刚',
          text: truncate((c.body || '').replace(/\r/g, ''), 500),
          avn: av.ch,
          avc: av.color
        })
        this.commentN += 1
        prompt.showToast({ message: '评论已发表', duration: 1500 })
      } catch (e) {
        prompt.showToast({ message: '发表失败：' + ((e && e.message) || ''), duration: 2000 })
      }
      this.sending = false
    },
    goBack() {
      router.back()
    }
  }
</script>
