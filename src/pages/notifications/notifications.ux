<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">通知{{unreadN > 0 ? ' (' + unreadN + ')' : ''}}</text>
      <text class="hd-filter" onclick="toggleAll">{{filterLabel}}</text>
      <div class="hd-act-wrap" onclick="markAllRead"><image class="hd-act" src="/common/icons/check.png" /></div>
    </div>

    <!-- v1.8.0：类型芯片行（开发者分诊：全部/Issue/PR/CI/其他） -->
    <div class="chips">
      <text class="{{c.cls}}" for="{{chips}}" tid="c.k" onclick="setType(c)">{{c.label}}</text>
    </div>

    <!-- v1.8.0：概览行（N 仓库 · M 条 · CI K）+ CI 一键已读 -->
    <div class="sum">
      <text class="sum-t">{{sumText}}</text>
      <text class="sum-btn" show="{{ciN > 0}}" onclick="markAllCiRead">CI 全部已读</text>
    </div>

    <div class="pull" style="height: {{pullY}}px">
      <image class="pull-icon" src="/common/icons/refresh.png" />
      <text class="pull-text">{{pullText}}</text>
    </div>

    <!-- RW5 固件根修（BandQQ v2.9.6 同构）：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll"
              ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
        <!-- v1.9.0 深度优化：单层平铺列表 = 分组头 + 条目卡 + 组操作行交错。
             分组头：点击折叠/展开，长按 = 整仓已读；静音组自动沉底默认折叠 -->
        <div class="li" for="{{f in flat}}" tid="f.key">
          <div class="ghdr" show="{{f.hdr}}" onclick="toggleGroup(f)" onlongpress="markRepoRead(f)">
            <text class="gh-arrow">{{f.open ? '－' : '＋'}}</text>
            <text class="gh-repo">{{f.repo}}</text>
            <text class="gh-muted" show="{{f.muted}}">已静音</text>
            <text class="gh-n">{{f.unreadN > 0 ? f.unreadN + '/' : ''}}{{f.count}}条</text>
          </div>
          <div class="cell" show="{{!f.hdr && !f.act}}" onclick="openNotif(f)" onlongpress="markOne(f)">
            <div class="unread" show="{{f.unread}}"></div>
            <image class="cell-icon" src="{{f.icon}}" />
            <div class="cell-main">
              <text class="cell-title" show="{{!f.aggN || f.aggN <= 1}}">{{f.title}}</text>
              <text class="cell-title" show="{{f.aggN > 1}}">{{f.aggN}} 条 CI（未读 {{f.unreadN}}）</text>
              <div class="cell-meta">
                <text class="cell-ci" show="{{f.ci}}">CI</text>
                <text class="cell-time">{{f.time}}{{f.unread ? ' · 长按已读' : ''}}</text>
              </div>
            </div>
          </div>
          <!-- v1.9.0：组内操作行（展开时可见）——整仓已读/静音的显式入口 -->
          <div class="actrow" show="{{f.act && f.show}}">
            <text class="actbtn" onclick="actRepoRead(f)">整仓已读</text>
            <text class="actbtn2" onclick="actMute(f)">{{f.muted ? '取消静音' : '静音此仓库'}}</text>
          </div>
        </div>
        <text class="foot warn" show="{{warnText}}" onclick="doRefresh">{{warnText}}</text>
        <text class="foot" show="{{state === 'ok' && hasMore}}" onclick="loadMore">已载 {{totalN}} 条 · 点此加载更多</text>
        <text class="foot" show="{{state === 'ok' && !hasMore && itemsN > 0}}">— 已载全部 {{totalN}} 条 —</text>
        <div class="pad-end"></div>
      </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">{{emptyText}}</text>
      <text class="state-btn" onclick="doRefresh">重新加载</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doRefresh">点此重试</text>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  /* v1.9.0 深度优化：全页字号放大（designWidth 432 下 14px=7dp 肉眼难辨），
   * 芯片行 flex-wrap 两行排布（单行 5 枚必溢出圆屏边缘），分组头/条目卡加高加大点击区 */
  .hd { height: 96px; flex-direction: row; align-items: center; padding: 0 14px; }
  .hd-act { width: 46px; height: 46px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 72px; height: 72px; align-items: center; justify-content: center; margin-left: -12px; }
  .hd-title { font-size: 25px; font-weight: bold; color: #e6edf3; margin-left: 6px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .hd-filter { font-size: 21px; color: #58a6ff; margin-right: 8px; padding: 8px 12px; background-color: #161b22; border-radius: 16px; }
  /* v1.9.0：类型芯片行——flex-wrap 两行排布 */
  .chips { flex-direction: row; flex-wrap: wrap; padding: 4px 14px 2px; }
  .chip { font-size: 21px; color: #8b949e; border-radius: 18px; padding: 8px 18px; margin: 4px 8px 4px 0; background-color: #161b22; }
  .chip-on { font-size: 21px; color: #ffffff; border-radius: 18px; padding: 8px 18px; margin: 4px 8px 4px 0; background-color: #1f6feb; }
  /* v1.9.0：概览行 */
  .sum { flex-direction: row; align-items: center; padding: 2px 14px 6px; }
  .sum-t { font-size: 19px; color: #6e7681; flex: 1; lines: 1; text-overflow: ellipsis; }
  .sum-btn { font-size: 19px; color: #d29922; padding: 6px 10px; }
  .pull { flex-direction: row; align-items: center; justify-content: center; overflow: hidden; }
  .pull-icon { width: 19px; height: 19px; }
  .pull-text { font-size: 19px; color: #8b949e; margin-left: 8px; }
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 12px; }
  .li { padding: 4px 14px; }
  /* v1.9.0：仓库分组头（点击折叠 / 长按整仓已读 / 静音徽标） */
  .ghdr { flex-direction: row; align-items: center; background-color: #1c2128; border-radius: 12px; padding: 13px 14px; }
  .gh-arrow { font-size: 22px; color: #58a6ff; width: 30px; }
  .gh-repo { font-size: 22px; color: #c9d1d9; font-weight: bold; flex: 1; lines: 1; text-overflow: ellipsis; }
  .gh-muted { font-size: 19px; color: #d29922; margin-right: 8px; padding: 2px 8px; border-radius: 8px; background-color: #282013; }
  .gh-n { font-size: 19px; color: #8b949e; margin-left: 8px; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 14px; padding: 13px 14px; }
  .unread { position: absolute; left: 3px; top: 3px; width: 10px; height: 10px; border-radius: 5px; background-color: #3fb950; }
  .cell-icon { width: 26px; height: 26px; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 12px; }
  .cell-title { font-size: 23px; color: #e6edf3; margin-top: 2px; lines: 2; text-overflow: ellipsis; }
  .cell-meta { flex-direction: row; align-items: center; margin-top: 3px; }
  .cell-ci { font-size: 18px; color: #d29922; padding: 1px 7px; border-radius: 7px; background-color: #282013; margin-right: 7px; }
  .cell-time { font-size: 19px; color: #6e7681; }
  /* v1.9.0：组内操作行——整仓已读/静音的显式入口（长按不可发现的补充） */
  .actrow { flex-direction: row; align-items: center; padding: 2px 0 6px; }
  .actbtn { font-size: 19px; color: #58a6ff; padding: 8px 14px; margin-right: 10px; background-color: #16233a; border-radius: 12px; }
  .actbtn2 { font-size: 19px; color: #d29922; padding: 8px 14px; background-color: #282013; border-radius: 12px; }
  .foot { font-size: 19px; color: #6e7681; text-align: center; width: 100%; padding: 8px 0; }
  .warn { color: #d29922; }
  .hint { color: #8b949e; padding: 14px 0; }
  .state { position: absolute; left: 0; top: 96px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 22px; color: #8b949e; text-align: center; padding: 0 30px; }
  .state-btn { font-size: 21px; color: #58a6ff; margin-top: 14px; padding: 8px 16px; background-color: #16233a; border-radius: 12px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import storage from '@system.storage'
  import api from '../../utils/gh'
  import { mapNotif, aggregateNotifs, groupNotifsByRepo } from '../../utils/view'

  /* v1.8.0 通知中心彻底重构（开发者分诊导向）：
   *  ① 缓存秒开——最近一次列表（瘦字段 ≤150 条）按过滤档落 storage，
   *     进页先渲染缓存再后台刷新：网络抖动/截断不再白屏报错，
   *     「响应数据不完整」从硬错误降级为 footnote 警告。
   *  ② 仓库分组——单层平铺（分组头+条目交错，规避嵌套 for 固件坑），
   *     点头折叠/展开；开发者多仓库通知一眼分仓。
   *  ③ 类型芯片——全部/Issue/PR/CI/其他 五档（与三态过滤正交叠加）。
   *  ④ 分仓清理——长按分组头 = PUT /repos/{o}/{r}/notifications 整仓已读；
   *     CI 一键已读 = 当前列表全部 CI 线程并发标已读。 */
  const CACHE_KEY = 'notif_cache_v2_'
  const CACHE_CAP = 150
  /* v1.9.0：本地静音仓库（通知降噪第三层：分组/芯片之后的根治手段）。
   * 静音后：分组沉底 + 默认折叠 + 摘要行计数；仅本地生效，不动 GitHub 订阅。 */
  const MUTE_KEY = 'notif_muted_repos'

  const CHIPS = [
    { k: '', label: '全部' },
    { k: 'Issue', label: 'Issue' },
    { k: 'PullRequest', label: 'PR' },
    { k: 'ci', label: 'CI' },
    { k: 'other', label: '其他' }
  ]

  export default {
    private: {
      flat: [],
      all: false,
      /* v1.3.0 三态过滤：unread（未读）| all（全部）| mine（仅参与） */
      filter: 'unread',
      /* v1.8.0 类型筛选：'' | Issue | PullRequest | ci | other */
      typeFilter: '',
      chips: [],
      state: 'loading',   // loading | ok | empty | error
      errMsg: '',
      emptyText: '暂无通知',
      warnText: '',
      page: 1,
      hasMore: true,
      loadingMore: false,
      refreshing: false,
      scY: 0,
      tY: 0,
      pullY: 0,
      pullText: '下拉刷新',
      unreadN: 0,
      gaps: 0,
      totalN: 0,
      itemsN: 0,
      ciN: 0,
      sumText: '',
      filterLabel: '未读'
    },
    onInit() {
      this._raw = []          /* 当前过滤档的聚合后全量卡（非响应式） */
      this._lastLoad = 0      /* 上次网络成功时间（90s 去重） */
      this._fromCache = false
      this._muted = {}        /* v1.9.0：静音仓库表 {repo: true}（非响应式） */
      this._openOverride = {} /* v1.9.0：用户手动开合的分组状态（跨重建保留） */
      this.chips = this.buildChips()
      this.loadMuted()
    },
    /* ---- v1.9.0 静音仓库 ---- */
    loadMuted() {
      try {
        storage.get({
          key: MUTE_KEY,
          success: (d) => {
            try {
              const arr = d ? JSON.parse(d) : null
              const m = {}
              if (Array.isArray(arr)) for (let i = 0; i < arr.length; i++) m[arr[i]] = true
              this._muted = m
            } catch (e) { this._muted = {} }
          },
          fail: () => { this._muted = {} }
        })
      } catch (e) { this._muted = {} }
    },
    saveMuted() {
      try {
        const arr = []
        for (const k in this._muted) if (this._muted[k]) arr.push(k)
        storage.set({ key: MUTE_KEY, value: JSON.stringify(arr) })
      } catch (e) {}
    },
    isMuted(repo) { return !!(repo && this._muted && this._muted[repo]) },
    /** 静音/取消静音（组内操作行按钮）：更新表→落盘→重建平铺 */
    actMute(f) {
      if (!f || !f.repo) return
      if (this._muted[f.repo]) delete this._muted[f.repo]
      else this._muted[f.repo] = true
      this.saveMuted()
      this.rebuild()
      prompt.showToast({ message: this._muted[f.repo] ? ('已静音 ' + f.repo) : ('已取消静音 ' + f.repo), duration: 1500 })
    },
    /** 操作行「整仓已读」按钮（与长按分组头同效，可见可点） */
    actRepoRead(f) { this.markRepoRead(f) },
    /* ---- v1.8.0 芯片（class 表达式固件不可靠 → 预计算 cls） ---- */
    buildChips() {
      const out = []
      for (let i = 0; i < CHIPS.length; i++) {
        const c = CHIPS[i]
        out.push({
          k: c.k,
          label: c.label,
          cls: c.k === this.typeFilter ? 'chip-on' : 'chip'
        })
      }
      return out
    },
    setType(c) {
      if (!c || this.typeFilter === c.k) return
      this.typeFilter = c.k
      this.chips = this.buildChips()
      this.rebuild()
    },
    /* v1.3.0：filter 标签同步（模板不可调函数，数据驱动） */
    syncFilterLabel() {
      this.filterLabel = this.filter === 'unread' ? '未读' : (this.filter === 'all' ? '全部' : '仅参与')
    },
    async onShow() {
      await api.loadToken()
      if (!api.hasToken()) {
        this.state = 'empty'
        this.emptyText = '通知需登录：请到首页 → 设置填入 Token'
        return
      }
      if (this._raw.length === 0) {
        /* 缓存秒开：先渲染上次列表（无网络等待），再后台刷新 */
        const cached = await this.loadCache()
        if (cached.length) {
          this._raw = cached
          this._fromCache = true
          this.applyData({ fromCache: true })
          this.state = this.flat.length ? 'ok' : 'loading'
        }
        if (this.state !== 'ok') this.state = 'loading'
        this.reload()
      } else if (Date.now() - this._lastLoad > 90000) {
        this.reload()
      }
    },
    /* ---- 缓存读写（瘦字段，聚合卡 threads 截 40 条） ---- */
    loadCache() {
      return new Promise((resolve) => {
        try {
          storage.get({
            key: CACHE_KEY + this.filter,
            success: (d) => {
              try {
                const arr = d ? JSON.parse(d) : null
                resolve(Array.isArray(arr) ? arr : [])
              } catch (e) { resolve([]) }
            },
            fail: () => resolve([])
          })
        } catch (e) { resolve([]) }
      })
    },
    saveCache() {
      try {
        const slim = []
        for (let i = 0; i < this._raw.length && i < CACHE_CAP; i++) {
          const it = this._raw[i]
          slim.push({
            id: it.id, icon: it.icon, repo: it.repo, title: it.title,
            unread: it.unread, time: it.time, url: it.url, threadUrl: it.threadUrl,
            ci: it.ci, stype: it.stype, avn: it.avn, avc: it.avc,
            aggN: it.aggN || 0, unreadN: it.unreadN || 0,
            threads: (it.threads || []).slice(0, 40)
          })
        }
        storage.set({ key: CACHE_KEY + this.filter, value: JSON.stringify(slim) })
      } catch (e) {}
    },
    /* ---- 类型过滤（作用于聚合后卡片） ---- */
    typePass(it) {
      const tf = this.typeFilter
      if (!tf) return true
      if (tf === 'ci') return !!it.ci
      if (tf === 'Issue') return it.stype === 'Issue'
      if (tf === 'PullRequest') return it.stype === 'PullRequest'
      /* 其他：非 CI 的 Release/Commit/… 全收 */
      return !it.ci && it.stype !== 'Issue' && it.stype !== 'PullRequest'
    },
    /* ---- 单层平铺重建（分组头 + 条目交错）---- */
    rebuild() {
      const items = []
      for (let i = 0; i < this._raw.length; i++) {
        if (this.typePass(this._raw[i])) items.push(this._raw[i])
      }
      this.applyGroups(groupNotifsByRepo(items))
    },
    toggleGroup(f) {
      if (!f || !f.hdr) return
      /* v1.9.0：记录手动开合（静音组默认折叠，手动展开后跨重建保留） */
      this._openOverride[f.repo] = !f.open
      this.rebuildOpen(f.repo, !f.open)
    },
    /* toggleGroup 后按新 open 重建平铺（保持其余组状态） */
    rebuildOpen(repo, open) {
      const items = []
      for (let i = 0; i < this._raw.length; i++) {
        if (this.typePass(this._raw[i])) items.push(this._raw[i])
      }
      const groups = groupNotifsByRepo(items)
      for (let i = 0; i < groups.length; i++) {
        if (groups[i].repo === repo) groups[i].open = open
      }
      this.applyGroups(groups)
    },
    /* groups → 平铺 + 统计（rebuild 与 rebuildOpen 共用尾部）。
     * v1.9.0：静音组沉底 + 默认折叠 + 徽标；每组尾部追加操作行。 */
    applyGroups(groups) {
      const flat = []
      let ciN = 0
      let itemsN = 0
      let unreadN = 0
      let mutedN = 0
      /* 稳定沉底：非静音组保持原序在前，静音组追加在后 */
      const ordered = []
      const muted = []
      for (let i = 0; i < groups.length; i++) {
        if (this.isMuted(groups[i].repo)) muted.push(groups[i])
        else ordered.push(groups[i])
      }
      for (let i = 0; i < muted.length; i++) ordered.push(muted[i])
      for (let i = 0; i < ordered.length; i++) {
        const g = ordered[i]
        const mut = this.isMuted(g.repo)
        if (mut) mutedN++
        /* 开合态：用户手动开合 > 静音默认折叠 > 默认展开 */
        const ov = this._openOverride[g.repo]
        const open = ov !== undefined ? ov : (mut ? false : true)
        g.open = open
        flat.push({
          key: 'h' + i + '_' + g.repo, hdr: true, open: open, muted: mut,
          repo: g.repo, count: g.count, unreadN: g.unreadN, ciN: g.ciN
        })
        if (open) {
          for (let j = 0; j < g.items.length; j++) {
            const it = g.items[j]
            it.key = it.id
            flat.push(it)
          }
        }
        flat.push({ key: 'a' + i + '_' + g.repo, act: true, show: open, repo: g.repo, muted: mut })
        ciN += g.ciN
        itemsN += g.count
        unreadN += g.unreadN
      }
      this.flat = flat
      this.itemsN = itemsN
      this.ciN = ciN
      this.unreadN = unreadN
      this.totalN = itemsN
      this.sumText = groups.length + ' 仓库 · ' + itemsN + ' 条' + (ciN > 0 ? ' · CI ' + ciN : '') + (mutedN > 0 ? ' · 静音 ' + mutedN : '') + (this._fromCache ? ' · 缓存' : '')
    },
    /* 网络数据落地（reload/loadMore 成功后统一入口） */
    applyData() {
      this.rebuild()
      this.state = this.flat.length ? 'ok' : 'empty'
      this.emptyText = this.filter === 'mine'
        ? '参与的对话已全部处理\n右上角切「全部」看 CI 通知'
        : (this.all ? '没有通知' : '没有未读通知')
      if (this.state === 'empty' && this.typeFilter) {
        this.emptyText = '该类型暂无通知'
      }
    },
    async reload() {
      this.syncFilterLabel()
      this._openOverride = {} /* 新数据：重置手动开合（静音组回到默认折叠） */
      try {
        const list = await api.getNotifications(1, this.all, this.filter === 'mine')
        if (!Array.isArray(list)) {
          throw { message: '通知响应不完整，请重试' }
        }
        const gaps = api.lastNotifGaps().length
        if (list.length === 0 && gaps > 0 && this._raw.length === 0) {
          throw { message: '通知响应不完整（双通道均失败），请重试' }
        }
        if (list.length === 0 && gaps > 0) {
          /* 有缓存数据兜底：不整页报错，只挂警告行 */
          this.gaps = gaps
          this.warnText = '有 ' + gaps + ' 段未载入 · 点此重试'
          this._lastLoad = Date.now()
          this.saveCache()
          return
        }
        this._fromCache = false
        this._raw = aggregateNotifs(list.map(mapNotif))
        this.page = 1
        this.gaps = gaps
        this.warnText = gaps > 0 ? ('有 ' + gaps + ' 段未载入 · 点此重试') : ''
        this.hasMore = list.length + gaps * 2 >= api.notifPageSize()
        this._lastLoad = Date.now()
        this.applyData()
        this.saveCache()
      } catch (e) {
        if (this._raw.length) {
          /* v1.8.0：有缓存/旧数据兜底——网络失败不再白屏，
             只挂警告行（「响应数据不完整」降级为非致命） */
          this.warnText = ((e && e.message) || '加载失败') + ' · 展示的是上次数据'
          this.state = 'ok'
        } else {
          this.state = 'error'
          this.errMsg = (e && e.message) || '加载失败'
        }
      }
    },
    async loadMore() {
      if (!this.hasMore || this.loadingMore || this.state !== 'ok') return
      this.loadingMore = true
      try {
        const next = this.page + 1
        const list = await api.getNotifications(next, this.all, this.filter === 'mine')
        const gaps = api.lastNotifGaps().length
        if (!Array.isArray(list) || (list.length === 0 && gaps > 0)) {
          throw { message: '通知响应不完整，请重试' }
        }
        const agg = aggregateNotifs(list.map(mapNotif))
        const tail = this._raw[this._raw.length - 1]
        const head = agg[0]
        if (tail && head && tail.ci && head.ci && tail.repo === head.repo && tail.aggN) {
          tail.threads = tail.threads.concat(head.threads)
          tail.aggN = tail.aggN + head.aggN
          tail.unreadN = (tail.unreadN || 0) + (head.unreadN || 0)
          tail.unread = tail.unreadN > 0
          tail.time = head.time
          agg.shift()
        }
        for (let i = 0; i < agg.length; i++) this._raw.push(agg[i])
        this.page = next
        this.gaps = gaps
        this.hasMore = list.length + gaps * 2 >= api.notifPageSize()
        this._lastLoad = Date.now()
        this.applyData()
        this.saveCache()
      } catch (e) {
        prompt.showToast({ message: '加载失败：' + ((e && e.message) || ''), duration: 1500 })
      }
      this.loadingMore = false
    },
    /** v1.3.0：三态循环 未读 → 全部 → 仅参与；all/participating 联动 */
    toggleAll() {
      if (this.filter === 'unread') { this.filter = 'all'; this.all = true }
      else if (this.filter === 'all') { this.filter = 'mine'; this.all = true }
      else { this.filter = 'unread'; this.all = false }
      this._raw = []
      this._fromCache = false
      this.state = 'loading'
      this.syncFilterLabel()
      this.reload()
    },
    async markAllRead() {
      try {
        await api.markAllNotificationsRead()
        for (let i = 0; i < this._raw.length; i++) {
          this._raw[i].unread = false
          if (this._raw[i].aggN > 1) this._raw[i].unreadN = 0
        }
        this.applyData()
        prompt.showToast({ message: '已全部标记已读', duration: 1500 })
      } catch (e) {
        prompt.showToast({ message: (e && e.message) || '操作失败', duration: 2000 })
      }
    },
    /** v1.8.0：CI 一键已读——当前列表全部 CI 聚合卡线程并发标已读 */
    async markAllCiRead() {
      const threads = []
      for (let i = 0; i < this._raw.length; i++) {
        const it = this._raw[i]
        if (it.ci && it.unread) {
          if (it.threads && it.threads.length) {
            for (let j = 0; j < it.threads.length; j++) threads.push(it.threads[j])
          } else if (it.threadUrl) threads.push(it.threadUrl)
        }
      }
      if (!threads.length) {
        prompt.showToast({ message: '没有未读 CI 通知', duration: 1200 })
        return
      }
      prompt.showToast({ message: '正在标记 ' + threads.length + ' 条 CI…', duration: 1200 })
      try {
        const ok = await api.markThreadsRead(threads)
        for (let i = 0; i < this._raw.length; i++) {
          if (this._raw[i].ci) { this._raw[i].unread = false; this._raw[i].unreadN = 0 }
        }
        this.applyData()
        prompt.showToast({ message: '已标记 ' + ok + ' 条 CI 已读', duration: 1500 })
      } catch (e) {
        prompt.showToast({ message: (e && e.message) || '操作失败', duration: 1500 })
      }
    },
    /** v1.8.0：整仓已读（长按分组头）——PUT /repos/{o}/{r}/notifications */
    async markRepoRead(f) {
      if (!f || !f.repo) return
      try {
        await api.markRepoNotificationsRead(f.repo)
        for (let i = 0; i < this._raw.length; i++) {
          if (this._raw[i].repo === f.repo) {
            this._raw[i].unread = false
            if (this._raw[i].aggN > 1) this._raw[i].unreadN = 0
          }
        }
        this.applyData()
        prompt.showToast({ message: f.repo + ' 全部已读', duration: 1500 })
      } catch (e) {
        prompt.showToast({ message: (e && e.message) || '操作失败', duration: 1500 })
      }
    },
    async openNotif(item) {
      if (!item || item.hdr) return
      // v1.2.3：CI 通知/聚合卡 → Actions 页（workflow 运行列表）
      if (item.ci) {
        if (item.unread) {
          item.unread = false
          this.rebuild()
        }
        this.$app.$def.hook = { full: item.repo }
        router.push({ uri: 'pages/actions' })
        return
      }
      if (item.unread) {
        item.unread = false
        this.rebuild()
        api.markThreadRead(item.threadUrl).catch(function () {})
      }
      if ((item.icon === '/common/icons/issue.png' || item.icon === '/common/icons/pull.png') && item.url) {
        const n = item.url.split('/').pop()
        this.$app.$def.hook = { full: item.repo, n: n }
        router.push({ uri: 'pages/issue' })
      } else {
        this.$app.$def.hook = { full: item.repo }
        router.push({ uri: 'pages/repo' })
      }
    },
    /** 长按：CI 聚合卡 → 批量已读（该段全部线程并行标记）；普通通知仅标记单条 */
    async markOne(item) {
      if (!item || item.hdr) return
      if (item.ci && item.aggN > 1) {
        try {
          const ok = await api.markThreadsRead(item.threads)
          item.unread = false
          item.unreadN = 0
          this.rebuild()
          prompt.showToast({ message: '已标记 ' + ok + ' 条 CI 已读', duration: 1500 })
        } catch (e) {
          prompt.showToast({ message: (e && e.message) || '操作失败', duration: 1500 })
        }
        return
      }
      if (!item.unread) return
      item.unread = false
      this.rebuild()
      try {
        await api.markThreadRead(item.threadUrl)
        prompt.showToast({ message: '已标记已读', duration: 1200 })
      } catch (e) {
        prompt.showToast({ message: (e && e.message) || '操作失败', duration: 1500 })
      }
    },
    /* ---- 下拉刷新（list 自定义手势） ---- */
    doRefresh() {
      if (this.refreshing) return
      this.refreshing = true
      this.pullY = 60
      this.pullText = '刷新中…'
      this.reload().then(() => {
        this.refreshing = false
        this.pullY = 0
      })
    },
    onListScroll(e) {
      this.scY = (e && e.scrollY) || 0
      // 触底自动加载（scroll 组件无 scrollbottom，用 scrollY 估算：单项约 110px）
      if (this.state === 'ok' && this.hasMore && !this.loadingMore) {
        const near = this.flat.length * 110 - 420
        if (near > 0 && this.scY >= near) this.loadMore()
      }
    },
    onTouchStart(e) {
      if (this.scY <= 0 && !this.refreshing) {
        const t = e && e.touches && e.touches[0]
        this.tY = (t && (t.pageY || t.clientY)) || 0
      }
    },
    onTouchMove(e) {
      if (this.refreshing || this.tY <= 0 || this.scY > 0) return
      const t = e && e.touches && e.touches[0]
      const y = (t && (t.pageY || t.clientY)) || 0
      const delta = y - this.tY
      if (delta > 0) {
        this.pullY = Math.min(112, Math.floor(delta * 0.45))
        this.pullText = this.pullY > 80 ? '松开刷新' : '下拉刷新'
      }
    },
    onTouchEnd() {
      if (this.refreshing) return
      if (this.pullY > 80) {
        this.doRefresh()
      } else {
        this.pullY = 0
      }
      this.tY = 0
    },
    goBack() {
      router.back()
    }
  }
</script>
