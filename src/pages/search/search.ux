<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <div class="hd">
      <image class="hd-act" src="/common/icons/back.png" onclick="goBack" />
      <text class="hd-title">搜索仓库</text>
      <image class="hd-act" src="/common/icons/refresh.png" onclick="doRefresh" />
    </div>

    <div class="srow">
      <div class="sbox" onclick="showKb">
        <text class="stext {{query ? '' : 'ph'}}">{{query ? kbTail : '输入关键词…'}}</text>
      </div>
      <text class="sbtn" onclick="doSearch">搜索</text>
    </div>

    <!-- RW5 固件根修（BandQQ v2.9.6 同构）：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll">
      <div class="li" for="{{it in items}}" tid="id">
        <div class="cell" onclick="openRepo(it)">
          <div class="ava" style="background-color: {{it.avc}}">
            <text class="ava-t">{{it.avn}}</text>
          </div>
          <div class="cell-main">
            <text class="cell-title">{{it.full}}</text>
            <text class="cell-desc" show="{{!!it.desc}}">{{it.desc}}</text>
            <div class="meta">
              <div class="dot" show="{{!!it.lang}}" style="background-color: {{it.langc}}"></div>
              <text class="meta-t" show="{{!!it.lang}}">{{it.lang}}</text>
              <image class="meta-ic" src="/common/icons/star.png" />
              <text class="meta-t">{{it.stars}}</text>
            </div>
          </div>
        </div>
      </div>
      <div class="li" show="{{state === 'ok' && !hasMore && items.length > 0}}">
        <text class="foot">共 {{total}} 个结果 · 到底了</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">搜索中…</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">{{emptyText}}</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doSearch">重试</text>
    </div>

    <!-- Vela_input_method 组件键盘（NEORUAA，MIT）：T9 大键适配 216 宽方屏，支持拼音/英文 -->
    <!-- BandQQ v2.23.0 实战版键盘（NEORUAA 上游 + 20+ 轮真机修复）：
         三层显式定高根治首帧坍缩/按键漂移；rect=横向滚动 QWERTY+拼音 IME -->
    <div class="kb-dock" show="{{kbShow}}">
      <input-method hide="{{false}}" screentype="rect" keyboardtype="QWERTY" maxlength="5" vibratemode="short" @complete="onKbChar" @delete="onKbDel"></input-method>
    </div>

    <!-- 键盘操作条（画在键盘之上）：草稿预览 + 搜索 + 收起 -->
    <div class="kb-bar" show="{{kbShow}}">
      <text class="kb-bar-t">{{query ? kbTail : '输入…'}}</text>
      <text class="kb-bar-ok" onclick="onKbOk">搜索</text>
      <text class="kb-bar-x" onclick="hideKb">收起</text>
    </div>
  </div>
</template>

<style>
  .page { position: relative; width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 50px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 25px; height: 25px; }
  .hd-title { font-size: 20px; font-weight: bold; color: #e6edf3; margin-left: 8px; flex: 1; lines: 1; text-overflow: ellipsis }
  .srow { flex-direction: row; align-items: center; padding: 2px 12px 8px; }
  .sbox { flex: 1; height: 38px; background-color: #161b22; border: 1px solid #30363d; border-radius: 19px; justify-content: center; padding: 0 12px; }
  .stext { font-size: 15px; color: #e6edf3; lines: 1; text-overflow: ellipsis; }
  .ph { color: #484f58; }
  .sbtn { font-size: 15px; color: #ffffff; background-color: #238636; border-radius: 19px; padding: 9px 15px; margin-left: 10px; lines: 1; text-overflow: ellipsis }
  /* RW5 固件根修：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 18px; }
  .li { padding: 4px 12px; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 12px; padding: 11px 12px; }
  .ava { width: 38px; height: 38px; border-radius: 19px; justify-content: center; align-items: center; }
  .ava-t { font-size: 16px; color: #ffffff; font-weight: bold; lines: 1; text-overflow: ellipsis }
  .cell-main { flex: 1; flex-direction: column; margin-left: 10px; }
  .cell-title { font-size: 18px; color: #58a6ff; font-weight: bold; lines: 1; text-overflow: ellipsis; }
  .cell-desc { font-size: 14px; color: #8b949e; margin-top: 2px; lines: 2; text-overflow: ellipsis; }
  .meta { flex-direction: row; align-items: center; margin-top: 5px; }
  .dot { width: 10px; height: 10px; border-radius: 5px; margin-right: 4px; }
  .meta-ic { width: 14px; height: 14px; margin-left: 10px; margin-right: 2px; }
  .meta-t { font-size: 12px; color: #8b949e; lines: 1; text-overflow: ellipsis }
  .foot { font-size: 12px; color: #484f58; text-align: center; width: 100%; padding: 8px 0; lines: 1; text-overflow: ellipsis }
  .state { position: absolute; left: 0; top: 98px; right: 0; bottom: 50px; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 16px; color: #8b949e; text-align: center; padding: 0 30px; lines: 1; text-overflow: ellipsis }
  .state-btn { font-size: 15px; color: #58a6ff; margin-top: 12px; lines: 1; text-overflow: ellipsis }
  /* BandQQ v2.23.0 dock 集成（v2.16 去 flex 化 + v2.18 顶部锚定）：
    top 125 = 视口 257 - 键盘 132（rect 264 物理px ÷2 @ designWidth216）
    kb-bar 95 = dock 上沿 125 - 操作条 30，草稿/动作贴键盘 */
  .kb-dock { position: absolute; left: 0; top: 250px; width: 100%; height: 264px; }
  .kb-bar { position: absolute; left: 0; top: 212px; width: 100%; height: 38px; background-color: #161b22; border-bottom: 1px solid #30363d; flex-direction: row; align-items: center; padding: 0 10px; }
  .kb-bar-t { font-size: 15px; color: #e6edf3; flex: 1; lines: 1; text-overflow: ellipsis; }
  .kb-bar-ok { font-size: 15px; color: #ffffff; background-color: #238636; border-radius: 15px; padding: 5px 12px; margin-left: 8px; lines: 1; text-overflow: ellipsis }
  .kb-bar-x { font-size: 15px; color: #8b949e; margin-left: 10px; lines: 1; text-overflow: ellipsis }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/api'
  import { mapRepo } from '../../utils/view'


  export default {
    private: {
      query: '',
      kbTail: '',
      kbShow: false,
      items: [],
      state: 'empty',   // empty | loading | ok | error
      errMsg: '',
      emptyText: '输入关键词开始搜索',
      total: 0,
      page: 1,
      hasMore: true,
      loadingMore: false,
      searched: false
    },
    onInit() {
    },
    showKb() {
      this.kbShow = true
    },
    hideKb() {
      this.kbShow = false
    },
    onKbChar(e) {
      const c = (e && e.detail && e.detail.content) || ''
      if (c && this.query.length < 64) {
        this.query = (this.query + c).slice(0, 64)
        this.syncTail()
      }
    },
    onKbDel() {
      this.query = this.query.slice(0, -1)
      this.syncTail()
    },
    onKbOk() {
      this.kbShow = false
      if (this.query.trim()) this.doSearch()
    },
    syncTail() {
      const q = this.query
      this.kbTail = q.length > 20 ? '…' + q.slice(-19) : q
    },
    async doSearch() {
      const kw = this.query.trim()
      if (!kw) {
        prompt.showToast({ message: '请先输入关键词', duration: 1500 })
        return
      }
      this.kbShow = false
      this.state = 'loading'
      this.searched = true
      try {
        const r = await api.searchRepos(kw, 1, 'best match')
        const list = (r && r.items) || []
        this.total = (r && r.total_count) || list.length
        this.items = list.map(mapRepo)
        this.page = 1
        this.hasMore = list.length >= 10
        this.state = this.items.length === 0 ? 'empty' : 'ok'
        this.emptyText = '没有找到相关仓库'
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '搜索失败'
      }
    },
    onListScroll(e) {
      const y = (e && e.scrollY) || 0
      // 触底自动加载（scrollY 估算：单项约 84px）
      if (this.state === 'ok' && this.hasMore && !this.loadingMore) {
        const near = this.items.length * 84 - 340
        if (near > 0 && y >= near) this.loadMore()
      }
    },

    async loadMore() {
      if (!this.searched || !this.hasMore || this.loadingMore || this.state !== 'ok') return
      this.loadingMore = true
      try {
        const next = this.page + 1
        const r = await api.searchRepos(this.query.trim(), next, 'best match')
        const list = (r && r.items) || []
        for (let i = 0; i < list.length; i++) this.items.push(mapRepo(list[i]))
        this.page = next
        this.hasMore = list.length >= 10
      } catch (e) {
        prompt.showToast({ message: '加载失败：' + ((e && e.message) || ''), duration: 1500 })
      }
      this.loadingMore = false
    },
    openRepo(item) {
      if (!item) return
      router.push({ uri: 'pages/repo', params: { full: item.full } })
    },
    doRefresh() {
      if (this.query.trim()) this.doSearch()
    },
    goBack() {
      router.back()
    }
  }
</script>
