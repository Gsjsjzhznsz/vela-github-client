<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <!-- BandQQ compose.ux 同构输入页（v2.16 去 flex 化 + v2.19 键盘 bottom:0 锚定）：
       键盘 hide 恒为 false——本固件 $watch 不触发（BandQQ v2.18.0 注释实证），
       动态 hide 切换永不渲染；独立输入页 + 键盘常驻是 BandQQ 在 RW5 的唯一可靠用法。
       预览区与键盘全部绝对锚定：top-bar 流内固定高，preview-box absolute 铺剩余，
       kb-dock absolute 贴底锚（显式高 264 = KB_H_RECT）。 -->
  <div class="page">
    <div class="top-bar">
      <div class="btn-back-wrap" onclick="goBack"><image class="btn-back" src="/common/icons/back.png" /></div>
      <text class="bar-title">{{title}}</text>
      <text class="done-btn" onclick="confirmDraft">确认</text>
    </div>
    <div class="preview-box">
      <text class="preview-text">{{draft || placeholder}}</text>
      <div class="preview-tools">
        <text class="preview-hint">{{mode === 'token' ? tokHint : '键盘支持拼音/英文 · 点确认返回'}}</text>
        <text class="clear-btn" show="{{draft}}" onclick="clearDraft">清空</text>
      </div>
    </div>
    <div class="kb-dock">
      <input-method hide="{{false}}" maxlength="5" vibratemode="short" screentype="rect" initlang="{{mode === 'token' ? 'en' : 'cn'}}" @complete="onComplete" @delete="onDelete"></input-method>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; position: relative; }
  .top-bar { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .btn-back { width: 44px; height: 44px; }
  .btn-back-wrap { width: 64px; height: 64px; align-items: center; justify-content: center; margin-left: -10px; }
  .bar-title { flex: 1; font-size: 22px; color: #e6edf3; font-weight: bold; margin-left: 7px; lines: 1; text-overflow: ellipsis; }
  .done-btn { width: 96px; height: 48px; text-align: center; line-height: 48px; font-size: 22px; color: #ffffff; background-color: #238636; border-radius: 24px; }
  /* 预览区绝对锚定（top 与 top-bar 等高、底到键盘顶），文字不被键盘遮住 */
  .preview-box { position: absolute; left: 0; top: 72px; bottom: 264px; width: 100%; flex-direction: column; padding: 4px 14px; }
  .preview-text { font-size: 22px; color: #58a6ff; line-height: 31px; text-align: left; word-break: break-all; }
  .preview-tools { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 8px; }
  .preview-hint { font-size: 20px; color: #484f58; text-align: left; flex: 1; }
  .clear-btn { font-size: 21px; color: #f85149; padding: 4px 14px; border: 1px solid #30363d; border-radius: 14px; }
  /* 键盘坞：bottom:0 由引擎按页面可用底解析（避让固件手势保留区），显式高 = 键盘物理高 */
  .kb-dock { position: absolute; left: 0; bottom: 0; width: 100%; height: 264px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/gh' /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
  import { query } from '../../utils/view'

  const MAXLEN = 100
  /* v1.3.0：AI 提问放宽到 400 字（快捷指令/追问需更长输入） */
  const MAXLEN_AI = 400

  export default {
    protected: {
      mode: 'search',     // search | token | user | comment
      title: '输入',
      initial: ''
    },
    private: {
      draft: '',
      placeholder: '在这里输入…',
      tokHint: 'Token 仅存本机 · 输入后点确认'
    },
    onInit(params) {
      try { console.log('[DBG]input onInit raw=' + JSON.stringify(params)) } catch (e) {}
      const p = query(params, this)
      try { console.log('[DBG]input parsed=' + JSON.stringify(p) + ' mode=' + (p.type || 'search')) } catch (e) {}
      this.mode = p.type || 'search'
      this.initial = p.initial || ''
      this.draft = this.initial
      // v1.1.3：预填是否已被用户编辑（token 模式防「预填+重打拼接脏 token」）
      this._dirty = !this.draft
      const conf = {
        search: { title: '搜索仓库', ph: '输入关键词…' },
        token: { title: '输入 Token', ph: '粘贴或键入 ghp_ …' },
        user: { title: '查用户', ph: '输入用户名…' },
        comment: { title: '写评论', ph: '输入评论…' },
        ai: { title: '问 Copilot', ph: '输入问题…' }
      }
      const c = conf[this.mode] || conf.search
      this.title = c.title
      this.placeholder = c.ph
      this.refreshTokHint()
    },
    refreshTokHint() {
      // v1.1.3：实时长度/格式反馈 —— 40 位手工键入无法目视校验，
      // 提前暴露大小写错/漏字，避免白白消耗一次 API 验证
      if (this.mode !== 'token') return
      const t = (this.draft || '').replace(/\s+/g, '')
      if (!t) {
        this.tokHint = 'Token 仅存本机 · 键入后点确认'
        return
      }
      const bad = api.tokenFormatHint(t)
      this.tokHint = t.length + ' 位 · ' + (bad || '格式正确，可点确认')
    },
    onComplete(e) {
      const c = (e && e.detail && e.detail.content) || (e && e.content) || ''
      if (!c) return
      // v1.1.3：token 模式预填未被编辑时，首个键入直接替换（绝不拼接在旧 token 尾部）
      if (this.mode === 'token' && !this._dirty && this.initial && this.draft === this.initial) {
        this.draft = c.slice(0, MAXLEN)
      } else if (this.draft.length < (this.mode === 'ai' ? MAXLEN_AI : MAXLEN)) {
        this.draft = (this.draft + c).slice(0, this.mode === 'ai' ? MAXLEN_AI : MAXLEN)
      }
      this._dirty = true
      this.refreshTokHint()
    },
    onDelete() {
      this.draft = this.draft.slice(0, -1)
      this._dirty = true
      this.refreshTokHint()
    },
    clearDraft() {
      this.draft = ''
      this._dirty = true
      this.refreshTokHint()
    },
    goBack() {
      router.back()
    },
    async confirmDraft() {
      const raw = (this.draft || '').trim()
      if (!raw) {
        prompt.showToast({ message: '还没有输入内容', duration: 1200 })
        return
      }
      const app = this.$app.$def
      if (this.mode === 'token') {
        // v1.1.3 Token 模式重构：
        //  ① 先去空白（令牌不含空格，键盘误触空格/换行不再致命）
        //  ② 格式预检：长度/前缀不对直接提示，不耗 API、不动旧登录
        //  ③ 先验证后落盘：失败时绝不 clearToken（之前会把已存的 GOOD token 清掉，
        //     用户被锁死游客模式无限重输，真机实锴）
        const t = raw.replace(/\s+/g, '')
        const bad = api.tokenFormatHint(t)
        if (bad) {
          prompt.showToast({ message: bad, duration: 2600 })
          return
        }
        prompt.showToast({ message: '正在验证 Token…', duration: 1500 })
        try {
          await api.loadToken(true)
          const user = await api.validateToken(t)
          await api.saveToken(t)
          // v1.1.4：读回验证双通道落盘状态，持久化全败时明确告知用户（
          // 真机 storage 曾静默失败，用户必知会话内有效/重启即丢的区别）
          const pv = await api.verifyPersisted()
          app.inputResult = null
          let msg = '登录成功 · ' + ((user && user.login) || '')
          if (!pv.storage && !pv.file) msg += '（本机持久化失败，仅本次运行有效）'
          else if (!pv.storage || !pv.file) msg += '（' + (pv.storage ? 'file' : 'storage') + '通道兜底）'
          prompt.showToast({ message: msg, duration: 2400 })
          router.back()
        } catch (e) {
          const st = e && e.status !== undefined ? e.status : '?'
          const kept = api.hasToken() ? '（已保留原登录）' : ''
          prompt.showToast({ message: 'Token 验证失败[' + st + ']：' + ((e && e.message) || '') + kept, duration: 2800 })
        }
        return
      }
      // 其余模式：草稿写入应用级共享态，来源页 onShow 消费
      app.inputResult = { type: this.mode, text: raw }
      router.back()
    }
  }
</script>
