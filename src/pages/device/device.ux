        /* pollOnce 内部会自行安排下一轮（或终态返回） */
        _this2._checking = false;
      });
    } catch (e) {
      return Promise.reject(e);
    }
  },
  pollOnce: function () {
    try {
      const _this3 = this;
      if (_this3._destroyed || _this3.state !== 'code') return Promise.resolve();
      if (Date.now() > _this3._deadline) {
        _this3.state = 'error';
        _this3.errMsg = '登录码已过期，请重新开始';
        return Promise.resolve();
      }
      return Promise.resolve(api.deviceFlowPoll(_this3._dc, _this3._interval, _this3.mode)).then(function (r) {
        let _exit = false;
        function _temp2(_result2) {
          if (_exit) return _result2;
          if (r.state === 'slow') {
