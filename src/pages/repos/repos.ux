<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">{{title}}</text>
    </div>

    <div class="pull" style="height: {{pullY}}px">
      <image class="pull-icon" src="/common/icons/refresh.png" />
      <text class="pull-text">{{pullText}}</text>
    </div>

    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll"
          ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
      <div class="li" for="{{it in items}}" tid="id">
        <div class="cell" onclick="openRepo(it)">
          <div class="ava" style="background-color: {{it.avc}}">
            <text class="ava-t">{{it.avn}}</text>
          </div>
          <div class="cell-main">
            <text class="cell-title">{{it.full}}</text>
            <text class="cell-desc" show="{{!!it.desc}}">{{it.desc}}</text>
            <div class="meta">
              <div class="dot" show="{{!!it.lang}}" style="background-color: {{it.langc}}"></div>
              <text class="meta-t" show="{{!!it.lang}}">{{it.lang}}</text>
              <image class="meta-ic" src="/common/icons/star.png" />
              <text class="meta-t">{{it.stars}}</text>
              <image class="meta-ic" src="/common/icons/clock.png" />
              <text class="meta-t">{{it.updated}}</text>
            </div>
          </div>
        </div>
      </div>
      <div class="li" show="{{state === 'ok' && loadingMore}}">
        <text class="foot" onclick="loadMore">加载更多</text>
      </div>
      <div class="li" show="{{state === 'ok' && !hasMore && items.length > 0}}">
        <text class="foot">— 到底了 —</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">{{emptyText}}</text>
      <text class="state-btn" onclick="doRefresh">重新加载</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doRefresh">点此重试</text>
    </div>
  </div>
</template>

<style>
  /* band v2.0 BDS-192：主文本 20/次 16/弱 14，卡 radius 12，页头 56（手环 9/10/11 标准版 192×490 / 212×520） */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 56px; flex-direction: row; align-items: center; padding: 8px 14px 0; } /* v2.0.3 R角：顶垫8+侧垫14，图标字形离开手环屏幕圆角裁切区 */
  .hd-act { width: 30px; height: 30px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 48px; height: 48px; align-items: center; justify-content: center; margin-left: -6px; }
  .hd-title { font-size: 21px; font-weight: bold; color: #e6edf3; margin-left: 6px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .pull { flex-direction: row; align-items: center; justify-content: center; overflow: hidden; }
  .pull-icon { width: 24px; height: 24px; }
  .pull-text { font-size: 17px; color: #8b949e; margin-left: 8px; }
  /* 固件根修保留：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 44px; } /* v2.0.3 R角：尾部缓冲 14→44，末张卡片离开底部圆角+手势区 */
  .li { padding: 4px 10px; flex-direction: column; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 12px; padding: 10px; }
  .ava { width: 36px; height: 36px; border-radius: 18px; justify-content: center; align-items: center; }
  .ava-t { font-size: 20px; color: #ffffff; font-weight: bold; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 8px; }
  .cell-title { font-size: 20px; color: #58a6ff; font-weight: bold; lines: 1; text-overflow: ellipsis; }
  .cell-desc { font-size: 16px; color: #8b949e; margin-top: 3px; lines: 2; text-overflow: ellipsis; }
  .meta { flex-direction: row; align-items: center; margin-top: 7px; }
  .dot { width: 12px; height: 12px; border-radius: 6px; margin-right: 5px; }
  .meta-ic { width: 18px; height: 18px; margin-left: 8px; margin-right: 3px; }
  .meta-t { font-size: 14px; color: #8b949e; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 8px 0; }
  .state { position: absolute; left: 0; top: 56px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 20px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-btn { font-size: 18px; color: #58a6ff; margin-top: 16px; padding: 12px 22px; background-color: #16233a; border-radius: 16px; }
</style>

<script>import router from '@system.router';
import prompt from '@system.prompt';
import api from '../../utils/gh'; /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
import { mapRepo } from '../../utils/view';
import { query } from '../../utils/view';
function _catch(body, recover) {
  try {
    var result = body();
  } catch (e) {
    return recover(e);
  }
  if (result && result.then) {
    return result.then(void 0, recover);
  }
  return result;
}
export default {
  protected: {
    user: ''
  },
  private: {
    title: '我的仓库',
    items: [],
    state: 'loading',
    errMsg: '',
    emptyText: '没有仓库',
    page: 1,
    hasMore: true,
    loadingMore: false,
    refreshing: false,
    scY: 0,
    tY: 0,
    pullY: 0,
    pullText: '下拉刷新'
  },
  onInit: function (params) {
    try {
      let _exit = false;
      const _this = this;
      function _temp2(_result) {
        if (_exit) return _result;
        _this.reload();
      }
      const p = query(params, _this);
      const _temp = function () {
        if (p.user) {
          _this.user = p.user;
          _this.title = _this.user + ' 的仓库';
        } else {
          return Promise.resolve(api.loadToken()).then(function () {
            if (!api.hasToken()) {
              _this.state = 'empty';
              _this.emptyText = '仓库列表需登录：请到首页 → 设置填入 Token';
              _exit = true;
            }
          });
        }
      }();
      return Promise.resolve(_temp && _temp.then ? _temp.then(_temp2) : _temp2(_temp));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  fetchPage: function (page) {
    try {
      const _this2 = this;
      if (_this2.user) return Promise.resolve(api.getUserRepos(_this2.user, page));
      return Promise.resolve(api.getMyRepos(page, 'pushed'));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  reload: function () {
    try {
      const _this3 = this;
      _this3.state = 'loading';
      return Promise.resolve(_catch(function () {
        return Promise.resolve(_this3.fetchPage(1)).then(function (list) {
          if (!Array.isArray(list)) {
            throw {
              message: '仓库列表响应不完整，请重试'
            };
          }
          _this3.items = list.map(mapRepo);
          _this3.page = 1;
          _this3.hasMore = list.length >= api.lastListPerPage();
          _this3.state = _this3.items.length === 0 ? 'empty' : 'ok';
          _this3.emptyText = _this3.user ? '该用户暂无公开仓库' : '还没有仓库';
        });
      }, function (e) {
        _this3.state = 'error';
        _this3.errMsg = e && e.message || '加载失败';
      }));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  loadMore: function () {
    try {
      const _this4 = this;
      function _temp4() {
        _this4.loadingMore = false;
      }
      if (!_this4.hasMore || _this4.loadingMore || _this4.state !== 'ok') return Promise.resolve();
      _this4.loadingMore = true;
      const _temp3 = _catch(function () {
        const next = _this4.page + 1;
        return Promise.resolve(_this4.fetchPage(next)).then(function (list) {
          for (let i = 0; i < list.length; i++) _this4.items.push(mapRepo(list[i]));
          _this4.page = next;
          _this4.hasMore = list.length >= api.lastListPerPage();
        });
      }, function (e) {
        prompt.showToast({
          message: '加载失败：' + (e && e.message || ''),
          duration: 1500
        });
      });
      return Promise.resolve(_temp3 && _temp3.then ? _temp3.then(_temp4) : _temp4(_temp3));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  openRepo(item) {
    if (!item) return;
    this.$app.$def.hook = {
      full: item.full
    };
    router.push({
      uri: 'pages/repo'
    });
  },
  doRefresh() {
    if (this.refreshing) return;
    this.refreshing = true;
    this.pullY = 60;
    this.pullText = '刷新中…';
    this.reload().then(() => {
      this.refreshing = false;
      this.pullY = 0;
    });
  },
  onListScroll(e) {
    this.scY = e && e.scrollY || 0;
    // 触底自动加载（scroll 组件无 scrollbottom，用 scrollY 估算）
    if (this.state === 'ok' && this.hasMore && !this.loadingMore) {
      const near = this.items.length * 92 - 300;
      if (near > 0 && this.scY >= near) this.loadMore();
    }
  },
  onTouchStart(e) {
    if (this.scY <= 0 && !this.refreshing) {
      const t = e && e.touches && e.touches[0];
      this.tY = t && (t.pageY || t.clientY) || 0;
    }
  },
  onTouchMove(e) {
    if (this.refreshing || this.tY <= 0 || this.scY > 0) return;
    const t = e && e.touches && e.touches[0];
    const y = t && (t.pageY || t.clientY) || 0;
    const delta = y - this.tY;
    if (delta > 0) {
      this.pullY = Math.min(112, Math.floor(delta * 0.45));
      this.pullText = this.pullY > 80 ? '松开刷新' : '下拉刷新';
    }
  },
  onTouchEnd() {
    if (this.refreshing) return;
    if (this.pullY > 80) this.doRefresh();else this.pullY = 0;
    this.tY = 0;
  },
  goBack() {
    router.back();
  }
};</script>
