<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">{{full}}</text>
    </div>

    <!-- BandQQ v2.9.6 同构：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
    <scroll class="body" scroll-y="true">
      <div class="wrap">
        <!-- 描述卡 -->
        <div class="card">
          <text class="r-desc" show="{{!!desc}}">{{desc}}</text>
          <div class="meta">
            <div class="dot" show="{{!!lang}}" style="background-color: {{langc}}"></div>
            <text class="meta-t" show="{{!!lang}}">{{lang}}</text>
            <image class="meta-ic" src="/common/icons/star.png" />
            <text class="meta-t">{{stars}}</text>
            <image class="meta-ic" src="/common/icons/fork.png" />
            <text class="meta-t">{{forks}}</text>
            <image class="meta-ic" src="/common/icons/clock.png" />
            <text class="meta-t">{{updated}}</text>
          </div>
          <text class="r-sub">Watch {{watchers}} · Issues {{openIssues}} · {{license}}</text>
        </div>

        <!-- v2.0.2 操作区：手表式 9 宫格 → BandQQ 式竖向列表行（米粒窄屏单列拇指触区） -->
        <div class="menu">
          <div class="mrow" onclick="goReadme">
            <image class="mic" src="/common/icons/book.png" />
            <text class="mlabel">README</text>
            <image class="marrow" src="/common/icons/chevron.png" />
          </div>
          <div class="mrow" onclick="goIssues">
            <image class="mic" src="/common/icons/issue.png" />
            <text class="mlabel">Issues</text>
            <image class="marrow" src="/common/icons/chevron.png" />
          </div>
          <div class="mrow" onclick="goCode">
            <image class="mic" src="/common/icons/code.png" />
            <text class="mlabel">代码</text>
            <image class="marrow" src="/common/icons/chevron.png" />
          </div>
          <div class="mrow" onclick="goReleases">
            <image class="mic" src="/common/icons/book.png" />
            <text class="mlabel">Releases</text>
            <image class="marrow" src="/common/icons/chevron.png" />
          </div>
          <div class="mrow" onclick="goPulls">
            <image class="mic" src="/common/icons/pull.png" />
            <text class="mlabel">Pull Requests</text>
            <image class="marrow" src="/common/icons/chevron.png" />
          </div>
          <div class="mrow" onclick="goActions">
            <image class="mic" src="/common/icons/gear.png" />
            <text class="mlabel">Actions</text>
            <image class="marrow" src="/common/icons/chevron.png" />
          </div>
          <div class="mrow" onclick="goAI">
            <image class="mic" src="/common/icons/ai.png" />
            <text class="mlabel">问 AI</text>
            <image class="marrow" src="/common/icons/chevron.png" />
          </div>
          <div class="mrow" onclick="toggleStar">
            <image class="mic" src="{{starred ? '/common/icons/star-fill.png' : '/common/icons/star.png'}}" />
            <text class="mlabel">{{starred ? '取消 Star' : 'Star'}}</text>
            <image class="marrow" src="{{starred ? '/common/icons/star-fill.png' : '/common/icons/chevron.png'}}" />
          </div>
          <!-- v1.9.0 订阅三态（off→on→ignore，配合通知降噪） -->
          <div class="mrow" onclick="toggleSub">
            <image class="mic" src="/common/icons/bell.png" />
            <text class="mlabel">{{subState === 'on' ? '取消订阅' : (subState === 'ignore' ? '恢复订阅' : '订阅通知')}}</text>
            <image class="marrow" src="/common/icons/chevron.png" />
          </div>
        </div>

        <text class="hint" show="{{starHint}}">Star 需登录 Token</text>
        <text class="hint" show="{{subHint}}">订阅需登录 Token</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="reload">点此重试</text>
    </div>
  </div>
</template>

<style>
  /* band v2.0 BDS-192：designWidth 192（手环 9/10/11 米粒窄屏），主 20/次 16/弱 14；
   * v2.0.2 功能区由手表式宫格改为 BandQQ 式竖向列表行 */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 64px; flex-direction: row; align-items: center; padding: 14px 16px 0; } /* v2.1.2 R角二轮：顶垫14+侧垫16，头部内容整体离开屏幕圆角区 */
  .hd-act { width: 30px; height: 30px;  overflow: hidden;}
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 48px; height: 48px; align-items: center; justify-content: center; margin-left: 2px;  overflow: hidden;}
  .hd-title { font-size: 21px; font-weight: bold; color: #e6edf3; margin-left: 6px; flex: 1; lines: 1; text-overflow: ellipsis; line-height: 28px;}
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .wrap { flex-direction: column; padding: 6px 14px 24px; }
  .card { background-color: #161b22; border-radius: 12px; padding: 10px; flex-direction: column; }
  .r-desc { font-size: 17px; color: #c9d1d9; lines: 3; text-overflow: ellipsis; }
  .meta { flex-direction: row; align-items: center; margin-top: 12px; }
  .dot { width: 12px; height: 12px; border-radius: 6px; margin-right: 5px; }
  .meta-ic { width: 18px; height: 18px; margin-left: 10px; margin-right: 3px; }
  .meta-t { font-size: 14px; color: #8b949e; }
  .r-sub { font-size: 14px; color: #484f58; margin-top: 8px; }
  /* v2.0.2：宫格样式退役，改 BandQQ 式列表行（高 48 满足拇指触区） */
  .menu { flex-direction: column; margin-top: 12px; }
  .mrow { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 10px; padding: 12px 10px; margin-bottom: 5px; }
  .mic { width: 18px; height: 18px; }
  .mlabel { font-size: 18px; color: #e6edf3; margin-left: 9px; flex: 1; lines: 1; text-overflow: ellipsis; line-height: 24px;}
  .marrow { width: 14px; height: 14px; }
  .hint { font-size: 16px; color: #d29922; text-align: center; width: 100%; }
  .state { position: absolute; left: 0; top: 56px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; background-color: #0d1117; }
  .state-t { font-size: 20px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-btn { font-size: 18px; color: #58a6ff; margin-top: 16px; padding: 12px 22px; background-color: #16233a; border-radius: 16px; }
</style>

<script>import router from '@system.router';
import prompt from '@system.prompt';
import api from '../../utils/gh'; /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
import { compact, relTime, langColor } from '../../utils/fmt';
import { query } from '../../utils/view';
function _catch(body, recover) {
  try {
    var result = body();
  } catch (e) {
    return recover(e);
  }
  if (result && result.then) {
    return result.then(void 0, recover);
  }
  return result;
}
export default {
  protected: {
    full: ''
  },
  private: {
    desc: '',
    lang: '',
    langc: '#30363d',
    stars: '0',
    forks: '0',
    watchers: '0',
    openIssues: '0',
    license: '',
    updated: '',
    starred: false,
    starHint: false,
    subState: 'off',
    subHint: false,
    state: 'loading',
    errMsg: ''
  },
  onInit(params) {
    const p = query(params, this);
    if (p.full) this.full = p.full;
  },
  onShow() {
    if (this.full && this.state !== 'ok') this.reload();
  },
  reload: function () {
    try {
      const _this = this;
      _this.state = 'loading';
      return Promise.resolve(_catch(function () {
        return Promise.resolve(api.getRepo(_this.full)).then(function (r) {
          if (!r || typeof r !== 'object') {
            throw {
              message: '仓库响应不完整，请重试'
            };
          }
          _this.desc = r.description || '';
          _this.lang = r.language || '';
          _this.langc = langColor(r.language);
          _this.stars = compact(r.stargazers_count);
          _this.forks = compact(r.forks_count);
          _this.watchers = compact(r.subscribers_count);
          _this.openIssues = compact(r.open_issues_count);
          _this.license = r.license && r.license.spdx_id ? r.license.spdx_id : '无协议';
          _this.updated = '更新于 ' + relTime(r.pushed_at);
          _this.state = 'ok';
          _this.checkStar();
          _this.checkSub();
        });
      }, function (e) {
        _this.state = 'error';
        _this.errMsg = e && e.message || '加载失败';
      }));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  checkStar: function () {
    try {
      const _this2 = this;
      return Promise.resolve(api.loadToken()).then(function () {
        if (!api.hasToken()) return;
        const _temp = _catch(function () {
          return Promise.resolve(api.isStarred(_this2.full)).then(function (_api$isStarred) {
            _this2.starred = _api$isStarred;
          });
        }, function () {});
        if (_temp && _temp.then) return _temp.then(function () {});
      });
    } catch (e) {
      return Promise.reject(e);
    }
  },
  /* ---- v1.9.0：订阅三态（off→on→ignore→off）——在手表上直接关掉噪音仓库通知 ---- */checkSub: function () {
    try {
      const _this3 = this;
      if (!api.hasToken()) return Promise.resolve();
      const _temp2 = _catch(function () {
        return Promise.resolve(api.getRepoSubscription(_this3.full)).then(function (s) {
          _this3.subState = s && s.state || 'off';
        });
      }, function () {});
      return Promise.resolve(_temp2 && _temp2.then ? _temp2.then(function () {}) : void 0);
    } catch (e) {
      return Promise.reject(e);
    }
  },
  toggleSub: function () {
    try {
      const _this4 = this;
      return Promise.resolve(api.loadToken()).then(function () {
        if (!api.hasToken()) {
          _this4.subHint = true;
          prompt.showToast({
            message: '订阅需登录 Token',
            duration: 1500
          });
          return;
        }
        const _temp3 = _catch(function () {
          const order = ['off', 'on', 'ignore'];
          const next = order[(order.indexOf(_this4.subState) + 1) % order.length];
          return Promise.resolve(api.setRepoSubscription(_this4.full, next)).then(function () {
            _this4.subState = next;
            prompt.showToast({
              message: next === 'on' ? '已订阅通知' : next === 'ignore' ? '已忽略此仓库通知' : '已取消订阅',
              duration: 1600
            });
          });
        }, function (e) {
          prompt.showToast({
            message: e && e.message || '操作失败',
            duration: 2000
          });
        });
        if (_temp3 && _temp3.then) return _temp3.then(function () {});
      });
    } catch (e) {
      return Promise.reject(e);
    }
  },
  toggleStar: function () {
    try {
      const _this5 = this;
      return Promise.resolve(api.loadToken()).then(function () {
        if (!api.hasToken()) {
          _this5.starHint = true;
          prompt.showToast({
            message: 'Star 需登录 Token',
            duration: 1500
          });
          return;
        }
        const _temp4 = _catch(function () {
          const target = !_this5.starred;
          return Promise.resolve(api.setStarred(_this5.full, target)).then(function () {
            _this5.starred = target;
            prompt.showToast({
              message: target ? '已 Star ⭐' : '已取消 Star',
              duration: 1500
            });
          });
        }, function (e) {
          prompt.showToast({
            message: e && e.message || '操作失败',
            duration: 2000
          });
        });
        if (_temp4 && _temp4.then) return _temp4.then(function () {});
      });
    } catch (e) {
      return Promise.reject(e);
    }
  },
  goReadme() {
    this.$app.$def.hook = {
      full: this.full
    };
    router.push({
      uri: 'pages/readme'
    });
  },
  goIssues() {
    this.$app.$def.hook = {
      full: this.full
    };
    router.push({
      uri: 'pages/issues'
    });
  },
  /* v1.9.0：PR 列表页 */
  goPulls() {
    this.$app.$def.hook = {
      full: this.full
    };
    router.push({
      uri: 'pages/pulls'
    });
  },
  goCode() {
    this.$app.$def.hook = {
      full: this.full
    };
    router.push({
      uri: 'pages/code'
    });
  },
  goReleases() {
    this.$app.$def.hook = {
      full: this.full
    };
    router.push({
      uri: 'pages/releases'
    });
  },
  goActions() {
    this.$app.$def.hook = {
      full: this.full
    };
    router.push({
      uri: 'pages/actions'
    });
  },
  /* v1.3.0：仓库上下文注入 Copilot 专区（README 摘要由 AI 页发送时补拉） */
  goAI() {
    this.$app.$def.aiCtx = {
      full: this.full,
      path: '',
      text: '当前仓库：' + this.full + (this.desc ? '\n仓库简介：' + this.desc : '')
    };
    router.push({
      uri: 'pages/ai'
    });
  },
  goBack() {
    router.back();
  }
};</script>
