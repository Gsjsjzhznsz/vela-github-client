            };
          }
          _this3._fileName = name || path.split('/').pop();
          _this3.hdTitle = _this3._fileName;
          const lines = text.replace(/\r/g, '').split('\n');
          if (lines.length > MAX_LINES) lines.length = MAX_LINES;
          _this3._allLines = lines;
          // v1.2.4：语法高亮 —— 语言探测 + 跨行块状态一次预计算（弦电子书式
          // 限量渲染：翻页时只对当页 18 行分词，全程毫秒级）
          _this3._lang = detectLang(_this3._fileName);
          _this3._block = _this3._lang === 'plain' ? [] : buildBlockState(lines, _this3._lang);
          _this3._capped = !!r.capped;
          _this3._totalPages = Math.max(1, Math.ceil(lines.length / PAGE_SIZE));
          _this3.mode = 'file';
          _this3.renderFilePage(1);
          _this3.state = 'ok';
          _this3.progressText = '';
        });
      }, function (e) {
        _this3.mode = 'dir';
        _this3.state = 'error';
        _this3.errMsg = e && e.message || '文件加载失败';
        _this3.progressText = '';
      }));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  /* ---- v1.2.2 弦电子书式分页渲染 + v1.2.4 按页语法高亮 ---- */
  renderFilePage(n) {
    const start = (n - 1) * PAGE_SIZE;
    const slice = this._allLines.slice(start, start + PAGE_SIZE);
    const hl = this._lang !== 'plain';
    const out = [];
    for (let i = 0; i < slice.length; i++) {
      const raw = slice[i];
      const s = raw.length > 160 ? raw.slice(0, 160) + '…' : raw;
      if (hl) {
        const bs = this._block[start + i] || {
          inb: false,
          lg: this._lang
        };
        out.push({
          id: 'l' + start + '_' + i,
          kind: 'cline',
          n: start + i + 1,
          toks: tokenizeLine(s, bs.lg, bs.inb)
        });
      } else {
        out.push({
          id: 'l' + start + '_' + i,
          kind: 'line',
          n: start + i + 1,
          s: s
        });
      }
    }
    out.push({
      id: 'pager',
      kind: 'pager',
      info: '第 ' + n + ' / ' + this._totalPages + ' 页',
      canPrev: n > 1,
      canNext: n < this._totalPages
    });
    out.push({
      id: 'fai',
      kind: 'ai',
      text: '问 AI 关于本文件'
    });
    if (this._capped) out.push({
      id: 'cap',
      kind: 'foot',
      text: '— 文件过大，仅显示前 1MB，其余已省略 —'
    });else if (this._allLines.length >= MAX_LINES) out.push({
      id: 'max',
      kind: 'foot',
      text: '（已达 3000 行上限，其余行已省略）'
    });else if (n >= this._totalPages) out.push({
      id: 'end',
      kind: 'foot',
      text: '— 文件结尾 —'
    });
    this.items = out;
    this.curPage = n;
  },
  /* 翻页并复位滚动：交替 1/0 确保绑定值必变（同值不重触发，BandQQ tick 同源问题） */
  pageTurnTo(n) {
    this._scrollTick++;
    this.renderFilePage(n);
    this.scrollTop = this._scrollTick % 2 ? 1 : 0;
  },
  pagePrev() {
    if (this.mode === 'file' && this.curPage > 1) this.pageTurnTo(this.curPage - 1);
  },
  pageNext() {
    if (this.mode === 'file' && this.curPage < this._totalPages) this.pageTurnTo(this.curPage + 1);
  },
  goUp() {
    if (this._segments.length > 0) {
      this._segments.pop();
      if (this._shaStack.length > 0) this._shaStack.pop();
      this.hdTitle = this._segments.length === 0 ? this.full : this._segments[this._segments.length - 1];
      this.loadDir();
    }
  },
  reload() {
    if (this.mode === 'file') {
      this.openFileText(this._filePath, this._fileName, this._wantSize || 0);
    } else {
      this.loadDir();
    }
  },
  goBack() {
    if (this.mode === 'file') {
      this.hdTitle = this._segments.length === 0 ? this.full : this._segments[this._segments.length - 1];
      this.loadDir();
      return;
    }
    if (this._segments.length > 0) {
      this.goUp();
      return;
    }
    router.back();
  },
  onDestroy() {
    this.items = [];
    this._allLines = [];
    this._block = [];
    this._dirEntries = [];
    this._dirCache = {};
  }
};</script>
