    this._dirCache = {}; // v1.3.0：会话目录缓存（返回上级/来回翻秒开，上限 16 层）
    this.hdTitle = this.full;
    this.loadDir();
  },
  currentPath() {
    return this._segments.join('/');
  },
  loadDir: function () {
    try {
      let _exit = false;
      const _this = this;
      _this.mode = 'dir';
      _this.state = 'loading';
