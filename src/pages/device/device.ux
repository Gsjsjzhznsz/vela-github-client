    } catch (e) {
      return Promise.reject(e);
    }
  },
  cancel() {
    this._destroyed = true;
    if (this._timer) {
      clearTimeout(this._timer);
      this._timer = null;
    }
    router.back();
  },
  onDestroy() {
    this._destroyed = true;
    if (this._timer) {
      clearTimeout(this._timer);
      this._timer = null;
    }
  },
  goBack() {
    router.back();
  }
};</script>
