
<template>
  <div class="page">
    <div class="hd">
      <image class="hd-act" src="/common/icons/back.png" onclick="goBack" />
      <text class="hd-title">个人主页</text>
    </div>

    <!-- BandQQ v2.9.6 同构：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
    <scroll class="body" scroll-y="true">
      <div class="wrap">
        <div class="card head-card">
          <div class="ava-big" style="background-color: {{avColor}}">
            <text class="ava-big-t">{{avCh}}</text>
          </div>
          <text class="p-login">{{login}}</text>
          <text class="p-name" show="{{!!name}}">{{name}}</text>
          <text class="p-bio" show="{{!!bio}}">{{bio}}</text>
        </div>

        <div class="stats">
          <div class="stat">
            <text class="stat-n">{{reposN}}</text>
            <text class="stat-l">仓库</text>
          </div>
          <div class="stat">
            <text class="stat-n">{{followers}}</text>
            <text class="stat-l">粉丝</text>
          </div>
          <div class="stat">
            <text class="stat-n">{{following}}</text>
            <text class="stat-l">关注</text>
          </div>
        </div>

        <div class="cell" onclick="goUserRepos">
          <image class="cell-icon" src="/common/icons/repo.png" />
          <text class="cell-label">公开仓库</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <div class="cell" show="{{!isSelf}}" onclick="goInput">
          <image class="cell-icon" src="/common/icons/search.png" />
          <text class="cell-label">游客模式：输入用户名查询</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>
        <div class="cell" show="{{!isSelf}}" onclick="doLogin">
          <image class="cell-icon" src="/common/icons/check.png" />
          <text class="cell-label">去设置登录 Token</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="reload">点此重试</text>
    </div>

  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 44px; height: 44px; }
  .hd-title { font-size: 24px; font-weight: bold; color: #e6edf3; margin-left: 7px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .wrap { flex-direction: column; padding: 5px 12px 50px; }
  .card { background-color: #161b22; border-radius: 12px; padding: 14px; }
  .head-card { align-items: center; }
  .ava-big { width: 67px; height: 67px; border-radius: 34px; justify-content: center; align-items: center; }
  .ava-big-t { font-size: 35px; color: #ffffff; font-weight: bold; }
  .p-login { font-size: 24px; color: #e6edf3; font-weight: bold; margin-top: 7px; }
  .p-name { font-size: 17px; color: #c9d1d9; margin-top: 2px; }
  .p-bio { font-size: 16px; color: #8b949e; margin-top: 5px; text-align: center; lines: 2; text-overflow: ellipsis; }
  .stats { flex-direction: row; margin-top: 12px; }
  .stat { flex: 1; background-color: #161b22; border-radius: 12px; padding: 12px 0; align-items: center; margin-right: 10px; }
  .stat-n { font-size: 24px; color: #e6edf3; font-weight: bold; }
  .stat-l { font-size: 14px; color: #8b949e; margin-top: 2px; }
  .cell { flex-direction: row; align-items: center; background-color: #161b22; border-radius: 12px; padding: 13px 12px; margin-top: 10px; }
  .cell-icon { width: 22px; height: 22px; }
  .cell-label { flex: 1; font-size: 20px; color: #e6edf3; margin-left: 10px; lines: 1; text-overflow: ellipsis; }
  .cell-arrow { width: 17px; height: 17px; }
  .state { position: absolute; left: 0; top: 94px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; background-color: #0d1117; }
  .state-t { font-size: 19px; color: #8b949e; text-align: center; padding: 0 29px; }
  .state-btn { font-size: 17px; color: #58a6ff; margin-top: 12px; }
</style>

<script>
  import router from '@system.router'
  import api from '../../utils/api'
  import { compact, avatar } from '../../utils/fmt'

  export default {
    private: {
      isSelf: false,
      login: '',
      name: '',
      bio: '',
      reposN: '0',
      followers: '0',
      following: '0',
      avCh: 'G',
      avColor: '#21262d',
      state: 'loading',
      query: '',
      errMsg: '',
    },
    async onInit() {
      await api.loadToken()
      if (api.hasToken()) {
        this.loadUser(null)
      } else {
        this.state = 'error'
        this.errMsg = '游客模式：点击下方输入用户名查询，或登录 Token'
      }
    },
    onShow() {
      // 消费独立输入页回传的用户名（BandQQ store 同构）
      const app = this.$app.$def
      const r = app && app.inputResult
      if (r && r.type === 'user' && r.text) {
        app.inputResult = null
        this.query = r.text
        this.loadUser(r.text)
      }
    },
    async loadUser(login) {
      this.state = 'loading'
      try {
        const u = login ? await api.getUser(login) : await api.self()
        this.isSelf = !login
        this.applyUser(u)
        this.state = 'ok'
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '加载失败'
      }
    },
    applyUser(u) {
      this.login = u.login || ''
      this.name = u.name || ''
      this.bio = u.bio || ''
      this.reposN = compact(u.public_repos)
      this.followers = compact(u.followers)
      this.following = compact(u.following)
      const av = avatar(this.login)
      this.avCh = av.ch
      this.avColor = av.color
    },
    reload() {
      if (this.isSelf || (!api.hasToken() && !this.query)) {
        this.loadUser(null)
      } else {
        this.loadUser(this.query || this.login)
      }
    },
    /* 用户名输入：跳 BandQQ compose 同构输入页；onShow 消费回传草稿 */
    goInput() {
      const pre = this.login && !this.isSelf ? this.login : ''
      this.$app.$def.hook = { type: 'user', initial: pre || '' }
      router.push({ uri: 'pages/input' })
    },
    goUserRepos() {
      if (!this.login) return
      this.$app.$def.hook = { user: this.login }
      router.push({ uri: 'pages/repos' })
    },
    doLogin() {
      router.push({ uri: 'pages/settings' })
    },
    goBack() {
      router.back()
    }
  }
</script>
