    this._scrollTick++;
    this.scrollTop = this._scrollTick % 2 ? 1 : 0;
    this.state = 'ok';
  },
  /* v1.3.0：目录分页渲染（弦电子书式限量）——含「返回上级」首项与翻页器 */
  renderDirPage(n) {
    const start = (n - 1) * PAGE_DIR;
    const slice = this._dirEntries.slice(start, start + PAGE_DIR);
    const out = slice.slice();
    out.push({
      id: 'dpager',
      kind: 'pager',
      info: '第 ' + n + ' / ' + this.dirPages + ' 页 · 共 ' + this._dirEntries.length + ' 项',
      canPrev: n > 1,
      canNext: n < this.dirPages
    });
    out.push({
      id: 'dai',
      kind: 'ai',
      text: '问 AI 关于本目录'
    });
    this.items = out;
    this.curPage = n;
  },
  /* v1.3.0：翻页器目录/文件共用，按 mode 分发 */
  pagePrev() {
    if (this.mode === 'file') {
      if (this.curPage > 1) this.pageTurnTo(this.curPage - 1);
      return;
    }
    if (this.mode === 'dir' && this.curPage > 1) this.turnDir(this.curPage - 1);
  },
  pageNext() {
    if (this.mode === 'file') {
      if (this.curPage < this._totalPages) this.pageTurnTo(this.curPage + 1);
      return;
    }
    if (this.mode === 'dir' && this.curPage < this.dirPages) this.turnDir(this.curPage + 1);
  },
  turnDir(n) {
    this._scrollTick++;
    this.renderDirPage(n);
    this.scrollTop = this._scrollTick % 2 ? 1 : 0;
  },
  /* v1.3.0：问 AI——把当前文件片段/目录清单注入 Copilot 专区上下文 */
  askAI() {
    const app = this.$app.$def;
    let ctx = '';
    if (this.mode === 'file' && this._allLines.length) {
      ctx = '文件 ' + this._filePath + ' 内容片段：\n' + this._allLines.slice(0, 120).join('\n').slice(0, 3800);
    } else if (this._dirEntries.length) {
      const names = [];
      for (let i = 0; i < this._dirEntries.length && i < 60; i++) {
        const e = this._dirEntries[i];
        if (e.kind === 'entry') names.push((e.isDir ? '[目录] ' : '[文件] ') + e.name);
      }
      ctx = (this.currentPath() || '仓库根目录') + ' 目录清单：\n' + names.join('\n');
    }
