          _this._interval = r.interval;
          _this._deadline = Date.now() + r.expiresIn * 1000;
          _this._netFails = 0;
          _this.userCode = r.userCode;
          _this.verifyUri = String(r.verifyUri || 'https://github.com/login/device').replace(/^https?:\/\//, '');
          _this.statusText = '等待授权 · 有效期 ' + Math.floor(r.expiresIn / 60) + ' 分钟';
          _this.state = 'code';
          _this.schedule();
        });
      }, function (e) {
        if (_this._destroyed) return;
        _this.state = 'error';
        _this.errMsg = e && e.message || '发起登录失败';
      }));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  schedule() {
    if (this._destroyed || this._timer) return;
    const iv = Math.max(3, this._interval) * 1000;
    this._timer = setTimeout(() => {
      this._timer = null;
      this.pollOnce();
    }, iv);
  },
  /** v1.2.1：手动刷新——不等轮询计时器，立即检查一次授权结果 */manualCheck: function () {
    try {
      const _this2 = this;
      if (_this2._destroyed || _this2.state !== 'code' || _this2._checking) return Promise.resolve();
      _this2._checking = true;
