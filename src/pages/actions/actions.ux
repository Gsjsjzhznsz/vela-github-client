<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">CI 历史</text>
      <text class="hd-sub">{{hdRepo}} · 共 {{total}}</text>
    </div>

    <!-- RW5 固件根修（BandQQ v2.9.6 同构）：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll">
        <div class="li" for="{{it in commits}}" tid="oid">
          <div class="cell" onclick="toggleExpand(it)">
            <div class="dot {{it.cls}}"></div>
            <div class="cell-main">
              <text class="cell-title">{{it.headline}}</text>
              <text class="cell-sub">{{it.oidShort}} · {{it.stateTxt}}{{it.date ? ' · ' + it.date : ''}}</text>
            </div>
            <image class="cell-arrow {{it.expanded ? 'arr-up' : ''}}" src="/common/icons/chevron.png" />
          </div>
          <!-- 内联展开 checkRuns（数据已在条目内，零二次请求） -->
          <div class="chk" show="{{it.expanded}}">
            <div class="chk-row" for="{{ck in it.checks}}" tid="ck.name">
              <text class="chk-name">{{ck.name}}</text>
              <text class="chk-state {{ck.cls}}">{{ck.txt}}</text>
            </div>
            <text class="chk-empty" show="{{it.checks.length === 0}}">无检查项</text>
          </div>
        </div>
        <text class="foot" show="{{state === 'ok' && hasNext}}" onclick="loadMore">加载更多</text>
        <text class="foot" show="{{state === 'ok' && !hasNext && commits.length > 0}}">— 到底了 —</text>
        <div class="pad-end"></div>
      </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">还没有任何提交</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" show="{{needAuth}}" onclick="goSettings">去登录</text>
      <text class="state-btn" onclick="reload">点此重试</text>
    </div>
  </div>
</template>

<style>
  /* band v2.0 BDS-192：主文本 20/次 16，卡 radius 12，页头 56（手环 9/10/11 标准版 192×490 / 212×520） */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 56px; flex-direction: row; align-items: center; padding: 8px 14px 0; } /* v2.0.3 R角：顶垫8+侧垫14，图标字形离开手环屏幕圆角裁切区 */
  .hd-act { width: 30px; height: 30px;  overflow: hidden;}
  .hd-act-wrap { width: 48px; height: 48px; align-items: center; justify-content: center; margin-left: -6px;  overflow: hidden;}
  .hd-title { font-size: 21px; font-weight: bold; color: #e6edf3; margin-left: 6px; lines: 1; text-overflow: ellipsis; line-height: 28px;}
  .hd-sub { font-size: 14px; color: #484f58; flex: 1; margin-left: 8px; lines: 1; text-overflow: ellipsis; line-height: 18px;}
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 44px; } /* v2.0.3 R角：尾部缓冲 14→44，末张卡片离开底部圆角+手势区 */
  .li { padding: 4px 10px; flex-direction: column; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 12px; padding: 10px; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 8px; }
  .cell-title { font-size: 17px; color: #e6edf3; lines: 2; text-overflow: ellipsis; }
  .cell-sub { font-size: 14px; color: #8b949e; margin-top: 3px; lines: 1; text-overflow: ellipsis; line-height: 22px;}
  .cell-arrow { width: 20px; height: 20px; }
  .arr-up { transform: rotate(180deg); }
  .dot { width: 18px; height: 18px; border-radius: 9px; }
  .dot-ok { background-color: #3fb950; }
  .dot-fail { background-color: #f85149; }
  .dot-run { background-color: #d29922; }
  .dot-idle { background-color: #484f58; }
  .chk { flex-direction: column; background-color: #0d1117; border-radius: 12px; margin: 5px 14px 5px 44px; padding: 3px 12px; }
  .chk-row { flex-direction: row; align-items: center; justify-content: space-between; padding: 7px 0; }
  .chk-name { font-size: 14px; color: #c9d1d9; flex: 1; lines: 1; text-overflow: ellipsis; line-height: 22px;}
  .chk-state { font-size: 16px; margin-left: 9px; }
  .st-ok { color: #3fb950; }
  .st-fail { color: #f85149; }
  .st-run { color: #d29922; }
  .st-idle { color: #484f58; }
  .chk-empty { font-size: 16px; color: #484f58; padding: 6px 0; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 8px 0; }
  .state { position: absolute; left: 0; top: 56px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 20px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-btn { font-size: 18px; color: #58a6ff; margin-top: 16px; padding: 12px 22px; background-color: #16233a; border-radius: 16px; }
</style>

<script>import router from '@system.router';
import prompt from '@system.prompt';
import api from '../../utils/gh'; /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
import { relTime } from '../../utils/fmt';
import { query } from '../../utils/view';

/* v1.2.3 新功能：CI 历史（commit × checkRuns）。
 * CI 通知聚合卡（通知中心）/ 仓库页 Actions 入口的落点——「看看哪次构建挂了」。
 * 数据：GraphQL Commit.history + statusCheckRollup 瘦字段（每条 ~370B，10 条
 * ~3KB 一页安全到达）。REST /actions/runs 单条 ~17.7KB 恒超蓝牙截断阈值，
 * 无回退通道——游客给「需登录」提示。点击条目内联展开 checkRuns（零二次请求）。 */

function _catch(body, recover) {
  try {
    var result = body();
  } catch (e) {
    return recover(e);
  }
  if (result && result.then) {
    return result.then(void 0, recover);
  }
  return result;
}
function rollCls(state) {
  if (state === 'success') return 'dot-ok';
  if (state === 'failure' || state === 'error') return 'dot-fail';
  if (state === 'pending') return 'dot-run';
  return 'dot-idle';
}
function rollTxt(state) {
  if (state === 'success') return '通过';
  if (state === 'failure') return '失败';
  if (state === 'error') return '错误';
  if (state === 'pending') return '进行中';
  if (state === 'expected') return '等待中';
  return state || '无状态';
}
function mapCommit(c) {
  const st = c.state || '';
  const checks = (c.checks || []).map(function (ck) {
    const t = ck.concl || '';
    return {
      name: ck.name || 'check',
      txt: t === 'success' ? '通过' : t === 'failure' ? '失败' : t === 'error' ? '错误' : t === 'in_progress' || t === 'queued' ? '进行中' : t || '未知',
      cls: t === 'success' ? 'st-ok' : t === 'failure' || t === 'error' ? 'st-fail' : t === 'in_progress' || t === 'queued' || t === 'pending' ? 'st-run' : 'st-idle'
    };
  });
  return {
    oid: c.oid,
    oidShort: (c.oid || '').slice(0, 7),
    headline: c.headline || '(无提交信息)',
    state: st,
    stateTxt: rollTxt(st),
    date: relTime(c.date),
    cls: rollCls(st),
    checks: checks,
    expanded: false
  };
}
export default {
  protected: {
    full: ''
  },
  private: {
    hdRepo: '',
    commits: [],
    page: 1,
    hasNext: false,
    total: 0,
    state: 'loading',
    errMsg: '',
    needAuth: false,
    loadingMore: false,
    scY: 0
  },
  onInit(params) {
    const p = query(params, this);
    if (p.full) this.full = p.full;
    this.hdRepo = this.full;
    this.loadCommits();
  },
  loadCommits: function () {
    try {
      const _this = this;
      _this.state = 'loading';
      _this.needAuth = false;
      const _temp = _catch(function () {
        return Promise.resolve(api.getCommitChecks(_this.full, '', 1)).then(function (r) {
          _this.commits = (r.commits || []).map(mapCommit);
          _this.total = r.total || _this.commits.length;
          _this.hasNext = !!r.hasNext;
          _this.page = 1;
          _this.state = _this.commits.length === 0 ? 'empty' : 'ok';
        });
      }, function (e) {
        _this.state = 'error';
        _this.needAuth = !!(e && e.needAuth);
        _this.errMsg = e && e.message || '加载失败';
      });
      return Promise.resolve(_temp && _temp.then ? _temp.then(function () {}) : void 0);
    } catch (e) {
      return Promise.reject(e);
    }
  },
  loadMore: function () {
    try {
      const _this2 = this;
      function _temp3() {
        _this2.loadingMore = false;
      }
      if (!_this2.hasNext || _this2.loadingMore || _this2.state !== 'ok') return Promise.resolve();
      _this2.loadingMore = true;
      const _temp2 = _catch(function () {
        const next = _this2.page + 1;
        return Promise.resolve(api.getCommitChecks(_this2.full, '', next)).then(function (r) {
          const mapped = (r.commits || []).map(mapCommit);
          for (let i = 0; i < mapped.length; i++) _this2.commits.push(mapped[i]);
          _this2.page = next;
          _this2.hasNext = !!r.hasNext;
        });
      }, function (e) {
        prompt.showToast({
          message: '加载失败：' + (e && e.message || ''),
          duration: 1500
        });
      });
      return Promise.resolve(_temp2 && _temp2.then ? _temp2.then(_temp3) : _temp3(_temp2));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  toggleExpand(item) {
    if (!item) return;
    /* 固件 show 绑定刷新：整组重建引用确保视图更新（BandQQ tick 同源经验） */
    const idx = this.commits.indexOf(item);
    if (idx < 0) return;
    this.commits.splice(idx, 1, Object.assign({}, item, {
      expanded: !item.expanded
    }));
  },
  onListScroll(e) {
    this.scY = e && e.scrollY || 0;
    if (this.state === 'ok' && this.hasNext && !this.loadingMore) {
      const near = this.commits.length * 78 - 300;
      if (near > 0 && this.scY >= near) this.loadMore();
    }
  },
  reload() {
    this.loadCommits();
  },
  goSettings() {
    router.push({
      uri: 'pages/settings'
    });
  },
  goBack() {
    router.back();
  }
};</script>
