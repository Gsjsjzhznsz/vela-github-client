<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <div class="hd">
      <image class="hd-act" src="/common/icons/back.png" onclick="goBack" />
      <div class="hd-main">
        <text class="hd-title">{{full}} #{{n}}</text>
        <text class="hd-sub">{{commentN}} 条评论</text>
      </div>
      <image class="hd-act" src="/common/icons/refresh.png" onclick="reload" />
    </div>

    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll">
      <!-- 标题头 -->
      <div class="li">
        <div class="head-card">
          <div class="badge {{open ? 'b-open' : 'b-closed'}}">
            <text class="badge-t">{{isPR ? (open ? 'PR · 开放' : 'PR · 已合并/关闭') : (open ? 'Issue · 开放' : 'Issue · 已关闭')}}</text>
          </div>
          <text class="h-title">{{title}}</text>
          <text class="h-meta">{{author}} · 创建于 {{created}}</text>
          <text class="lb" if="{{labelsText}}" style="color: {{labelColor}}">{{labelsText}}</text>
        </div>
      </div>

      <!-- 正文块 -->
      <div class="li" for="{{it in bodyBlocks}}" tid="id">
        <text class="bh" if="{{it.t === 'h'}}">{{it.s}}</text>
        <text class="bp" elif="{{it.t === 'p'}}">{{it.s}}</text>
        <text class="bc" elif="{{it.t === 'c'}}">{{it.s}}</text>
        <text class="bq" elif="{{it.t === 'q'}}">{{it.s}}</text>
        <text class="bl" elif="{{it.t === 'l'}}">{{it.s}}</text>
        <div class="br" elif="{{it.t === 'r'}}"></div>
        <text class="bp" else>{{it.s}}</text>
      </div>

      <!-- 评论分隔 -->
      <div class="li">
        <text class="sepa-t">—— 评论 ——</text>
      </div>

      <!-- 写评论入口 -->
      <div class="li">
        <div class="cmt-card" onclick="openComposer">
          <text class="compose-label">写评论{{sending ? ' · 发送中…' : ''}}</text>
          <text class="compose-hint">{{canCmt ? '点击用拼音键盘发表评论' : '需登录 Token 后使用'}}</text>
        </div>
      </div>

      <!-- 评论项 -->
      <div class="li" for="{{it in comments}}" tid="id">
        <div class="cmt-card">
          <div class="cmt-hd">
            <div class="ava" style="background-color: {{it.avc}}">
              <text class="ava-t">{{it.avn}}</text>
            </div>
            <text class="cmt-author">{{it.author}}</text>
            <text class="cmt-time">{{it.time}}</text>
          </div>
          <text class="cmt-body" if="{{it.text}}">{{it.text}}</text>
          <text class="cmt-empty" if="{{!it.text}}">（无正文）</text>
        </div>
      </div>

      <div class="li" if="{{loadingComments}}">
        <text class="foot">加载评论中…</text>
      </div>
      <div class="li" show="{{state === 'ok' && !hasMoreComments && comments.length > 0}}">
        <text class="foot">— 到底了 —</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="reload">点此重试</text>
    </div>

    <!-- Vela_input_method 组件键盘（T9 拼音，写中文评论） -->
    <input-method hide="{{!kbShow}}" screentype="rect" keyboardtype="T9" maxlength="5" vibratemode="short" @complete="onKbChar" @delete="onKbDel"></input-method>

    <!-- 键盘操作条：草稿预览 + 发送 + 收起 -->
    <div class="kb-bar" show="{{kbShow}}">
      <text class="kb-bar-t">{{cmtDraft ? cmtTail : '输入评论…'}}</text>
      <text class="kb-bar-ok" onclick="sendComment">发送</text>
      <text class="kb-bar-x" onclick="hideKb">收起</text>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 40px; flex-direction: row; align-items: center; padding: 0 10px; }
  .hd-act { width: 20px; height: 20px; }
  .hd-main { flex: 1; flex-direction: column; margin-left: 6px; }
  .hd-title { font-size: 14px; font-weight: bold; color: #e6edf3; lines: 1; text-overflow: ellipsis; }
  .hd-sub { font-size: 9px; color: #484f58; margin-top: 1px; }
  /* RW5 固件根修：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 14px; }
  .li { padding: 3px 10px; }
  .head-card { background-color: #161b22; border-radius: 10px; padding: 10px; width: 100%; flex-direction: column; }
  .badge { align-self: flex-start; border-radius: 10px; padding: 2px 8px; }
  .b-open { background-color: #238636; }
  .b-closed { background-color: #8957e5; }
  .badge-t { font-size: 10px; color: #ffffff; }
  .h-title { font-size: 15px; color: #e6edf3; font-weight: bold; margin-top: 6px; lines: 3; text-overflow: ellipsis; }
  .h-meta { font-size: 10px; color: #8b949e; margin-top: 4px; }
  .labels { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
  .lb { font-size: 9px; margin-right: 6px; border: 1px solid #30363d; border-radius: 8px; padding: 1px 6px; }
  .bh { font-size: 14px; color: #58a6ff; font-weight: bold; margin-top: 4px; }
  .bp { font-size: 13px; color: #e6edf3; line-height: 19px; }
  .bc { font-size: 11px; color: #a5d6ff; background-color: #161b22; border-left: 2px solid #30363d; padding: 5px 8px; margin: 2px 0; }
  .bq { font-size: 12px; color: #8b949e; border-left: 2px solid #30363d; padding-left: 8px; }
  .bl { font-size: 13px; color: #e6edf3; line-height: 19px; }
  .br { height: 1px; background-color: #30363d; width: 100%; margin: 4px 0; }
  .sepa-t { font-size: 10px; color: #484f58; text-align: center; width: 100%; padding: 6px 0; }
  .cmt-card { background-color: #161b22; border-radius: 10px; padding: 9px 10px; width: 100%; flex-direction: column; }
  .cmt-hd { flex-direction: row; align-items: center; }
  .ava { width: 20px; height: 20px; border-radius: 10px; justify-content: center; align-items: center; }
  .ava-t { font-size: 10px; color: #ffffff; font-weight: bold; }
  .cmt-author { font-size: 12px; color: #58a6ff; margin-left: 6px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .cmt-time { font-size: 9px; color: #484f58; }
  .cmt-body { font-size: 12px; color: #c9d1d9; line-height: 18px; margin-top: 6px; }
  .cmt-empty { font-size: 11px; color: #484f58; margin-top: 4px; }
  .foot { font-size: 10px; color: #484f58; text-align: center; width: 100%; padding: 6px 0; }
  .state { position: absolute; left: 0; top: 40px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 13px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-btn { font-size: 12px; color: #58a6ff; margin-top: 10px; }
  .compose-label { font-size: 13px; color: #58a6ff; font-weight: bold; }
  .compose-hint { font-size: 10px; color: #484f58; margin-top: 3px; }
  .kb-bar { position: absolute; left: 0; top: 0; width: 100%; height: 30px; background-color: #161b22; border-bottom: 1px solid #30363d; flex-direction: row; align-items: center; padding: 0 8px; }
  .kb-bar-t { font-size: 12px; color: #e6edf3; flex: 1; lines: 1; text-overflow: ellipsis; }
  .kb-bar-ok { font-size: 12px; color: #ffffff; background-color: #238636; border-radius: 12px; padding: 4px 10px; margin-left: 6px; }
  .kb-bar-x { font-size: 12px; color: #8b949e; margin-left: 8px; }
</style>

<script>
  import router from '@system.router'
  import api from '../../utils/api'
  import { mdToBlocks } from '../../utils/md'
  import { relTime, truncate, avatar } from '../../utils/fmt'
  import { mapIssue } from '../../utils/view'
  import { navParams } from '../../utils/nav'

  export default {
    protected: {
      full: '',
      n: ''
    },
    private: {
      title: '',
      open: true,
      isPR: false,
      author: '',
      created: '',
      labelsText: '',
      labelColor: '#8b949e',
      commentN: 0,
      bodyBlocks: [],
      comments: [],
      state: 'loading',
      errMsg: '',
      loadingComments: false,
      hasMoreComments: false,
      kbShow: false,
      cmtDraft: '',
      cmtTail: '',
      sending: false,
      canCmt: false
    },
    onInit(params) {
      const p = navParams(params, ['full', 'n'])
      if (p.full) this.full = p.full
      if (p.n) this.n = p.n
    },
    onShow() {
      this.canCmt = api.hasToken()
      if (this.full && this.n && this.state !== 'ok') this.reload()
    },
    async reload() {
      this.state = 'loading'
      try {
        const iss = await api.getIssue(this.full, this.n)
        if (!iss || typeof iss !== 'object') {
          throw { message: 'Issue 响应不完整，请重试' }
        }
        const m = mapIssue(iss)
        this.title = m.title
        this.open = m.open
        this.isPR = !!iss.pull_request
        this.author = m.author
        this.created = m.time
        this.labelsText = (iss.labels || []).map((l) => l.name).join(' · ')
        this.labelColor = iss.labels && iss.labels[0] && iss.labels[0].color ? '#' + iss.labels[0].color : '#8b949e'
        this.commentN = iss.comments || 0
        this.canCmt = api.hasToken()
        const body = mdToBlocks(iss.body || '')
        const blocks = []
        for (let i = 0; i < body.length && i < 80; i++) {
          blocks.push({ id: 'b' + i, t: body[i].t, s: body[i].s })
        }
        this.bodyBlocks = blocks
        this._cmtsUrl = iss.comments_url || ''
        this.comments = []
        this._cPage = 0
        this.hasMoreComments = this.commentN > 0
        this.state = 'ok'
        this.loadMoreComments()
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '加载失败'
      }
    },
    onListScroll(e) {
      const y = (e && e.scrollY) || 0
      this._sy = y
      if (this.state === 'ok' && this.hasMoreComments && !this.loadingComments) {
        const near = (this.bodyBlocks.length * 40 + this.comments.length * 90) - 340
        if (near > 0 && y >= near) this.loadMoreComments()
      }
    },

    async loadMoreComments() {
      if (this.state !== 'ok' || this.loadingComments || !this.hasMoreComments) return
      this.loadingComments = true
      try {
        const next = this._cPage + 1
        const list = await api.getComments(this._cmtsUrl, next)
        for (let i = 0; i < list.length; i++) {
          const c = list[i]
          const av = avatar(c.user ? c.user.login : '?')
          this.comments.push({
            id: String(c.id),
            author: c.user ? c.user.login : '未知',
            time: relTime(c.created_at),
            text: truncate((c.body || '').replace(/\r/g, ''), 500),
            avn: av.ch,
            avc: av.color
          })
        }
        this._cPage = next
        this.hasMoreComments = list.length >= 10
      } catch (e) {
        // 评论加载失败不打断页面
      }
      this.loadingComments = false
    },
    onDestroy() {
      this.bodyBlocks = []
      this.comments = []
    },
    /* ---- 评论发表（T9 拼音键盘） ---- */
    openComposer() {
      if (!api.hasToken()) {
        prompt.showToast({ message: '发表评论需登录 Token（设置页）', duration: 2000 })
        return
      }
      this.kbShow = true
    },
    hideKb() {
      this.kbShow = false
    },
    onKbChar(e) {
      const c = (e && e.detail && e.detail.content) || ''
      if (c && this.cmtDraft.length < 500) {
        this.cmtDraft = (this.cmtDraft + c).slice(0, 500)
        this.syncTail()
      }
    },
    onKbDel() {
      this.cmtDraft = this.cmtDraft.slice(0, -1)
      this.syncTail()
    },
    syncTail() {
      const d = this.cmtDraft
      this.cmtTail = d.length > 20 ? '…' + d.slice(-19) : d
    },
    async sendComment() {
      const body = this.cmtDraft.trim()
      if (!body) {
        prompt.showToast({ message: '评论内容不能为空', duration: 1500 })
        return
      }
      if (!this._cmtsUrl || this.sending) return
      this.sending = true
      try {
        const c = await api.addComment(this._cmtsUrl, body)
        const av = avatar(c.user ? c.user.login : '?')
        this.comments.push({
          id: String(c.id),
          author: c.user ? c.user.login : '我',
          time: '刚刚',
          text: truncate((c.body || '').replace(/\r/g, ''), 500),
          avn: av.ch,
          avc: av.color
        })
        this.commentN += 1
        this.cmtDraft = ''
        this.cmtTail = ''
        this.kbShow = false
        prompt.showToast({ message: '评论已发表', duration: 1500 })
      } catch (e) {
        prompt.showToast({ message: '发表失败：' + ((e && e.message) || ''), duration: 2000 })
      }
      this.sending = false
    },
    goBack() {
      router.back()
    }
  }
</script>
