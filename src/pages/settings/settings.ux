<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">设置</text>
    </div>

    <!-- BandQQ v2.9.6 同构：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
    <scroll class="body" scroll-y="true">
      <div class="wrap">
        <!-- 账户状态 -->
        <div class="card" onclick="refreshAccount">
          <div class="card-col">
            <text class="c-title">GitHub 账户</text>
          <text class="c-row">{{hasTk ? '已登录 · ' + tokenMask : '游客模式（公开数据，限流 60 次/小时）'}}</text>
          <text class="c-row2">API 余量 {{rateText}}</text>
          <text class="c-row2" show="{{hasTk && diagText}}">持久化诊断：{{diagText}}</text>
          <text class="c-act">点此刷新登录状态与 API 余量</text>
          </div>
        </div>

        <!-- Token 操作 -->
        <!-- v1.2.0：免打字登录（Device Flow），置顶推荐 -->
        <div class="cell" onclick="startDevice">
          <image class="cell-icon" src="/common/icons/check.png" />
          <text class="cell-label hl">免打字登录（推荐）</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <div class="cell" onclick="startInput">
          <image class="cell-icon" src="/common/icons/gear.png" />
          <text class="cell-label">手动输入 Token</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <!-- v1.1.3：一键重验已存 Token（无需重打 40 位） -->
        <div class="cell" show="{{hasTk}}" onclick="revalidate">
          <image class="cell-icon" src="/common/icons/refresh.png" />
          <text class="cell-label">重新验证当前 Token</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <div class="cell" show="{{hasTk}}" onclick="logout">
          <image class="cell-icon" src="/common/icons/back.png" />
          <text class="cell-label warn">退出登录（清除本机 Token）</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <!-- 说明 -->
        <div class="card">
          <div class="card-col">
            <text class="c-title">如何登录？</text>
          <text class="c-body">推荐：点「免打字登录」，手表显示 8 位码</text>
          <text class="c-body">手机/电脑浏览器打开 github.com/login/device</text>
          <text class="c-body">输入该码并授权，Token 自动保存到手表</text>
          <text class="c-body warn">Token 仅保存在手表本地存储，不会上传到任何服务器</text>
          </div>
        </div>

        <div class="card">
          <text class="c-title">关于</text>
          <text class="c-body">GitHub for Vela v1.2.1</text>
          <text class="c-body">运行于 Xiaomi Vela OS（NuttX），适配 Redmi Watch 5（432×514）方屏，兼容圆屏</text>
          <text class="c-body">网络：经小米运动健康蓝牙代理或 eSIM 独立联网，直连 api.github.com</text>
          <text class="c-body">开源协议：AGPL-3.0 · 参考 BandQQ 键盘组件架构</text>
          </div>
        </div>
      </div>
    </scroll>
    </div>

  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 44px; height: 44px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 64px; height: 64px; align-items: center; justify-content: center; margin-left: -10px; }
  .hd-title { font-size: 24px; font-weight: bold; color: #e6edf3; margin-left: 7px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .wrap { flex-direction: column; padding: 5px 12px 50px; }
  .card { background-color: #161b22; border-radius: 12px; padding: 12px; margin-bottom: 10px; flex-direction: column; }
  .c-title { font-size: 19px; color: #e6edf3; font-weight: bold; margin-bottom: 5px; }
  .c-row { font-size: 16px; color: #c9d1d9; }
  .c-row2 { font-size: 14px; color: #3fb950; margin-top: 4px; }
  .c-body { font-size: 14px; color: #8b949e; line-height: 18px; margin-top: 2px; }
  .warn { color: #d29922; }
  .c-act { font-size: 14px; color: #58a6ff; margin-top: 8px; }
  .cell { flex-direction: row; align-items: center; background-color: #161b22; border-radius: 12px; padding: 13px 12px; margin-bottom: 10px; }
  .cell-icon { width: 22px; height: 22px; }
  .cell-label { flex: 1; font-size: 20px; color: #e6edf3; margin-left: 10px; lines: 1; text-overflow: ellipsis; }
  .cell-arrow { width: 17px; height: 17px; }
  .hl { color: #3fb950; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/api'
  import { maskToken } from '../../utils/fmt'

  export default {
    private: {
      hasTk: false,
      tokenMask: '',
      rateText: '…',
      diagText: ''
    },
    onInit() {
    },
    async onShow() {
      // force 重读存储：登录/登出发生在 input 页的独立 JS context，
      // 本页缓存的 loadToken promise 不会自动失效（游客模式假象根因）
      await api.loadToken(true)
      this.hasTk = api.hasToken()
      this.tokenMask = this.hasTk ? maskToken(api.currentToken()) : ''
      this.refreshDiag()
      this.refreshRate()
    },
    refreshDiag() {
      if (!this.hasTk) {
        this.diagText = ''
        return
      }
      const d = api.storageDiag()
      // 用「有/无」而非 √/×（× 字符未经固件字库验证，√ 已实证可用）
      const ch = (n, v) => n + (v > 0 ? ' 有' + v + '位' : ' 无')
      let s = ch('storage', d.storage) + ' · ' + ch('file', d.file)
      if (d.write) s += ' · 写入:' + d.write
      else if (d.src) s += ' · 读取自:' + d.src
      this.diagText = s
    },
    async refreshRate() {
      try {
        const r = await api.getRateLimit()
        const core = r && r.resources && r.resources.core
        if (core) this.rateText = core.remaining + '/' + core.limit
      } catch (e) {
        this.rateText = '未知'
      }
    },
    /** v1.2.1：账户卡手动刷新——重读 token + 重验 + 刷新余量 */
    async refreshAccount() {
      await api.loadToken(true)
      this.hasTk = api.hasToken()
      this.tokenMask = this.hasTk ? maskToken(api.currentToken()) : ''
      this.refreshDiag()
      await this.refreshRate()
      prompt.showToast({ message: this.hasTk ? '已刷新 · 已登录' : '已刷新 · 游客模式', duration: 1200 })
    },
    /* ---- v1.2.0：免打字登录（Device Flow） ---- */
    startDevice() {
      this.$app.$def.hook = {}
      router.push({ uri: 'pages/device' })
    },
    /* ---- Token 输入：跳 BandQQ compose 同构输入页（键盘常驻） ---- */
    startInput() {
      // 预填已存 Token：重进时无需重新逐字键入 40 位（input 页首个键入会整体替换，不会拼接）
      this.$app.$def.hook = { type: 'token', initial: api.currentToken() || '' }
      router.push({ uri: 'pages/input' })
    },
    /* v1.1.3：一键重验已存 Token —— 二次输入手误 401 的根治路径：根本不用再输入 */
    async revalidate() {
      await api.loadToken(true)
      const t = api.currentToken()
      if (!t) {
        this.hasTk = false
        return
      }
      prompt.showToast({ message: '正在验证已存 Token…', duration: 1500 })
      try {
        const user = await api.validateToken(t)
        this.hasTk = true
        this.tokenMask = maskToken(t)
        prompt.showToast({ message: 'Token 有效 · ' + ((user && user.login) || ''), duration: 1800 })
      } catch (e) {
        const st = e && e.status !== undefined ? e.status : '?'
        prompt.showToast({ message: '验证失败[' + st + ']：' + ((e && e.message) || '，可退出登录后重输'), duration: 2800 })
      }
      this.refreshRate()
    },
    async logout() {
      await api.clearToken()
      this.hasTk = false
      this.tokenMask = ''
      prompt.showToast({ message: '已退出登录', duration: 1500 })
    },
    goBack() {
      router.back()
    }
  }
</script>
