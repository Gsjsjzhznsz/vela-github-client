<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <div class="hd-main">
        <text class="hd-title">{{hdTitle}}</text>
        <text class="hd-sub" show="{{mode === 'dir' && pathText}}">{{pathText}}</text>
      </div>
    </div>

    <div class="body-wrap">
      <scroll class="body" scroll-y="true" scroll-top="{{scrollTop}}">
      <!-- 固件 elif 不可靠：分支全部 show 预渲染（BandQQ v2.9.6 同款安全形态） -->
      <div class="{{it.kind === 'line' ? 'li-code' : (it.kind === 'cline' ? 'li-code' : 'li')}}" for="{{it in items}}" tid="id">
        <div class="cell" show="{{it.kind === 'up'}}" onclick="goUp">
          <image class="cell-icon" src="/common/icons/back.png" />
          <text class="cell-name muted">返回上级</text>
        </div>
        <div class="cell" show="{{it.kind === 'entry'}}" onclick="openEntry(it)">
          <image class="cell-icon" src="{{it.icon}}" />
          <text class="cell-name">{{it.name}}</text>
          <text class="cell-size" show="{{it.size}}">{{it.size}}</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" show="{{it.isDir}}" />
        </div>
        <!-- v1.2.4：多语言语法高亮行（token 着色，纯 text 无 span，快客安全形态） -->
        <div class="code-row" show="{{it.kind === 'cline'}}">
          <text class="ln">{{it.n}}</text>
          <div class="code-toks">
            <text class="tk tk-{{tk.c}}" for="{{tk in it.toks}}" tid="tk.i">{{tk.s}}</text>
          </div>
        </div>
        <text class="code-line" show="{{it.kind === 'line'}}">{{it.n}}  {{it.s}}</text>
        <!-- 弦电子书式翻页器：每页固定行数，上一页/下一页 + 页码指示（目录/文件共用，pagePrev/Next 内按 mode 分发） -->
        <div class="pager" show="{{it.kind === 'pager'}}">
          <text class="pager-btn" show="{{it.canPrev}}" onclick="pagePrev">上一页</text>
          <text class="pager-info">{{it.info}}</text>
          <text class="pager-btn" show="{{it.canNext}}" onclick="pageNext">下一页</text>
        </div>
        <div class="ai-row" show="{{it.kind === 'ai'}}" onclick="askAI">
          <image class="ai-ic" src="/common/icons/ai.png" />
          <text class="ai-t">{{it.text}}</text>
        </div>
        <text class="foot" show="{{it.kind === 'foot'}}">{{it.text}}</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
      <text class="state-prog" show="{{progressText}}">{{progressText}}</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">空目录</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="reload">点此重试</text>
    </div>
  </div>
</template>

<style>
  /* band v2.0 BDS-192（手环 9/10/11 标准版 192×490 / 212×520）：主文本 24-26/代码 21-28，页头 56；
   * 代码区 480 高屏每页 12 行（28px 行高 ≈ 12 行 + 翻页器一屏），行号列 56px */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 56px; flex-direction: row; align-items: center; padding: 8px 14px 0; } /* v2.0.3 R角：顶垫8+侧垫14，图标字形离开手环屏幕圆角裁切区 */
  .hd-act { width: 30px; height: 30px;  overflow: hidden;}
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 48px; height: 48px; align-items: center; justify-content: center; margin-left: -6px;  overflow: hidden;}
  .hd-main { flex: 1; flex-direction: column; margin-left: 6px; }
  .hd-title { font-size: 20px; font-weight: bold; color: #e6edf3; lines: 1; text-overflow: ellipsis; line-height: 28px;}
  .hd-sub { font-size: 14px; color: #484f58; margin-top: 2px; lines: 1; text-overflow: ellipsis; line-height: 18px;}
  /* 固件根修保留：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 44px; } /* v2.0.3 R角：尾部缓冲 14→44，末张卡片离开底部圆角+手势区 */
  .li { padding: 4px 10px; width: 100%; flex-direction: column; }
  .li-code { padding: 1px 10px; width: 100%; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 16px; padding: 10px; }
  .cell-icon { width: 28px; height: 28px;  overflow: hidden;}
  .cell-name { flex: 1; font-size: 18px; color: #e6edf3; margin-left: 8px; lines: 2; text-overflow: ellipsis; line-height: 24px;}
  .muted { color: #8b949e; }
  .cell-size { font-size: 14px; color: #484f58; }
  .cell-arrow { width: 20px; height: 20px; margin-left: 6px; }
  .code-line { font-size: 16px; color: #c9d1d9; line-height: 22px; }
  /* 语法高亮：token 着色（GitHub Dark 色板），行号列 + token 行内流式排布 */
  .code-row { flex-direction: row; width: 100%; align-items: flex-start; }
  .ln { width: 44px; font-size: 14px; color: #484f58; text-align: right; margin-right: 8px; line-height: 22px; }
  .code-toks { flex: 1; flex-direction: row; flex-wrap: wrap; align-items: flex-start; overflow: hidden; }
  .tk { font-size: 16px; line-height: 22px; color: #c9d1d9; }
  .tk-kw { color: #ff7b72; }
  .tk-str { color: #a5d6ff; }
  .tk-num { color: #79c0ff; }
  .tk-com { color: #6e7681; }
  .tk-fn { color: #d2a8ff; }
  .tk-ty { color: #ffa657; }
  .tk-key { color: #7ee787; }
  .tk-tag { color: #7ee787; }
  .tk-pun { color: #8b949e; }
  .tk-add { color: #3fb950; background-color: rgba(46, 160, 67, 0.15); }
  .tk-del { color: #f85149; background-color: rgba(248, 81, 73, 0.15); }
  .tk-pl { color: #c9d1d9; }
  .pager { flex-direction: row; align-items: center; justify-content: center; width: 100%; padding: 10px 14px; }
  .pager-btn { font-size: 18px; color: #58a6ff; padding: 10px 18px; }
  .pager-info { font-size: 16px; color: #8b949e; margin: 0 12px; }
  .ai-row { flex-direction: row; align-items: center; justify-content: center; width: 100%; padding: 11px 14px; }
  .ai-ic { width: 28px; height: 28px; margin-right: 9px; }
  .ai-t { font-size: 17px; color: #d2a8ff; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 8px 0; }
  .state { position: absolute; left: 0; top: 56px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 20px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-prog { font-size: 17px; color: #3fb950; margin-top: 12px; text-align: center; }
  .state-btn { font-size: 18px; color: #58a6ff; margin-top: 16px; padding: 12px 22px; background-color: #16233a; border-radius: 16px; }
</style>

<script>import router from '@system.router';
import prompt from '@system.prompt';
import api from '../../utils/gh'; /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
