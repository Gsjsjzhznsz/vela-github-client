<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">设置</text>
    </div>

    <!-- BandQQ v2.9.6 同构：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
    <scroll class="body" scroll-y="true">
      <div class="wrap">
        <!-- 账户状态 -->
        <div class="card" onclick="refreshAccount">
          <div class="card-col">
            <text class="c-title">GitHub 账户</text>
          <text class="c-row">{{hasTk ? '已登录 · ' + tokenMask : '游客模式（公开数据，限流 60 次/小时）'}}</text>
          <text class="c-row2">API 余量 {{rateText}}</text>
          <text class="c-row2" show="{{hasTk && diagText}}">持久化诊断：{{diagText}}</text>
          <text class="c-act">点此刷新登录状态与 API 余量</text>
          </div>
        </div>

        <!-- Token 操作 -->
        <!-- v1.2.0：免打字登录（Device Flow），置顶推荐 -->
        <div class="cell" onclick="startDevice">
          <image class="cell-icon" src="/common/icons/check.png" />
          <text class="cell-label hl">免打字登录（推荐）</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <div class="cell" onclick="startInput">
          <image class="cell-icon" src="/common/icons/gear.png" />
          <text class="cell-label">手动输入 Token</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <!-- v1.1.3：一键重验已存 Token（无需重打 40 位） -->
        <div class="cell" show="{{hasTk}}" onclick="revalidate">
          <image class="cell-icon" src="/common/icons/refresh.png" />
          <text class="cell-label">重新验证当前 Token</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <div class="cell" show="{{hasTk}}" onclick="logout">
          <image class="cell-icon" src="/common/icons/back.png" />
          <text class="cell-label warn">退出登录（清除本机 Token）</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <div class="cell" onclick="goAbout">
          <image class="cell-icon" src="/common/icons/book.png" />
          <text class="cell-label">关于 GitHub for Vela</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <!-- v1.9.0：网络通道（AstroBox 网桥 FetchBridge / 直连） -->
        <div class="card" onclick="cycleBridge">
          <div class="card-col">
            <text class="c-title">网络通道</text>
          <text class="c-row">当前：{{bridgeModeLabel}}</text>
          <text class="c-row2" show="{{!!bridgeStatus}}">{{bridgeStatus}}</text>
          <text class="c-act">点此切换：自动 → 手机网桥 → 仅直连</text>
          </div>
        </div>
        <div class="cell" onclick="detectBridge">
          <image class="cell-icon" src="/common/icons/refresh.png" />
          <text class="cell-label">检测手机网桥（AstroBox）</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <!-- 说明 -->
        <div class="card">
          <div class="card-col">
            <text class="c-title">如何登录？</text>
          <text class="c-body">推荐：点「免打字登录」，手环显示 8 位码</text>
          <text class="c-body">手机/电脑浏览器打开 github.com/login/device</text>
          <text class="c-body">输入该码并授权，Token 自动保存到手环</text>
          <text class="c-body warn">Token 仅保存在手环本地存储，不会上传到任何服务器</text>
          </div>
        </div>

        <div class="card">
          <text class="c-title">关于</text>
          <text class="c-body">GitHub for Vela v2.0.6-pro（设置页版本号与发布同步；详情见下方「关于」入口独立页）</text>
          <text class="c-body">运行于 Xiaomi Vela OS（NuttX），适配小米手环 9 Pro / 10 Pro（336×480）方屏</text>
          <text class="c-body">网络：手环直连 api.github.com；砍网机型可用手机网桥（AstroBox FetchBridge）代发</text>
          <text class="c-body">开源协议：AGPL-3.0 · 参考 BandQQ 键盘组件架构</text>
          </div>
        </div>
    </scroll>
    </div>
  </div>
</template>

<style>
  /* band-pro v2.0 BDS-336：主文本 25-26/次 20-21/弱 19，卡 radius 20，页头 96（手环 9/10 Pro 336×480） */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 112px; flex-direction: row; align-items: center; padding: 24px 28px 0; } /* v2.0.6 R角二轮：顶垫24+侧垫28，返回钮完全离开屏幕圆角区 */
  .hd-act { width: 46px; height: 46px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 76px; height: 76px; align-items: center; justify-content: center; margin-left: 4px; }
  .hd-title { font-size: 27px; font-weight: bold; color: #e6edf3; margin-left: 6px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .wrap { flex-direction: column; padding: 6px 14px 24px; }
  .card { background-color: #161b22; border-radius: 20px; padding: 14px; margin-bottom: 10px; flex-direction: column; }
  /* 卡内列容器必须显式声明 column：本固件 div 缺省按 row 排布，缺定义会导致卡内多行文本横向串排（v1.10.1 根修保留） */
  .card-col { flex-direction: column; }
  .c-title { font-size: 25px; color: #e6edf3; font-weight: bold; margin-bottom: 6px; }
  .c-row { font-size: 21px; color: #c9d1d9; }
  .c-row2 { font-size: 20px; color: #3fb950; margin-top: 5px; }
  .c-body { font-size: 20px; color: #8b949e; line-height: 28px; margin-top: 3px; }
  .warn { color: #d29922; }
  .c-act { font-size: 20px; color: #58a6ff; margin-top: 9px; }
  .cell { flex-direction: row; align-items: center; background-color: #161b22; border-radius: 20px; padding: 16px 14px; margin-bottom: 10px; }
  .cell-icon { width: 30px; height: 30px; }
  .cell-label { flex: 1; font-size: 25px; color: #e6edf3; margin-left: 12px; lines: 1; text-overflow: ellipsis; }
  .cell-arrow { width: 22px; height: 22px; }
  .hl { color: #3fb950; }
</style>

<script>import router from '@system.router';
import prompt from '@system.prompt';
import api from '../../utils/gh'; /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
import { maskToken } from '../../utils/fmt';
function _catch(body, recover) {
  try {
    var result = body();
  } catch (e) {
    return recover(e);
  }
  if (result && result.then) {
    return result.then(void 0, recover);
  }
  return result;
}
export default {
  private: {
    hasTk: false,
    tokenMask: '',
    rateText: '…',
    diagText: '',
    bridgeModeLabel: '自动（直连优先，失败走网桥）',
    bridgeStatus: ''
  },
  onInit() {},
  onShow: function () {
    try {
      const _this = this;
      // force 重读存储：登录/登出发生在 input 页的独立 JS context，
      // 本页缓存的 loadToken promise 不会自动失效（游客模式假象根因）
      return Promise.resolve(api.loadToken(true)).then(function () {
        _this.hasTk = api.hasToken();
        _this.tokenMask = _this.hasTk ? maskToken(api.currentToken()) : '';
        _this.refreshDiag();
        _this.refreshRate();
        _this.syncBridge();
      });
    } catch (e) {
      return Promise.reject(e);
    }
  },
  /* ---- v1.9.0：网络通道（AstroBox 网桥） ---- */
  syncBridge() {
    try {
      const info = api.bridgeInfo();
      this.bridgeModeLabel = info.mode === 'auto' ? '自动（直连优先，失败走网桥）' : info.mode === 'bridge' ? '手机网桥优先' : '仅手环直连';
      let s = '';
      if (!info.supported) {
        s = '本机不支持 interconnect，网桥不可用';
      } else if (info.ready) {
        const neg = info.neg || {};
        s = '网桥已连接 · 协议 v' + (neg.version || 1) + (neg.chunked ? ' · 分片' + (neg.chunkSize || 0) + 'B' : '') + (neg.ack ? ' · ACK流控' : '') + (info.stat && info.stat.sent > 0 ? ' · 已发' + info.stat.sent + ' 成功' + info.stat.ok : '');
      } else {
        s = '网桥未连接（需手机端 AstroBox + FetchBridge 插件）';
      }
      this.bridgeStatus = s;
    } catch (e) {
      this.bridgeStatus = '';
    }
  },
  /** 三态循环：auto → bridge → direct → auto */
  cycleBridge() {
    const order = ['auto', 'bridge', 'direct'];
    const cur = api.bridgeInfo().mode;
    const next = order[(order.indexOf(cur) + 1) % order.length];
    api.bridgeSetMode(next);
    this.syncBridge();
    prompt.showToast({
      message: next === 'auto' ? '已切自动：直连优先，失败走网桥' : next === 'bridge' ? '已切手机网桥优先（砍网机型选这个）' : '已切仅直连',
      duration: 1800
    });
  },
  /** 手动检测：补发握手 + 诊断手机端连接状态 */detectBridge: function () {
    try {
      const _this2 = this;
      function _temp2() {
        _this2.syncBridge();
      }
      prompt.showToast({
        message: '正在检测手机网桥…',
        duration: 1200
      });
      api.bridgeDetect();
      const _temp = _catch(function () {
        return Promise.resolve(api.bridgeDiagnoseHost(8000)).then(function (d) {
          const st = Number(d && d.status);
          const msg = st === 0 ? '手机端连接 OK（AstroBox 就绪）' : st === 1001 ? '手机端未安装 AstroBox' : st === 204 ? '连接超时：请打开手机端 AstroBox' : '诊断失败：' + (d && d.message || st);
          prompt.showToast({
            message: msg,
            duration: 2500
          });
        });
      }, function () {
        prompt.showToast({
          message: '诊断失败',
          duration: 1500
        });
      });
      return Promise.resolve(_temp && _temp.then ? _temp.then(_temp2) : _temp2(_temp));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  refreshDiag() {
    if (!this.hasTk) {
      this.diagText = '';
      return;
    }
    const d = api.storageDiag();
    // 用「有/无」而非 √/×（× 字符未经固件字库验证，√ 已实证可用）
    const ch = (n, v) => n + (v > 0 ? ' 有' + v + '位' : ' 无');
    let s = ch('storage', d.storage) + ' · ' + ch('file', d.file);
    if (d.write) s += ' · 写入:' + d.write;else if (d.src) s += ' · 读取自:' + d.src;
    this.diagText = s;
  },
  refreshRate: function () {
    try {
      const _this3 = this;
      const _temp3 = _catch(function () {
        return Promise.resolve(api.getRateLimit()).then(function (r) {
          const core = r && r.resources && r.resources.core;
          if (core) _this3.rateText = core.remaining + '/' + core.limit;
        });
      }, function () {
        _this3.rateText = '未知';
      });
      return Promise.resolve(_temp3 && _temp3.then ? _temp3.then(function () {}) : void 0);
    } catch (e) {
      return Promise.reject(e);
    }
  },
  /** v1.2.1：账户卡手动刷新——重读 token + 重验 + 刷新余量 */refreshAccount: function () {
    try {
      const _this4 = this;
      return Promise.resolve(api.loadToken(true)).then(function () {
        _this4.hasTk = api.hasToken();
        _this4.tokenMask = _this4.hasTk ? maskToken(api.currentToken()) : '';
        _this4.refreshDiag();
        return Promise.resolve(_this4.refreshRate()).then(function () {
          prompt.showToast({
            message: _this4.hasTk ? '已刷新 · 已登录' : '已刷新 · 游客模式',
            duration: 1200
          });
        });
      });
    } catch (e) {
      return Promise.reject(e);
    }
  },
  /* ---- v1.2.0：免打字登录（Device Flow） ---- */
  startDevice() {
    this.$app.$def.hook = {};
    router.push({
      uri: 'pages/device'
    });
  },
  /* ---- Token 输入：跳 BandQQ compose 同构输入页（键盘常驻） ---- */
  startInput() {
    // 预填已存 Token：重进时无需重新逐字键入 40 位（input 页首个键入会整体替换，不会拼接）
    this.$app.$def.hook = {
      type: 'token',
      initial: api.currentToken() || ''
    };
    router.push({
      uri: 'pages/input'
    });
  },
  /* v1.8.0：独立关于页（照搬 BandQQ pages/about，仅改项目相关信息） */
  goAbout() {
    router.push({
      uri: 'pages/about'
    });
  },
  /* v1.1.3：一键重验已存 Token —— 二次输入手误 401 的根治路径：根本不用再输入 */revalidate: function () {
    try {
      const _this5 = this;
      return Promise.resolve(api.loadToken(true)).then(function () {
        function _temp5() {
          _this5.refreshRate();
        }
        const t = api.currentToken();
        if (!t) {
          _this5.hasTk = false;
          return;
        }
        prompt.showToast({
          message: '正在验证已存 Token…',
          duration: 1500
        });
        const _temp4 = _catch(function () {
          return Promise.resolve(api.validateToken(t)).then(function (user) {
            _this5.hasTk = true;
            _this5.tokenMask = maskToken(t);
            prompt.showToast({
              message: 'Token 有效 · ' + (user && user.login || ''),
              duration: 1800
            });
          });
        }, function (e) {
          const st = e && e.status !== undefined ? e.status : '?';
          prompt.showToast({
            message: '验证失败[' + st + ']：' + (e && e.message || '，可退出登录后重输'),
            duration: 2800
          });
        });
        return _temp4 && _temp4.then ? _temp4.then(_temp5) : _temp5(_temp4);
      });
    } catch (e) {
      return Promise.reject(e);
    }
  },
  logout: function () {
    try {
      const _this6 = this;
      return Promise.resolve(api.clearToken()).then(function () {
        _this6.hasTk = false;
        _this6.tokenMask = '';
        prompt.showToast({
          message: '已退出登录',
          duration: 1500
        });
      });
    } catch (e) {
      return Promise.reject(e);
    }
  },
  goBack() {
    router.back();
  }
};</script>
