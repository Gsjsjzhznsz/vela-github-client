              return Promise.resolve(api.verifyPersisted()).then(function () {
                prompt.showToast({
                  message: '登录成功，已保存本机',
                  duration: 2000
                });
              });
            });
          }
        }();
        return _temp3 && _temp3.then ? _temp3.then(_temp4) : _temp4(_temp3);
      }, function (e) {
