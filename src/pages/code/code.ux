<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <div class="hd-main">
        <text class="hd-title">{{hdTitle}}</text>
        <text class="hd-sub" show="{{mode === 'dir' && pathText}}">{{pathText}}</text>
      </div>
    </div>

    <div class="body-wrap">
      <scroll class="body" scroll-y="true" scroll-top="{{scrollTop}}">
      <!-- 固件 elif 不可靠：分支全部 show 预渲染（BandQQ v2.9.6 同款安全形态） -->
      <div class="{{it.kind === 'line' ? 'li-code' : (it.kind === 'cline' ? 'li-code' : 'li')}}" for="{{it in items}}" tid="id">
        <div class="cell" show="{{it.kind === 'up'}}" onclick="goUp">
          <image class="cell-icon" src="/common/icons/back.png" />
          <text class="cell-name muted">返回上级</text>
        </div>
        <div class="cell" show="{{it.kind === 'entry'}}" onclick="openEntry(it)">
          <image class="cell-icon" src="{{it.icon}}" />
          <text class="cell-name">{{it.name}}</text>
          <text class="cell-size" show="{{it.size}}">{{it.size}}</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" show="{{it.isDir}}" />
        </div>
        <!-- v1.2.4：多语言语法高亮行（token 着色，纯 text 无 span，快客安全形态） -->
        <div class="code-row" show="{{it.kind === 'cline'}}">
          <text class="ln">{{it.n}}</text>
          <div class="code-toks">
            <text class="tk tk-{{tk.c}}" for="{{tk in it.toks}}" tid="tk.i">{{tk.s}}</text>
          </div>
        </div>
        <text class="code-line" show="{{it.kind === 'line'}}">{{it.n}}  {{it.s}}</text>
        <!-- 弦电子书式翻页器：每页固定行数，上一页/下一页 + 页码指示（目录/文件共用，pagePrev/Next 内按 mode 分发） -->
        <div class="pager" show="{{it.kind === 'pager'}}">
          <text class="pager-btn" show="{{it.canPrev}}" onclick="pagePrev">上一页</text>
          <text class="pager-info">{{it.info}}</text>
          <text class="pager-btn" show="{{it.canNext}}" onclick="pageNext">下一页</text>
        </div>
        <div class="ai-row" show="{{it.kind === 'ai'}}" onclick="askAI">
          <image class="ai-ic" src="/common/icons/ai.png" />
          <text class="ai-t">{{it.text}}</text>
        </div>
        <text class="foot" show="{{it.kind === 'foot'}}">{{it.text}}</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
      <text class="state-prog" show="{{progressText}}">{{progressText}}</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">空目录</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="reload">点此重试</text>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 44px; height: 44px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 64px; height: 64px; align-items: center; justify-content: center; margin-left: -10px; }
  .hd-main { flex: 1; flex-direction: column; margin-left: 7px; }
  .hd-title { font-size: 24px; font-weight: bold; color: #e6edf3; lines: 1; text-overflow: ellipsis; }
  .hd-sub { font-size: 13px; color: #484f58; margin-top: 1px; lines: 1; text-overflow: ellipsis; }
  /* RW5 固件根修：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 60px; }
  .li { padding: 4px 12px; width: 100%; }
  .li-code { padding: 1px 10px; width: 100%; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 10px; padding: 11px 12px; }
  .cell-icon { width: 19px; height: 19px; }
  .cell-name { flex: 1; font-size: 19px; color: #e6edf3; margin-left: 10px; lines: 1; text-overflow: ellipsis; }
  .muted { color: #8b949e; }
  .cell-size { font-size: 13px; color: #484f58; }
  .cell-arrow { width: 14px; height: 14px; margin-left: 5px; }
  .code-line { font-size: 14px; color: #c9d1d9; line-height: 18px; }
  /* v1.2.4 语法高亮：token 着色（GitHub Dark 色板），行号列 + token 行内流式排布 */
  .code-row { flex-direction: row; width: 100%; align-items: flex-start; }
  .ln { width: 48px; font-size: 12px; color: #484f58; text-align: right; margin-right: 9px; line-height: 18px; }
  .code-toks { flex: 1; flex-direction: row; flex-wrap: wrap; align-items: flex-start; overflow: hidden; }
  .tk { font-size: 14px; line-height: 18px; color: #c9d1d9; }
  .tk-kw { color: #ff7b72; }
  .tk-str { color: #a5d6ff; }
  .tk-num { color: #79c0ff; }
  .tk-com { color: #6e7681; }
  .tk-fn { color: #d2a8ff; }
  .tk-ty { color: #ffa657; }
  .tk-key { color: #7ee787; }
  .tk-tag { color: #7ee787; }
  .tk-pun { color: #8b949e; }
  .tk-add { color: #3fb950; background-color: rgba(46, 160, 67, 0.15); }
  .tk-del { color: #f85149; background-color: rgba(248, 81, 73, 0.15); }
  .tk-pl { color: #c9d1d9; }
  .pager { flex-direction: row; align-items: center; justify-content: center; width: 100%; padding: 8px 12px; }
  .pager-btn { font-size: 17px; color: #58a6ff; padding: 6px 14px; }
  .pager-info { font-size: 14px; color: #8b949e; margin: 0 10px; }
  .ai-row { flex-direction: row; align-items: center; justify-content: center; width: 100%; padding: 9px 12px; }
  .ai-ic { width: 22px; height: 22px; margin-right: 8px; }
  .ai-t { font-size: 17px; color: #d2a8ff; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 7px 0; }
  .state { position: absolute; left: 0; top: 94px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 19px; color: #8b949e; text-align: center; padding: 0 29px; }
  .state-prog { font-size: 15px; color: #3fb950; margin-top: 10px; text-align: center; }
  .state-btn { font-size: 17px; color: #58a6ff; margin-top: 12px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/gh' /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
  import { compact } from '../../utils/fmt'
  import { query } from '../../utils/view'
  import { detectLang, buildBlockState, tokenizeLine } from '../../utils/hl'

  /* v1.2.1：大文件上限 200KB → 1MB（raw Range 分块引擎同步升级到 1MB）；
   * 超限不再直接拒绝——上限内全部可开，超过才提示。
   * v1.2.2：参考弦电子书分段渲染——每页固定行数（原 3000 行一次性入列，
   * 模板节点多、渲染重、低端机滚动卡顿；分页后每页仅 ~20 节点）。 */
  const MAX_LINES = 3000
  const MAX_SIZE = 1024 * 1024
  const PAGE_SIZE = 18
  /* v1.3.0：目录列表同样分页——深/巨型目录（node_modules 单层数百条目）
   * 一次性入列曾导致渲染树爆炸 → OOM 死机重启；每页 24 条后节点数恒定。 */
  const PAGE_DIR = 24
  const BIN_EXT = ['png', 'jpg', 'jpeg', 'gif', 'webp', 'ico', 'zip', 'gz', 'tar', '7z', 'rar', 'exe', 'dll', 'so', 'dylib', 'pdf', 'mp3', 'mp4', 'wav', 'woff', 'woff2', 'ttf', 'eot', 'otf', 'jar', 'class', 'pyc', 'bin', 'apk', 'rpk']

  export default {
    protected: {
      full: ''
    },
    private: {
      mode: 'dir',
      hdTitle: '',
      pathText: '',
      items: [],
      state: 'loading',
      errMsg: '',
      progressText: '',
      scrollTop: 0,
      curPage: 1,
      dirPages: 1
    },
    onInit(params) {
      const p = query(params, this)
      if (p.full) this.full = p.full
      this._segments = []      // 当前目录段
      this._shaStack = []      // v1.1.3：各级目录 tree sha（contents 截断时 trees 回退用）
      this._filePath = ''      // 当前文件路径
      this._fileName = ''
      this._allLines = []      // v1.2.2：文件全量行（分页渲染源）
      this._lang = 'plain'     // v1.2.4：语法高亮语言（按文件名探测）
      this._block = []         // v1.2.4：跨行块注释/围栏状态表（载入时一次预计算）
      this._totalPages = 1
      this._capped = false
      this._scrollTick = 0
      this._dirEntries = []     // v1.3.0：目录全量条目（分页渲染源）
      this._dirCache = {}       // v1.3.0：会话目录缓存（返回上级/来回翻秒开，上限 16 层）
      this.hdTitle = this.full
      this.loadDir()
    },
    currentPath() {
      return this._segments.join('/')
    },
    async loadDir() {
      this.mode = 'dir'
      this.state = 'loading'
      const cacheKey = this.full + '#' + this.currentPath()
      /* v1.3.0：会话目录缓存命中 → 零网络秒开（返回上级/来回翻目录不再重拉） */
      const hit = this._dirCache && this._dirCache[cacheKey]
      if (hit) { this.applyDirList(hit); return }
      try {
        let list = null
        /* v1.4.0：GraphQL 瘦字段目录列表主通道（单条目 ~70B，响应缩 4-7 倍，
         * 中型目录在截断阈值内直达）；游客/限流/网络/路径是文件 → 回落
         * REST 阶梯（contents → 截断 → getTreeEx 下载器整树，v1.3.0 逻辑不变）；
         * 404（GitHub 路径区分大小写）直接抛明确文案。 */
        try {
          list = await api.getDirList(this.full, this.currentPath(), this._branch)
        } catch (eG) {
          if (eG && eG.status === 404) throw eG
          try {
            list = await api.getContents(this.full, this.currentPath(), this._branch)
          } catch (e) {
            if (e && e.incomplete) {
              // v1.1.3：目录响应被蓝牙代理截断（contents 接口无 per_page 可降）——
              // 回退 git trees API：条目瘦 3-4 倍，大目录可完整到达；
              // 子树定位用上一级缓存的目录 sha（根用 HEAD）
              // v1.3.0：改用 getTreeEx——trees 的 fetch 响应对巨型目录仍会截断，
              // 原生下载器整树一次到齐（深目录数据不完整的根治）
              const sha = this._shaStack.length ? this._shaStack[this._shaStack.length - 1] : 'HEAD'
              const t = await api.getTreeEx(this.full, sha)
              const arr = t && Array.isArray(t.tree) ? t.tree : null
              if (!arr) throw { message: '目录响应不完整，请重试' }
              list = []
              for (let i = 0; i < arr.length; i++) {
                const x = arr[i]
                list.push({
                  name: x.path.split('/').pop(),
                  path: x.path,
                  type: x.type === 'tree' ? 'dir' : 'file',
                  size: x.size || 0,
                  sha: x.sha || ''
                })
              }
            } else {
              throw e
            }
          }
        }
        if (!Array.isArray(list)) {
          // 内容接口对单文件返回对象：仅当结构完整才按文件查看，
          // 其余（残缺 JSON / 字符串 / 空对象）一律报错，绝不渲染垃圾数据
          if (list && typeof list === 'object' && list.type === 'file' && list.path) {
            this._filePath = list.path
            await this.openFileText(list.path, list.name, list.size || 0)
            return
          }
          throw { message: '目录响应不完整，请重试' }
        }
        const dirs = []
        const files = []
        for (let i = 0; i < list.length; i++) {
          const e = list[i]
          if (e.type === 'dir') dirs.push(e)
          else files.push(e)
        }
        dirs.sort((a, b) => (a.name < b.name ? -1 : 1))
        files.sort((a, b) => (a.name < b.name ? -1 : 1))
        const out = []
        if (this._segments.length > 0) out.push({ id: 'up', kind: 'up' })
        for (let i = 0; i < dirs.length; i++) {
          out.push({
            id: 'd' + i,
            kind: 'entry',
            name: dirs[i].name,
            path: dirs[i].path,
            isDir: true,
            sha: dirs[i].sha || '',
            icon: '/common/icons/folder.png',
            size: '',
            rawSize: 0
          })
        }
        for (let i = 0; i < files.length; i++) {
          out.push({
            id: 'f' + i,
            kind: 'entry',
            name: files[i].name,
            path: files[i].path,
            isDir: false,
            sha: files[i].sha || '',
            icon: '/common/icons/code.png',
            size: compact(files[i].size || 0) + 'B',
            rawSize: files[i].size || 0
          })
        }
        if (out.length === 0) out.push({ id: 'empty0', kind: 'foot', text: '（空目录）' })
        // v1.3.0：目录缓存 + 分页——全量条目入 _dirEntries，页面仅渲染当页 24 条
        this._dirCache[cacheKey] = out
        const keys = Object.keys(this._dirCache)
        if (keys.length > 16) delete this._dirCache[keys[0]]
        this.applyDirList(out)
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '加载失败'
      }
    },
    /* 目录渲染统一出口：缓存命中/网络拉取共用（分页 + 滚动复位 + 路径文本） */
    applyDirList(out) {
        this._dirEntries = out
        this.dirPages = Math.max(1, Math.ceil(out.length / PAGE_DIR))
        this.renderDirPage(1)
        this.pathText = this.currentPath()
        this._scrollTick++
        this.scrollTop = (this._scrollTick % 2) ? 1 : 0
        this.state = 'ok'
    },
    /* v1.3.0：目录分页渲染（弦电子书式限量）——含「返回上级」首项与翻页器 */
    renderDirPage(n) {
      const start = (n - 1) * PAGE_DIR
      const slice = this._dirEntries.slice(start, start + PAGE_DIR)
      const out = slice.slice()
      out.push({
        id: 'dpager',
        kind: 'pager',
        info: '第 ' + n + ' / ' + this.dirPages + ' 页 · 共 ' + this._dirEntries.length + ' 项',
        canPrev: n > 1,
        canNext: n < this.dirPages
      })
      out.push({ id: 'dai', kind: 'ai', text: '问 AI 关于本目录' })
      this.items = out
      this.curPage = n
    },
    /* v1.3.0：翻页器目录/文件共用，按 mode 分发 */
    pagePrev() {
      if (this.mode === 'file') { if (this.curPage > 1) this.pageTurnTo(this.curPage - 1); return }
      if (this.mode === 'dir' && this.curPage > 1) this.turnDir(this.curPage - 1)
    },
    pageNext() {
      if (this.mode === 'file') { if (this.curPage < this._totalPages) this.pageTurnTo(this.curPage + 1); return }
      if (this.mode === 'dir' && this.curPage < this.dirPages) this.turnDir(this.curPage + 1)
    },
    turnDir(n) {
      this._scrollTick++
      this.renderDirPage(n)
      this.scrollTop = (this._scrollTick % 2) ? 1 : 0
    },
    /* v1.3.0：问 AI——把当前文件片段/目录清单注入 Copilot 专区上下文 */
    askAI() {
      const app = this.$app.$def
      let ctx = ''
      if (this.mode === 'file' && this._allLines.length) {
        ctx = '文件 ' + this._filePath + ' 内容片段：\n' + this._allLines.slice(0, 120).join('\n').slice(0, 3800)
      } else if (this._dirEntries.length) {
        const names = []
        for (let i = 0; i < this._dirEntries.length && i < 60; i++) {
          const e = this._dirEntries[i]
          if (e.kind === 'entry') names.push((e.isDir ? '[目录] ' : '[文件] ') + e.name)
        }
        ctx = (this.currentPath() || '仓库根目录') + ' 目录清单：\n' + names.join('\n')
      }
      app.aiCtx = { full: this.full, path: this.mode === 'file' ? this._filePath : this.currentPath(), text: ctx }
      router.push({ uri: 'pages/ai' })
    },
    async openEntry(item) {
      if (!item) return
      if (item.isDir) {
        this._segments = item.path.split('/')
        // v1.1.3：记录目录 tree sha（深层大目录回退 trees API 时定位子树）；
        // contents/trees 的目录项都自带 sha，栈深始终与层级对齐
        if (item.sha) this._shaStack.push(item.sha)
        this.hdTitle = item.name
        this.loadDir()
      } else {
        const ext = (item.name.split('.').pop() || '').toLowerCase()
        if (BIN_EXT.indexOf(ext) >= 0) {
          prompt.showToast({ message: '二进制文件，暂不支持查看', duration: 2000 })
          return
        }
        if (item.rawSize && item.rawSize > MAX_SIZE) {
          prompt.showToast({ message: '文件超过 1MB，暂不支持查看', duration: 2000 })
          return
        }
        this._filePath = item.path
        this._fileName = item.name
        this.state = 'loading'
        /* v1.4.0：目录项自带的字节数传入下载器作完整性基准（静默截断守门员） */
        await this.openFileText(item.path, item.name, item.rawSize || 0)
      }
    },
    async openFileText(path, name, expectedSize) {
      try {
        this._wantSize = expectedSize || 0
        // v1.2.2：原生下载器主通道无逐块进度，先给「正在下载」占位避免像卡死；
        // 分块回退路径由 onProg 覆盖为「已加载 X / Y」
        const fmtB = (n) => (n >= 1024 ? (Math.round(n / 102.4) / 10) + 'KB' : n + 'B')
        this.progressText = '正在下载文件（原生通道）…'
        this.state = 'loading'
        const onProg = (loaded, total) => {
          this.progressText = total > 0
            ? '已加载 ' + fmtB(loaded) + ' / ' + fmtB(total)
            : '已加载 ' + fmtB(loaded)
        }
        const r = await api.getFileRawEx(this.full, path, this._branch, onProg, expectedSize || 0)
        const text = r && r.text
        if (typeof text !== 'string') {
          // raw 请求返回了对象：代理丢了 Accept 头，拿到的是文件元信息 JSON 而非内容
          throw { message: '文件响应异常，请重试' }
        }
        if (!text) {
          throw { message: '文件内容为空' }
        }
        this._fileName = name || path.split('/').pop()
        this.hdTitle = this._fileName
        const lines = text.replace(/\r/g, '').split('\n')
        if (lines.length > MAX_LINES) lines.length = MAX_LINES
        this._allLines = lines
        // v1.2.4：语法高亮 —— 语言探测 + 跨行块状态一次预计算（弦电子书式
        // 限量渲染：翻页时只对当页 18 行分词，全程毫秒级）
        this._lang = detectLang(this._fileName)
        this._block = this._lang === 'plain' ? [] : buildBlockState(lines, this._lang)
        this._capped = !!r.capped
        this._totalPages = Math.max(1, Math.ceil(lines.length / PAGE_SIZE))
        this.mode = 'file'
        this.renderFilePage(1)
        this.state = 'ok'
        this.progressText = ''
      } catch (e) {
        this.mode = 'dir'
        this.state = 'error'
        this.errMsg = (e && e.message) || '文件加载失败'
        this.progressText = ''
      }
    },
    /* ---- v1.2.2 弦电子书式分页渲染 + v1.2.4 按页语法高亮 ---- */
    renderFilePage(n) {
      const start = (n - 1) * PAGE_SIZE
      const slice = this._allLines.slice(start, start + PAGE_SIZE)
      const hl = this._lang !== 'plain'
      const out = []
      for (let i = 0; i < slice.length; i++) {
        const raw = slice[i]
        const s = raw.length > 160 ? raw.slice(0, 160) + '…' : raw
        if (hl) {
          const bs = this._block[start + i] || { inb: false, lg: this._lang }
          out.push({
            id: 'l' + start + '_' + i,
            kind: 'cline',
            n: start + i + 1,
            toks: tokenizeLine(s, bs.lg, bs.inb)
          })
        } else {
          out.push({ id: 'l' + start + '_' + i, kind: 'line', n: start + i + 1, s: s })
        }
      }
      out.push({
        id: 'pager',
        kind: 'pager',
        info: '第 ' + n + ' / ' + this._totalPages + ' 页',
        canPrev: n > 1,
        canNext: n < this._totalPages
      })
      out.push({ id: 'fai', kind: 'ai', text: '问 AI 关于本文件' })
      if (this._capped) out.push({ id: 'cap', kind: 'foot', text: '— 文件过大，仅显示前 1MB，其余已省略 —' })
      else if (this._allLines.length >= MAX_LINES) out.push({ id: 'max', kind: 'foot', text: '（已达 3000 行上限，其余行已省略）' })
      else if (n >= this._totalPages) out.push({ id: 'end', kind: 'foot', text: '— 文件结尾 —' })
      this.items = out
      this.curPage = n
    },
    /* 翻页并复位滚动：交替 1/0 确保绑定值必变（同值不重触发，BandQQ tick 同源问题） */
    pageTurnTo(n) {
      this._scrollTick++
      this.renderFilePage(n)
      this.scrollTop = (this._scrollTick % 2) ? 1 : 0
    },
    pagePrev() {
      if (this.mode === 'file' && this.curPage > 1) this.pageTurnTo(this.curPage - 1)
    },
    pageNext() {
      if (this.mode === 'file' && this.curPage < this._totalPages) this.pageTurnTo(this.curPage + 1)
    },
    goUp() {
      if (this._segments.length > 0) {
        this._segments.pop()
        if (this._shaStack.length > 0) this._shaStack.pop()
        this.hdTitle = this._segments.length === 0 ? this.full : this._segments[this._segments.length - 1]
        this.loadDir()
      }
    },
    reload() {
      if (this.mode === 'file') {
        this.openFileText(this._filePath, this._fileName, this._wantSize || 0)
      } else {
        this.loadDir()
      }
    },
    goBack() {
      if (this.mode === 'file') {
        this.hdTitle = this._segments.length === 0 ? this.full : this._segments[this._segments.length - 1]
        this.loadDir()
        return
      }
      if (this._segments.length > 0) {
        this.goUp()
        return
      }
      router.back()
    },
    onDestroy() {
      this.items = []
      this._allLines = []
      this._block = []
      this._dirEntries = []
      this._dirCache = {}
    }
  }
</script>
