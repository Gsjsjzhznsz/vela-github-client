<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">通知{{unreadN > 0 ? ' (' + unreadN + ')' : ''}}</text>
      <text class="hd-filter" onclick="toggleAll">{{all ? '全部' : '未读'}}</text>
      <div class="hd-act-wrap" onclick="markAllRead"><image class="hd-act" src="/common/icons/check.png" /></div>
    </div>

    <div class="pull" style="height: {{pullY}}px">
      <image class="pull-icon" src="/common/icons/refresh.png" />
      <text class="pull-text">{{pullText}}</text>
    </div>

    <!-- RW5 固件根修（BandQQ v2.9.6 同构）：wrap flex:1 + scroll absolute 铺满，不依赖引擎 flex 高度计算 -->
    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll"
              ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
        <div class="li" for="{{it in items}}" tid="id">
          <div class="cell" onclick="openNotif(it)" onlongpress="markOne(it)">
            <div class="unread" show="{{it.unread}}"></div>
            <image class="cell-icon" src="{{it.icon}}" />
            <div class="cell-main">
              <text class="cell-repo">{{it.repo}}</text>
              <!-- v1.2.3：CI 聚合卡（aggN>1）显示条数与操作提示；普通通知原样 -->
              <text class="cell-title" show="{{!it.aggN || it.aggN <= 1}}">{{it.title}}</text>
              <text class="cell-title" show="{{it.aggN > 1}}">{{it.aggN}} 条 CI 通知（未读 {{it.unreadN}}）</text>
              <text class="cell-time">{{it.time}}{{it.ci ? ' · CI' : ''}}{{it.unread ? ' · 长按标已读' : ''}}</text>
            </div>
          </div>
        </div>
        <text class="foot" show="{{state === 'ok' && hasMore}}" onclick="loadMore">加载更多</text>
        <text class="foot" show="{{state === 'ok' && !hasMore && items.length > 0}}">— 到底了 —</text>
        <div class="pad-end"></div>
      </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">{{emptyText}}</text>
      <text class="state-btn" onclick="doRefresh">重新加载</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doRefresh">点此重试</text>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 44px; height: 44px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 64px; height: 64px; align-items: center; justify-content: center; margin-left: -10px; }
  .hd-title { font-size: 24px; font-weight: bold; color: #e6edf3; margin-left: 7px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .hd-filter { font-size: 16px; color: #58a6ff; margin-right: 12px; }
  .pull { flex-direction: row; align-items: center; justify-content: center; overflow: hidden; }
  .pull-icon { width: 17px; height: 17px; }
  .pull-text { font-size: 14px; color: #8b949e; margin-left: 7px; }
  /* RW5 固件根修：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 60px; }
  .li { padding: 4px 12px; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 12px; padding: 11px 12px; }
  .unread { position: absolute; left: 2px; top: 2px; width: 7px; height: 7px; border-radius: 4px; background-color: #3fb950; }
  .cell-icon { width: 22px; height: 22px; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 10px; }
  .cell-repo { font-size: 14px; color: #8b949e; lines: 1; text-overflow: ellipsis; }
  .cell-title { font-size: 20px; color: #e6edf3; margin-top: 2px; lines: 2; text-overflow: ellipsis; }
  .cell-time { font-size: 13px; color: #484f58; margin-top: 2px; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 7px 0; }
  .state { position: absolute; left: 0; top: 94px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 19px; color: #8b949e; text-align: center; padding: 0 29px; }
  .state-btn { font-size: 17px; color: #58a6ff; margin-top: 12px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/api'
  import { mapNotif, aggregateNotifs } from '../../utils/view'

  export default {
    private: {
      items: [],
      all: false,
      state: 'loading',   // loading | ok | empty | error
      errMsg: '',
      emptyText: '暂无通知',
      page: 1,
      hasMore: true,
      loadingMore: false,
      refreshing: false,
      scY: 0,
      tY: 0,
      pullY: 0,
      pullText: '下拉刷新',
      unreadN: 0
    },
    onInit() {},
    async onShow() {
      await api.loadToken()
      if (!api.hasToken()) {
        this.state = 'empty'
        this.emptyText = '通知需登录：请到首页 → 设置填入 Token'
        return
      }
      if (this.items.length === 0) this.reload()
    },
    async reload() {
      this.state = 'loading'
      try {
        const list = await api.getNotifications(1, this.all)
        if (!Array.isArray(list)) {
          throw { message: '通知响应不完整，请重试' }
        }
        // v1.2.3：CI 通知聚合折叠——同仓库连续 ci_activity 合成一张卡，
        // 200 条 CI 噪音不再淹没真实通知（用户体感「数据不完整」的根源）
        const mapped = aggregateNotifs(list.map(mapNotif))
        this.items = mapped
        this.page = 1
        // v1.2.2：通知改为并行子页策略，逻辑页大小固定 notifPageSize()（10），
        // 不再用 lastListPerPage()（那是自适应列表的全局状态，会被其它页污染）
        this.hasMore = list.length >= api.notifPageSize()
        this.state = this.items.length === 0 ? 'empty' : 'ok'
        this.emptyText = this.all ? '没有通知' : '没有未读通知'
        this.countUnread()
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '加载失败'
      }
    },
    countUnread() {
      let n = 0
      for (let i = 0; i < this.items.length; i++) {
        if (this.items[i].unread) n++
      }
      this.unreadN = n
    },
    async loadMore() {
      if (!this.hasMore || this.loadingMore || this.state !== 'ok') return
      this.loadingMore = true
      try {
        const next = this.page + 1
        const list = await api.getNotifications(next, this.all)
        // v1.2.3：增量聚合——新页先自身聚合，再与尾部同仓库 CI 段合并防断卡
        const agg = aggregateNotifs(list.map(mapNotif))
        const tail = this.items[this.items.length - 1]
        const head = agg[0]
        if (tail && head && tail.ci && head.ci && tail.repo === head.repo && tail.aggN) {
          tail.threads = tail.threads.concat(head.threads)
          tail.aggN = tail.aggN + head.aggN
          tail.unreadN = (tail.unreadN || 0) + (head.unreadN || 0)
          tail.unread = tail.unreadN > 0
          tail.time = head.time
          agg.shift()
        }
        for (let i = 0; i < agg.length; i++) this.items.push(agg[i])
        this.page = next
        this.hasMore = list.length >= api.notifPageSize()
        this.countUnread()
      } catch (e) {
        prompt.showToast({ message: '加载失败：' + ((e && e.message) || ''), duration: 1500 })
      }
      this.loadingMore = false
    },
    toggleAll() {
      this.all = !this.all
      this.reload()
    },
    async markAllRead() {
      try {
        await api.markAllNotificationsRead()
        for (let i = 0; i < this.items.length; i++) this.items[i].unread = false
        this.countUnread()
        prompt.showToast({ message: '已全部标记已读', duration: 1500 })
      } catch (e) {
        prompt.showToast({ message: (e && e.message) || '操作失败', duration: 2000 })
      }
    },
    async openNotif(item) {
      if (!item) return
      // v1.2.3：CI 通知/聚合卡 → Actions 页（workflow 运行列表）
      if (item.ci) {
        if (item.unread) {
          item.unread = false
          this.countUnread()
        }
        this.$app.$def.hook = { full: item.repo }
        router.push({ uri: 'pages/actions' })
        return
      }
      if (item.unread) {
        item.unread = false
        this.countUnread()
        api.markThreadRead(item.threadUrl).catch(function () {})
      }
      if ((item.icon === '/common/icons/issue.png' || item.icon === '/common/icons/pull.png') && item.url) {
        const n = item.url.split('/').pop()
        this.$app.$def.hook = { full: item.repo, n: n }
        router.push({ uri: 'pages/issue' })
      } else {
        this.$app.$def.hook = { full: item.repo }
        router.push({ uri: 'pages/repo' })
      }
    },
    /** 长按：CI 聚合卡 → 批量已读（该段全部线程并行标记）；普通通知仅标记单条 */
    async markOne(item) {
      if (!item) return
      if (item.ci && item.aggN > 1) {
        try {
          const ok = await api.markThreadsRead(item.threads)
          item.unread = false
          item.unreadN = 0
          this.countUnread()
          prompt.showToast({ message: '已标记 ' + ok + ' 条 CI 已读', duration: 1500 })
        } catch (e) {
          prompt.showToast({ message: (e && e.message) || '操作失败', duration: 1500 })
        }
        return
      }
      if (!item.unread) return
      item.unread = false
      this.countUnread()
      try {
        await api.markThreadRead(item.threadUrl)
        prompt.showToast({ message: '已标记已读', duration: 1200 })
      } catch (e) {
        prompt.showToast({ message: (e && e.message) || '操作失败', duration: 1500 })
      }
    },
    /* ---- 下拉刷新（list 自定义手势） ---- */
    doRefresh() {
      if (this.refreshing) return
      this.refreshing = true
      this.pullY = 60
      this.pullText = '刷新中…'
      this.reload().then(() => {
        this.refreshing = false
        this.pullY = 0
      })
    },
    onListScroll(e) {
      this.scY = (e && e.scrollY) || 0
      // 触底自动加载（scroll 组件无 scrollbottom，用 scrollY 估算：单项约 78px）
      if (this.state === 'ok' && this.hasMore && !this.loadingMore) {
        const near = this.items.length * 110 - 420
        if (near > 0 && this.scY >= near) this.loadMore()
      }
    },
    onTouchStart(e) {
      if (this.scY <= 0 && !this.refreshing) {
        const t = e && e.touches && e.touches[0]
        this.tY = (t && (t.pageY || t.clientY)) || 0
      }
    },
    onTouchMove(e) {
      if (this.refreshing || this.tY <= 0 || this.scY > 0) return
      const t = e && e.touches && e.touches[0]
      const y = (t && (t.pageY || t.clientY)) || 0
      const delta = y - this.tY
      if (delta > 0) {
        this.pullY = Math.min(112, Math.floor(delta * 0.45))
        this.pullText = this.pullY > 80 ? '松开刷新' : '下拉刷新'
      }
    },
    onTouchEnd() {
      if (this.refreshing) return
      if (this.pullY > 80) {
        this.doRefresh()
      } else {
        this.pullY = 0
      }
      this.tY = 0
    },
    goBack() {
      router.back()
    }
  }
</script>
