<template>
  <div class="page">
    <div class="hd">
      <image class="hd-act" src="/common/icons/back.png" onclick="goBack" />
      <text class="hd-title">搜索仓库</text>
    </div>

    <div class="srow">
      <div class="sbox" onclick="goInput">
        <text class="stext {{query ? '' : 'ph'}}">{{query ? query : '输入关键词…'}}</text>
      </div>
      <text class="sbtn" onclick="doSearch">搜索</text>
    </div>

    <!-- RW5 固件根修（BandQQ v2.9.6 同构）：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll">
      <div class="li" for="{{it in items}}" tid="id">
        <div class="cell" onclick="openRepo(it)">
          <div class="ava" style="background-color: {{it.avc}}">
            <text class="ava-t">{{it.avn}}</text>
          </div>
          <div class="cell-main">
            <text class="cell-title">{{it.full}}</text>
            <text class="cell-desc" show="{{!!it.desc}}">{{it.desc}}</text>
            <div class="meta">
              <div class="dot" show="{{!!it.lang}}" style="background-color: {{it.langc}}"></div>
              <text class="meta-t" show="{{!!it.lang}}">{{it.lang}}</text>
              <image class="meta-ic" src="/common/icons/star.png" />
              <text class="meta-t">{{it.stars}}</text>
            </div>
          </div>
        </div>
      </div>
      <div class="li" show="{{state === 'ok' && !hasMore && items.length > 0}}">
        <text class="foot">共 {{total}} 个结果 · 到底了</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">搜索中…</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">{{emptyText}}</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doSearch">重试</text>
    </div>

    <!-- 输入走 BandQQ compose 同构独立输入页（键盘常驻，见 pages/input） -->
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 44px; height: 44px; }
  .hd-title { font-size: 24px; font-weight: bold; color: #e6edf3; margin-left: 7px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .srow { flex-direction: row; align-items: center; padding: 2px 12px 7px; }
  /* 定宽防溢出：flex:1 + 无 max-width 的文本行在引擎里不收缩，会把 sbtn 挤出屏（实测 432 下按钮被裁） */
  .sbox { width: 296px; height: 36px; background-color: #161b22; border: 1px solid #30363d; border-radius: 18px; justify-content: center; padding: 0 12px; }
  .stext { font-size: 17px; color: #e6edf3; lines: 1; text-overflow: ellipsis; }
  .ph { color: #484f58; }
  .sbtn { font-size: 17px; color: #ffffff; background-color: #238636; border-radius: 18px; padding: 8px 14px; margin-left: 10px; }
  /* RW5 固件根修：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 60px; }
  .li { padding: 4px 12px; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 12px; padding: 11px 12px; }
  .ava { width: 36px; height: 36px; border-radius: 18px; justify-content: center; align-items: center; }
  .ava-t { font-size: 19px; color: #ffffff; font-weight: bold; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 10px; }
  .cell-title { font-size: 20px; color: #58a6ff; font-weight: bold; lines: 1; text-overflow: ellipsis; }
  .cell-desc { font-size: 16px; color: #8b949e; margin-top: 2px; lines: 2; text-overflow: ellipsis; }
  .meta { flex-direction: row; align-items: center; margin-top: 5px; }
  .dot { width: 10px; height: 10px; border-radius: 5px; margin-right: 4px; }
  .meta-ic { width: 13px; height: 13px; margin-left: 10px; margin-right: 2px; }
  .meta-t { font-size: 14px; color: #8b949e; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 7px 0; }
  /* top 142：必须让出 srow（94~136），否则遮罩盖住搜索框吞点击 */
  .state { position: absolute; left: 0; top: 142px; right: 0; bottom: 48px; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 19px; color: #8b949e; text-align: center; padding: 0 29px; }
  .state-btn { font-size: 17px; color: #58a6ff; margin-top: 12px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/api'
  import { mapRepo } from '../../utils/view'


  export default {
    private: {
      query: '',
      items: [],
      state: 'empty',   // empty | loading | ok | error
      errMsg: '',
      emptyText: '输入关键词开始搜索',
      total: 0,
      page: 1,
      hasMore: true,
      loadingMore: false,
      searched: false
    },
    onInit() {
    },
    async onShow() {
      // 消费独立输入页回传的草稿（BandQQ store 同构：应用级共享态）
      const app = this.$app.$def
      const r = app && app.inputResult
      if (r && r.type === 'search' && r.text) {
        app.inputResult = null
        this.query = r.text
        this.doSearch()
      }
    },
    goInput() {
      this.$app.$def.hook = { type: 'search', initial: this.query || '' }
      router.push({ uri: 'pages/input' })
    },
    async doSearch() {
      const kw = this.query.trim()
      if (!kw) {
        prompt.showToast({ message: '请先输入关键词', duration: 1500 })
        return
      }
      this.state = 'loading'
      this.searched = true
      try {
        const r = await api.searchRepos(kw, 1, 'best match')
        const list = (r && Array.isArray(r.items)) ? r.items : []
        this.total = (r && r.total_count) || list.length
        this.items = list.map(mapRepo)
        this.page = 1
        this.hasMore = list.length >= 10
        this.state = this.items.length === 0 ? 'empty' : 'ok'
        this.emptyText = '没有找到相关仓库'
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '搜索失败'
      }
    },
    onListScroll(e) {
      const y = (e && e.scrollY) || 0
      // 触底自动加载（scrollY 估算：单项约 84px）
      if (this.state === 'ok' && this.hasMore && !this.loadingMore) {
        const near = this.items.length * 118 - 420
        if (near > 0 && y >= near) this.loadMore()
      }
    },

    async loadMore() {
      if (!this.searched || !this.hasMore || this.loadingMore || this.state !== 'ok') return
      this.loadingMore = true
      try {
        const next = this.page + 1
        const r = await api.searchRepos(this.query.trim(), next, 'best match')
        const list = (r && Array.isArray(r.items)) ? r.items : []
        for (let i = 0; i < list.length; i++) this.items.push(mapRepo(list[i]))
        this.page = next
        this.hasMore = list.length >= 10
      } catch (e) {
        prompt.showToast({ message: '加载失败：' + ((e && e.message) || ''), duration: 1500 })
      }
      this.loadingMore = false
    },
    openRepo(item) {
      if (!item) return
      this.$app.$def.hook = { full: item.full }
      router.push({ uri: 'pages/repo' })
    },
    doRefresh() {
      if (this.query.trim()) this.doSearch()
    },
    goBack() {
      router.back()
    }
  }
</script>
