<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">{{full}}</text>
    </div>

    <div class="tabs">
      <text class="tab {{state === 'open' ? 'on' : ''}}" onclick="switchState('open')">开放</text>
      <text class="tab {{state === 'closed' ? 'on' : ''}}" onclick="switchState('closed')">已关闭</text>
    </div>

    <div class="pull" style="height: {{pullY}}px">
      <image class="pull-icon" src="/common/icons/refresh.png" />
      <text class="pull-text">{{pullText}}</text>
    </div>

    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll"
          ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
      <div class="li" for="{{it in items}}" tid="id">
        <div class="cell" onclick="openIssue(it)">
          <image class="cell-icon" src="/common/icons/issue.png" />
          <div class="cell-main">
            <text class="cell-title">{{it.title}}</text>
            <text class="cell-sub">#{{it.num}} · {{it.author}} · {{it.time}}{{it.comments > 0 ? ' · ' + it.comments + ' 评论' : ''}}</text>
            <text class="lb" show="{{it.labelsText}}" style="color: {{it.labelColor}}">{{it.labelsText}}</text>
          </div>
        </div>
      </div>
      <div class="li" show="{{loadState === 'ok' && loadingMore}}">
        <text class="foot" onclick="loadMore">加载更多</text>
      </div>
      <div class="li" show="{{loadState === 'ok' && !hasMore && items.length > 0}}">
        <text class="foot">— 到底了 —</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{loadState === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{loadState === 'empty'}}">
      <text class="state-t">没有相关 Issue</text>
      <text class="state-btn" onclick="doRefresh">重新加载</text>
    </div>
    <div class="state" show="{{loadState === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doRefresh">点此重试</text>
    </div>
  </div>
</template>

<style>
  /* band v2.0 BDS-192：主文本 20/次 16/弱 14，卡 radius 12，页头 56（手环 9/10/11 标准版 192×490 / 212×520） */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 56px; flex-direction: row; align-items: center; padding: 8px 14px 0; } /* v2.0.3 R角：顶垫8+侧垫14，图标字形离开手环屏幕圆角裁切区 */
  .hd-act { width: 30px; height: 30px;  overflow: hidden;}
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 48px; height: 48px; align-items: center; justify-content: center; margin-left: -6px;  overflow: hidden;}
  .hd-title { font-size: 21px; font-weight: bold; color: #e6edf3; margin-left: 6px; flex: 1; lines: 1; text-overflow: ellipsis; line-height: 28px;}
  .tabs { flex-direction: row; padding: 3px 10px 9px; }
  .tab { font-size: 17px; color: #8b949e; padding: 8px 20px; background-color: #161b22; border-radius: 11px; margin-right: 12px; }
  .on { color: #ffffff; background-color: #1f6feb; }
  .pull { flex-direction: row; align-items: center; justify-content: center; overflow: hidden; }
  .pull-icon { width: 24px; height: 24px; }
  .pull-text { font-size: 17px; color: #8b949e; margin-left: 8px; }
  /* 固件根修保留：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 44px; } /* v2.0.3 R角：尾部缓冲 14→44，末张卡片离开底部圆角+手势区 */
  .li { padding: 4px 10px; flex-direction: column; }
  .cell { flex-direction: row; align-items: flex-start; width: 100%; background-color: #161b22; border-radius: 12px; padding: 10px; }
  .cell-icon { width: 26px; height: 26px; margin-top: 3px;  overflow: hidden;}
  .cell-main { flex: 1; flex-direction: column; margin-left: 8px; }
  .cell-title { font-size: 17px; color: #e6edf3; font-weight: bold; lines: 2; text-overflow: ellipsis; }
  .cell-sub { font-size: 14px; color: #8b949e; margin-top: 5px; lines: 1; text-overflow: ellipsis; line-height: 22px;}
  .labels { flex-direction: row; margin-top: 6px; }
  .lb { font-size: 14px; margin-right: 8px; border: 1px solid #30363d; border-radius: 12px; padding: 2px 10px; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 8px 0; }
  .state { position: absolute; left: 0; top: 56px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 20px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-btn { font-size: 18px; color: #58a6ff; margin-top: 16px; padding: 12px 22px; background-color: #16233a; border-radius: 16px; }
</style>

<script>import router from '@system.router';
import prompt from '@system.prompt';
import api from '../../utils/gh'; /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
import { mapIssue } from '../../utils/view';
import { query } from '../../utils/view';
function _catch(body, recover) {
  try {
    var result = body();
  } catch (e) {
    return recover(e);
  }
  if (result && result.then) {
    return result.then(void 0, recover);
  }
  return result;
}
export default {
  protected: {
    full: ''
  },
  private: {
    state: 'open',
    loadState: 'loading',
    items: [],
    errMsg: '',
    page: 1,
    hasMore: true,
    loadingMore: false,
    refreshing: false,
    scY: 0,
    tY: 0,
    pullY: 0,
    pullText: '下拉刷新'
  },
  onInit(params) {
    const p = query(params, this);
    if (p.full) this.full = p.full;
  },
  onShow() {
    if (this.full && this.items.length === 0) this.reload();
  },
  reload: function () {
    try {
      const _this = this;
      _this.loadState = 'loading';
      return Promise.resolve(_catch(function () {
        return Promise.resolve(api.getIssues(_this.full, 1, _this.state)).then(function (list) {
          if (!Array.isArray(list)) {
            throw {
              message: 'Issue 列表响应不完整，请重试'
            };
          }
          _this.items = list.map(mapIssue);
          _this.page = 1;
          _this.hasMore = list.length >= api.lastListPerPage();
          _this.loadState = _this.items.length === 0 ? 'empty' : 'ok';
        });
      }, function (e) {
        _this.loadState = 'error';
        _this.errMsg = e && e.message || '加载失败';
      }));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  loadMore: function () {
    try {
      const _this2 = this;
      function _temp2() {
        _this2.loadingMore = false;
      }
      if (!_this2.hasMore || _this2.loadingMore || _this2.loadState !== 'ok') return Promise.resolve();
      _this2.loadingMore = true;
      const _temp = _catch(function () {
        const next = _this2.page + 1;
        return Promise.resolve(api.getIssues(_this2.full, next, _this2.state)).then(function (list) {
          for (let i = 0; i < list.length; i++) _this2.items.push(mapIssue(list[i]));
          _this2.page = next;
          _this2.hasMore = list.length >= api.lastListPerPage();
        });
      }, function (e) {
        prompt.showToast({
          message: '加载失败：' + (e && e.message || ''),
          duration: 1500
        });
      });
      return Promise.resolve(_temp && _temp.then ? _temp.then(_temp2) : _temp2(_temp));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  switchState(s) {
    if (this.state === s) return;
    this.state = s;
    this.items = [];
    this.reload();
  },
  openIssue(item) {
    if (!item) return;
    this.$app.$def.hook = {
      full: this.full,
      n: String(item.num)
    };
    router.push({
      uri: 'pages/issue'
    });
  },
  doRefresh() {
    if (this.refreshing) return;
    this.refreshing = true;
    this.pullY = 60;
    this.pullText = '刷新中…';
    this.reload().then(() => {
      this.refreshing = false;
      this.pullY = 0;
    });
  },
  onListScroll(e) {
    this.scY = e && e.scrollY || 0;
    // 触底自动加载（scroll 组件无 scrollbottom，用 scrollY 估算）
    if (this.state === 'ok' && this.hasMore && !this.loadingMore) {
      const near = this.items.length * 96 - 300;
      if (near > 0 && this.scY >= near) this.loadMore();
    }
  },
  onTouchStart(e) {
    if (this.scY <= 0 && !this.refreshing) {
      const t = e && e.touches && e.touches[0];
      this.tY = t && (t.pageY || t.clientY) || 0;
    }
  },
  onTouchMove(e) {
    if (this.refreshing || this.tY <= 0 || this.scY > 0) return;
    const t = e && e.touches && e.touches[0];
    const y = t && (t.pageY || t.clientY) || 0;
    const delta = y - this.tY;
    if (delta > 0) {
      this.pullY = Math.min(112, Math.floor(delta * 0.45));
      this.pullText = this.pullY > 80 ? '松开刷新' : '下拉刷新';
    }
  },
  onTouchEnd() {
    if (this.refreshing) return;
    if (this.pullY > 80) this.doRefresh();else this.pullY = 0;
    this.tY = 0;
  },
  goBack() {
    router.back();
  }
};</script>
