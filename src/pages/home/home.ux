<template>
  <div class="page">
    <div class="hd">
      <image class="hd-logo" src="/common/icons/logo.png" />
      <text class="hd-title">GitHub</text>
    </div>

    <!-- BandQQ v2.9.6 同构：wrap flex:1 + scroll absolute 铺满（RW5 固件 flex:1 scroll 高度计算不可靠） -->
    <div class="body-wrap">
      <scroll class="body" scroll-y="true">
        <!-- 账户状态卡 -->
        <div class="li">
          <div class="card">
            <div class="ava" style="background-color: {{avColor}}">
              <text class="ava-t">{{avCh}}</text>
            </div>
            <div class="card-main">
              <text class="row1">{{hasTk ? loginName : '游客模式'}}</text>
              <text class="row2">{{hasTk ? '已登录 · ' + tokenMask : '登录后可看通知 / 私有仓库'}}</text>
              <text class="row3">API 余量 {{rateText}}</text>
            </div>
          </div>
        </div>

        <!-- 功能菜单 -->
        <div class="li" for="{{it in menu}}" tid="id">
          <div class="cell" onclick="goMenu(it)">
            <image class="cell-icon" src="{{it.icon}}" />
            <div class="cell-main">
              <text class="cell-label">{{it.label}}</text>
              <text class="cell-sub" show="{{!!it.sub}}">{{it.sub}}</text>
            </div>
            <image class="cell-arrow" src="/common/icons/chevron.png" />
          </div>
        </div>

        <text class="foot">Vela JS 应用 · AGPL-3.0 · 手环 9/10 Pro 适配</text>
        <div class="pad-end"></div>
      </scroll>
    </div>
  </div>
</template>

<style>
  /* band-pro v2.0：designWidth 336（手环 9/10 Pro 336×480，1css=1物理px，BandQQ bandpro 分支同构基准）。
   * BDS-336 设计系统：主文本 26 / 次文本 21 / 弱文本 19，卡片 radius 20、大触区（单元格高 ≥64）。
   * 根容器 100%/100%，页头 96px 避让状态区；wrap flex:1 + scroll absolute 铺满（固件 flex 不可靠根修保留） */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 104px; flex-direction: row; align-items: center; padding: 20px 28px 0; } /* v2.0.6 R角二轮：顶垫20+侧垫28 */
  .hd-logo { width: 44px; height: 44px; border-radius: 10px; }
  .hd-title { font-size: 28px; font-weight: bold; color: #e6edf3; margin-left: 12px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .hd-act { width: 46px; height: 46px; }
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 24px; }
  .li { padding: 5px 14px; flex-direction: column; }
  .card { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 20px; padding: 14px; }
  .ava { width: 60px; height: 60px; border-radius: 30px; justify-content: center; align-items: center; }
  .ava-t { font-size: 30px; color: #ffffff; font-weight: bold; }
  .card-main { flex-direction: column; margin-left: 14px; flex: 1; }
  .row1 { font-size: 26px; color: #e6edf3; font-weight: bold; lines: 1; text-overflow: ellipsis; }
  .row2 { font-size: 21px; color: #8b949e; margin-top: 3px; lines: 1; text-overflow: ellipsis; }
  .row3 { font-size: 20px; color: #3fb950; margin-top: 3px; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 20px; padding: 15px 14px; }
  .cell-icon { width: 34px; height: 34px; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 14px; }
  .cell-label { font-size: 26px; color: #e6edf3; }
  .cell-sub { font-size: 20px; color: #8b949e; margin-top: 3px; lines: 1; text-overflow: ellipsis; }
  .cell-arrow { width: 24px; height: 24px; }
  .foot { font-size: 19px; color: #484f58; text-align: center; width: 100%; padding: 12px 0; }
</style>

<script>import router from '@system.router';
import prompt from '@system.prompt';
import api from '../../utils/gh'; /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
import { avatar, maskToken } from '../../utils/fmt';
function _catch(body, recover) {
  try {
    var result = body();
  } catch (e) {
    return recover(e);
  }
  if (result && result.then) {
    return result.then(void 0, recover);
  }
  return result;
}
export default {
  private: {
    menu: [],
    hasTk: false,
    loginName: '',
    tokenMask: '',
    rateText: '…',
    avCh: 'G',
    avColor: '#21262d'
  },
  onInit() {
    this.menu = [{
      id: 'notifications',
      icon: '/common/icons/bell.png',
      label: '通知中心',
      sub: ''
    }, {
      id: 'repos',
      icon: '/common/icons/repo.png',
      label: '我的仓库',
      sub: ''
    }, {
      id: 'search',
      icon: '/common/icons/search.png',
      label: '搜索',
      sub: ''
    }, {
      id: 'trending',
      icon: '/common/icons/trend.png',
      label: '趋势',
      sub: ''
    }, {
      id: 'ai',
      icon: '/common/icons/ai.png',
      label: 'Copilot 专区',
      sub: ''
    }, {
      id: 'profile',
      icon: '/common/icons/person.png',
      label: '个人主页',
      sub: ''
    }, {
      id: 'settings',
      icon: '/common/icons/gear.png',
      label: '设置 · Token',
      sub: ''
    }];
  },
  onShow: function () {
    try {
      const _this = this;
      return Promise.resolve(api.loadToken()).then(function () {
        function _temp3() {
          _this.refreshRate();
        }
        _this.hasTk = api.hasToken();
        _this.tokenMask = _this.hasTk ? maskToken(api.currentToken()) : '';
        const _temp2 = function () {
          if (_this.hasTk) {
            const _temp = _catch(function () {
              return Promise.resolve(api.self()).then(function (me) {
                _this.loginName = me.login || '';
                const av = avatar(_this.loginName);
                _this.avCh = av.ch;
                _this.avColor = av.color;
              });
            }, function () {
              _this.loginName = 'Token 异常';
              _this.avCh = '!';
              _this.avColor = '#8b1f1f';
            });
            if (_temp && _temp.then) return _temp.then(function () {});
          } else {
            _this.loginName = '';
            _this.avCh = 'G';
            _this.avColor = '#21262d';
          }
        }();
        return _temp2 && _temp2.then ? _temp2.then(_temp3) : _temp3(_temp2);
      });
    } catch (e) {
      return Promise.reject(e);
    }
  },
  refreshRate: function () {
    try {
      let _exit = false;
      const _this2 = this;
      function _temp5(_result) {
        if (_exit) return _result;
        _this2.rateText = '未知';
      }
      const _temp4 = _catch(function () {
        return Promise.resolve(api.getRateLimit()).then(function (r) {
          const core = r && r.resources && r.resources.core;
          if (core) {
            _this2.rateText = core.remaining + '/' + core.limit;
            _exit = true;
          }
        });
      }, function () {});
      return Promise.resolve(_temp4 && _temp4.then ? _temp4.then(_temp5) : _temp5(_temp4));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  goMenu(item) {
    if (!item) return;
    if (item.id === 'notifications' && !this.hasTk) {
      this.toast('通知需登录：请先到设置填入 Token');
      return;
    }
    if (item.id === 'repos' && !this.hasTk) {
      this.toast('仓库列表需登录；游客可使用搜索/趋势');
      return;
    }
    if (item.id === 'ai' && !this.hasTk) {
      this.toast('AI 功能需登录 Token');
      return;
    }
    router.push({
      uri: 'pages/' + item.id
    });
  },
  toast(msg) {
    prompt.showToast({
      message: msg,
      duration: 2000
    });
  }
};</script>
