<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">搜索仓库</text>
    </div>

    <div class="srow">
      <div class="sbox" onclick="goInput">
        <text class="stext {{query ? '' : 'ph'}}">{{query ? query : '输入关键词…'}}</text>
      </div>
      <text class="sbtn" onclick="doSearch">搜索</text>
    </div>

    <!-- RW5 固件根修（BandQQ v2.9.6 同构）：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll">
      <div class="li" for="{{it in items}}" tid="id">
        <div class="cell" onclick="openRepo(it)">
          <div class="ava" style="background-color: {{it.avc}}">
            <text class="ava-t">{{it.avn}}</text>
          </div>
          <div class="cell-main">
            <text class="cell-title">{{it.full}}</text>
            <text class="cell-desc" show="{{!!it.desc}}">{{it.desc}}</text>
            <div class="meta">
              <div class="dot" show="{{!!it.lang}}" style="background-color: {{it.langc}}"></div>
              <text class="meta-t" show="{{!!it.lang}}">{{it.lang}}</text>
              <image class="meta-ic" src="/common/icons/star.png" />
              <text class="meta-t">{{it.stars}}</text>
            </div>
          </div>
        </div>
      </div>
      <div class="li" show="{{state === 'ok' && !hasMore && items.length > 0}}">
        <text class="foot">共 {{total}} 个结果 · 到底了</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">搜索中…</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">{{emptyText}}</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doSearch">重试</text>
    </div>

    <!-- 输入走 BandQQ compose 同构独立输入页（键盘常驻，见 pages/input） -->
  </div>
</template>

<style>
  /* band-pro v2.0 BDS-336：主文本 26/次 21/弱 19，卡 radius 20，页头 96（手环 9/10 Pro 336×480） */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 96px; flex-direction: row; align-items: center; padding: 0 14px; }
  .hd-act { width: 46px; height: 46px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 76px; height: 76px; align-items: center; justify-content: center; margin-left: -12px; }
  .hd-title { font-size: 27px; font-weight: bold; color: #e6edf3; margin-left: 6px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .srow { flex-direction: row; align-items: center; padding: 4px 14px 10px; }
  /* 定宽防溢出：flex:1 + 无 max-width 的文本行在引擎里不收缩，会把 sbtn 挤出屏（432 实测根修，336 同理） */
  .sbox { width: 206px; height: 60px; background-color: #161b22; border: 1px solid #30363d; border-radius: 30px; justify-content: center; padding: 0 16px; }
  .stext { font-size: 24px; color: #e6edf3; lines: 1; text-overflow: ellipsis; }
  .ph { color: #484f58; }
  .sbtn { font-size: 24px; color: #ffffff; background-color: #238636; border-radius: 30px; padding: 16px 22px; margin-left: 10px; }
  /* 固件根修保留：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 24px; }
  .li { padding: 5px 14px; flex-direction: column; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 20px; padding: 14px; }
  .ava { width: 48px; height: 48px; border-radius: 24px; justify-content: center; align-items: center; }
  .ava-t { font-size: 26px; color: #ffffff; font-weight: bold; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 12px; }
  .cell-title { font-size: 26px; color: #58a6ff; font-weight: bold; lines: 1; text-overflow: ellipsis; }
  .cell-desc { font-size: 21px; color: #8b949e; margin-top: 3px; lines: 2; text-overflow: ellipsis; }
  .meta { flex-direction: row; align-items: center; margin-top: 7px; }
  .dot { width: 12px; height: 12px; border-radius: 6px; margin-right: 5px; }
  .meta-ic { width: 18px; height: 18px; margin-left: 12px; margin-right: 3px; }
  .meta-t { font-size: 19px; color: #8b949e; }
  .foot { font-size: 19px; color: #484f58; text-align: center; width: 100%; padding: 10px 0; }
  /* top 180：必须让出 srow（96~170），否则遮罩盖住搜索框吞点击 */
  .state { position: absolute; left: 0; top: 180px; right: 0; bottom: 48px; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 26px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-btn { font-size: 24px; color: #58a6ff; margin-top: 16px; padding: 12px 22px; background-color: #16233a; border-radius: 16px; }
</style>

<script>import router from '@system.router';
import prompt from '@system.prompt';
import api from '../../utils/gh'; /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
import { mapRepo } from '../../utils/view';
function _catch(body, recover) {
  try {
    var result = body();
  } catch (e) {
    return recover(e);
  }
  if (result && result.then) {
    return result.then(void 0, recover);
  }
  return result;
}
export default {
  private: {
    query: '',
    items: [],
    state: 'empty',
    // empty | loading | ok | error
    errMsg: '',
    emptyText: '输入关键词开始搜索',
    total: 0,
    page: 1,
    hasMore: true,
    loadingMore: false,
    searched: false
  },
  onInit() {},
  onShow: function () {
    try {
      const _this = this;
      // 消费独立输入页回传的草稿（BandQQ store 同构：应用级共享态）
      const app = _this.$app.$def;
      const r = app && app.inputResult;
      if (r && r.type === 'search' && r.text) {
        app.inputResult = null;
        _this.query = r.text;
        _this.doSearch();
      }
      return Promise.resolve();
    } catch (e) {
      return Promise.reject(e);
    }
  },
  goInput() {
    this.$app.$def.hook = {
      type: 'search',
      initial: this.query || ''
    };
    router.push({
      uri: 'pages/input'
    });
  },
  doSearch: function () {
    try {
      const _this2 = this;
      const kw = _this2.query.trim();
      if (!kw) {
        prompt.showToast({
          message: '请先输入关键词',
          duration: 1500
        });
        return Promise.resolve();
      }
      _this2.state = 'loading';
      _this2.searched = true;
      const _temp = _catch(function () {
        return Promise.resolve(api.searchRepos(kw, 1, 'best match')).then(function (r) {
          const list = r && Array.isArray(r.items) ? r.items : [];
          _this2.total = r && r.total_count || list.length;
          _this2.items = list.map(mapRepo);
          _this2.page = 1;
          _this2.hasMore = list.length >= api.lastListPerPage();
          _this2.state = _this2.items.length === 0 ? 'empty' : 'ok';
          _this2.emptyText = '没有找到相关仓库';
        });
      }, function (e) {
        _this2.state = 'error';
        _this2.errMsg = e && e.message || '搜索失败';
      });
      return Promise.resolve(_temp && _temp.then ? _temp.then(function () {}) : void 0);
    } catch (e) {
      return Promise.reject(e);
    }
  },
  onListScroll(e) {
    const y = e && e.scrollY || 0;
    // 触底自动加载（scrollY 估算：单项约 84px）
    if (this.state === 'ok' && this.hasMore && !this.loadingMore) {
      const near = this.items.length * 165 - 420;
      if (near > 0 && y >= near) this.loadMore();
    }
  },
  loadMore: function () {
    try {
      const _this3 = this;
      function _temp3() {
        _this3.loadingMore = false;
      }
      if (!_this3.searched || !_this3.hasMore || _this3.loadingMore || _this3.state !== 'ok') return Promise.resolve();
      _this3.loadingMore = true;
      const _temp2 = _catch(function () {
        const next = _this3.page + 1;
        return Promise.resolve(api.searchRepos(_this3.query.trim(), next, 'best match')).then(function (r) {
          const list = r && Array.isArray(r.items) ? r.items : [];
          for (let i = 0; i < list.length; i++) _this3.items.push(mapRepo(list[i]));
          _this3.page = next;
          _this3.hasMore = list.length >= api.lastListPerPage();
        });
      }, function (e) {
        prompt.showToast({
          message: '加载失败：' + (e && e.message || ''),
          duration: 1500
        });
      });
      return Promise.resolve(_temp2 && _temp2.then ? _temp2.then(_temp3) : _temp3(_temp2));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  openRepo(item) {
    if (!item) return;
    this.$app.$def.hook = {
      full: item.full
    };
    router.push({
      uri: 'pages/repo'
    });
  },
  doRefresh() {
    if (this.query.trim()) this.doSearch();
  },
  goBack() {
    router.back();
  }
};</script>
