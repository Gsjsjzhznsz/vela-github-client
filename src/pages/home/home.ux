<template>
  <div class="page">
    <div class="hd">
      <image class="hd-logo" src="/common/icons/logo.png" />
      <text class="hd-title">GitHub</text>
    </div>

    <!-- BandQQ v2.9.6 同构：wrap flex:1 + scroll absolute 铺满（RW5 固件 flex:1 scroll 高度计算不可靠） -->
    <div class="body-wrap">
      <scroll class="body" scroll-y="true">
        <!-- 账户状态卡 -->
        <div class="li">
          <div class="card">
            <div class="ava" style="background-color: {{avColor}}">
              <text class="ava-t">{{avCh}}</text>
            </div>
            <div class="card-main">
              <text class="row1">{{hasTk ? loginName : '游客模式'}}</text>
              <text class="row2">{{hasTk ? '已登录 · ' + tokenMask : '登录后可看通知 / 私有仓库'}}</text>
              <text class="row3">API 余量 {{rateText}}</text>
            </div>
          </div>
        </div>

        <!-- 功能菜单 -->
        <div class="li" for="{{it in menu}}" tid="id">
          <div class="cell" onclick="goMenu(it)">
            <image class="cell-icon" src="{{it.icon}}" />
            <div class="cell-main">
              <text class="cell-label">{{it.label}}</text>
              <text class="cell-sub" show="{{!!it.sub}}">{{it.sub}}</text>
            </div>
            <image class="cell-arrow" src="/common/icons/chevron.png" />
          </div>
        </div>

        <text class="foot">Vela JS 应用 · AGPL-3.0 · 手环 9/10/11 适配</text>
        <div class="pad-end"></div>
      </scroll>
    </div>
  </div>
</template>

<style>
  /* band v2.0：designWidth 192（手环 9/10/11 标准版 192×490 / 212×520 / 224×528，1css=1物理px，BandQQ 主分支同构基准）。
   * BDS-192 设计系统：主文本 20 / 次文本 16 / 弱文本 14，卡片 radius 12、大触区（单元格高 ≥48）。
   * 根容器 100%/100%，页头 56px 避让状态区；wrap flex:1 + scroll absolute 铺满（固件 flex 不可靠根修保留） */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 56px; flex-direction: row; align-items: center; padding: 0 10px; }
  .hd-logo { width: 30px; height: 30px; border-radius: 8px; }
  .hd-title { font-size: 22px; font-weight: bold; color: #e6edf3; margin-left: 8px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .hd-act { width: 30px; height: 30px; }
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 14px; }
  .li { padding: 4px 10px; flex-direction: column; }
  .card { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 12px; padding: 10px; }
  .ava { width: 30px; height: 30px; border-radius: 15px; justify-content: center; align-items: center; }
  .ava-t { font-size: 20px; color: #ffffff; font-weight: bold; }
  .card-main { flex-direction: column; margin-left: 10px; flex: 1; }
  .row1 { font-size: 20px; color: #e6edf3; font-weight: bold; lines: 1; text-overflow: ellipsis; }
  .row2 { font-size: 16px; color: #8b949e; margin-top: 3px; lines: 1; text-overflow: ellipsis; }
  .row3 { font-size: 16px; color: #3fb950; margin-top: 3px; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 12px; padding: 11px 10px; }
  .cell-icon { width: 18px; height: 18px; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 10px; }
  .cell-label { font-size: 20px; color: #e6edf3; }
  .cell-sub { font-size: 16px; color: #8b949e; margin-top: 3px; lines: 1; text-overflow: ellipsis; }
  .cell-arrow { width: 16px; height: 16px; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 8px 0; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/gh' /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
  import { avatar, maskToken } from '../../utils/fmt'

  export default {
    private: {
      menu: [],
      hasTk: false,
      loginName: '',
      tokenMask: '',
      rateText: '…',
      avCh: 'G',
      avColor: '#21262d'
    },
    onInit() {
      this.menu = [
        { id: 'notifications', icon: '/common/icons/bell.png', label: '通知中心', sub: '' },
        { id: 'repos', icon: '/common/icons/repo.png', label: '我的仓库', sub: '' },
        { id: 'search', icon: '/common/icons/search.png', label: '搜索', sub: '' },
        { id: 'trending', icon: '/common/icons/trend.png', label: '趋势', sub: '' },
        { id: 'ai', icon: '/common/icons/ai.png', label: 'Copilot 专区', sub: '' },
        { id: 'profile', icon: '/common/icons/person.png', label: '个人主页', sub: '' },
        { id: 'settings', icon: '/common/icons/gear.png', label: '设置 · Token', sub: '' }
      ]
    },
    async onShow() {
      await api.loadToken()
      this.hasTk = api.hasToken()
      this.tokenMask = this.hasTk ? maskToken(api.currentToken()) : ''
      if (this.hasTk) {
        try {
          const me = await api.self()
          this.loginName = me.login || ''
          const av = avatar(this.loginName)
          this.avCh = av.ch
          this.avColor = av.color
        } catch (e) {
          this.loginName = 'Token 异常'
          this.avCh = '!'
          this.avColor = '#8b1f1f'
        }
      } else {
        this.loginName = ''
        this.avCh = 'G'
        this.avColor = '#21262d'
      }
      this.refreshRate()
    },
    async refreshRate() {
      try {
        const r = await api.getRateLimit()
        const core = r && r.resources && r.resources.core
        if (core) {
          this.rateText = core.remaining + '/' + core.limit
          return
        }
      } catch (e) {
        // 限流接口失败不打断页面
      }
      this.rateText = '未知'
    },
    goMenu(item) {
      if (!item) return
      if (item.id === 'notifications' && !this.hasTk) {
        this.toast('通知需登录：请先到设置填入 Token')
        return
      }
      if (item.id === 'repos' && !this.hasTk) {
        this.toast('仓库列表需登录；游客可使用搜索/趋势')
        return
      }
      if (item.id === 'ai' && !this.hasTk) {
        this.toast('AI 功能需登录 Token')
        return
      }
      router.push({ uri: 'pages/' + item.id })
    },

    toast(msg) {
      prompt.showToast({ message: msg, duration: 2000 })
    }
  }
</script>
