<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">趋势</text>
    </div>

    <div class="tabs">
      <text class="tab {{mode === 'classic' ? 'on' : ''}}" onclick="switchMode('classic')">经典</text>
      <text class="tab {{mode === 'rising' ? 'on' : ''}}" onclick="switchMode('rising')">黑马</text>
      <text class="tab {{mode === 'new' ? 'on' : ''}}" onclick="switchMode('new')">新星</text>
    </div>

    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll">
      <div class="li" for="{{it in items}}" tid="id">
        <div class="cell" onclick="openRepo(it)">
          <text class="rank" show="{{it.rank <= 3}}">{{it.rank}}</text>
          <div class="ava" style="background-color: {{it.avc}}">
            <text class="ava-t">{{it.avn}}</text>
          </div>
          <div class="cell-main">
            <text class="cell-title">{{it.full}}</text>
            <text class="cell-desc" show="{{!!it.desc}}">{{it.desc}}</text>
            <div class="meta">
              <div class="dot" show="{{!!it.lang}}" style="background-color: {{it.langc}}"></div>
              <text class="meta-t" show="{{!!it.lang}}">{{it.lang}}</text>
              <image class="meta-ic" src="/common/icons/star.png" />
              <text class="meta-t">{{it.stars}}</text>
            </div>
          </div>
        </div>
      </div>
      <div class="li" show="{{state === 'ok' && hasMore && !loadingMore}}">
        <text class="foot-btn" onclick="loadMore">加载更多</text>
      </div>
      <div class="li" show="{{state === 'ok' && loadingMore}}">
        <text class="foot">加载中…</text>
      </div>
      <div class="li" show="{{state === 'ok' && !hasMore && items.length > 0}}">
        <text class="foot">— 到底了 —</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">暂无数据</text>
      <text class="state-btn" onclick="doRefresh">重新加载</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doRefresh">点此重试</text>
    </div>
  </div>
</template>

<style>
  /* band v2.0 BDS-192：designWidth 192（手环 9/10/11 米粒窄屏），主 20/次 16/弱 14，
   * v2.0.2 交互 BandQQ 化：去触摸下拉（固件 scroll 触摸层未实证）、分页改「加载更多」按钮 */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 56px; flex-direction: row; align-items: center; padding: 0 10px; }
  .hd-act { width: 30px; height: 30px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 48px; height: 48px; align-items: center; justify-content: center; margin-left: -8px; }
  .hd-title { font-size: 21px; font-weight: bold; color: #e6edf3; margin-left: 6px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .tabs { flex-direction: row; padding: 3px 10px 9px; }
  .tab { font-size: 17px; color: #8b949e; padding: 8px 20px; background-color: #161b22; border-radius: 11px; margin-right: 12px; }
  .on { color: #ffffff; background-color: #1f6feb; }
  /* 固件根修保留：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 14px; }
  .li { padding: 4px 10px; flex-direction: column; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 12px; padding: 10px; }
  .rank { width: 30px; font-size: 20px; color: #f0883e; font-weight: bold; text-align: center; }
  .ava { width: 36px; height: 36px; border-radius: 18px; justify-content: center; align-items: center; margin-left: 6px; }
  .ava-t { font-size: 20px; color: #ffffff; font-weight: bold; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 8px; }
  .cell-title { font-size: 20px; color: #58a6ff; font-weight: bold; lines: 1; text-overflow: ellipsis; }
  .cell-desc { font-size: 16px; color: #8b949e; margin-top: 3px; lines: 2; text-overflow: ellipsis; }
  .meta { flex-direction: row; align-items: center; margin-top: 7px; }
  .dot { width: 12px; height: 12px; border-radius: 6px; margin-right: 5px; }
  .meta-ic { width: 18px; height: 18px; margin-left: 8px; margin-right: 3px; }
  .meta-t { font-size: 14px; color: #8b949e; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 8px 0; }
  .foot-btn { font-size: 15px; color: #58a6ff; text-align: center; width: 100%; padding: 10px 0; }
  .state { position: absolute; left: 0; top: 56px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 20px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-btn { font-size: 18px; color: #58a6ff; margin-top: 16px; padding: 12px 22px; background-color: #16233a; border-radius: 16px; }
</style>

<script>import router from '@system.router';
import prompt from '@system.prompt';
import api from '../../utils/gh'; /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
import { mapRepo } from '../../utils/view';
function _catch(body, recover) {
  try {
    var result = body();
  } catch (e) {
    return recover(e);
  }
  if (result && result.then) {
    return result.then(void 0, recover);
  }
  return result;
}
export default {
  private: {
    mode: 'classic',
    items: [],
    state: 'loading',
    errMsg: '',
    page: 1,
    hasMore: true,
    loadingMore: false
  },
  onInit() {},
  onShow() {
    if (this.items.length === 0) this.reload();
  },
  reload: function () {
    try {
      const _this = this;
      _this.state = 'loading';
      const _temp = _catch(function () {
        return Promise.resolve(api.getTrending(_this.mode, 1)).then(function (r) {
          const list = r && Array.isArray(r.items) ? r.items : [];
          _this.items = list.map((it, i) => {
            const m = mapRepo(it);
            m.rank = i + 1;
            return m;
          });
          _this.page = 1;
          _this.hasMore = list.length >= api.lastListPerPage();
          _this.state = _this.items.length === 0 ? 'empty' : 'ok';
        });
      }, function (e) {
        _this.state = 'error';
        _this.errMsg = e && e.message || '加载失败';
      });
      return Promise.resolve(_temp && _temp.then ? _temp.then(function () {}) : void 0);
    } catch (e) {
      return Promise.reject(e);
    }
  },
  loadMore: function () {
    try {
      const _this2 = this;
      function _temp3() {
        _this2.loadingMore = false;
      }
      if (!_this2.hasMore || _this2.loadingMore || _this2.state !== 'ok') return Promise.resolve();
      _this2.loadingMore = true;
      const _temp2 = _catch(function () {
        const next = _this2.page + 1;
        return Promise.resolve(api.getTrending(_this2.mode, next)).then(function (r) {
          const list = r && Array.isArray(r.items) ? r.items : [];
          for (let i = 0; i < list.length; i++) {
            const m = mapRepo(list[i]);
            m.rank = _this2.items.length + 1;
            _this2.items.push(m);
          }
          _this2.page = next;
          _this2.hasMore = list.length >= api.lastListPerPage();
        });
      }, function (e) {
        prompt.showToast({
          message: '加载失败：' + (e && e.message || ''),
          duration: 1500
        });
      });
      return Promise.resolve(_temp2 && _temp2.then ? _temp2.then(_temp3) : _temp3(_temp2));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  switchMode(m) {
    if (this.mode !== m) {
      this.mode = m;
      this.items = [];
    }
    /* 同 tab 再点一次 = 手动刷新（v2.0.2 去下拉刷新后的刷新入口） */
    this.reload();
  },
  openRepo(item) {
    if (!item) return;
    this.$app.$def.hook = {
      full: item.full
    };
    router.push({
      uri: 'pages/repo'
    });
  },
  doRefresh() {
    this.reload();
  },
  onListScroll(e) {
    /* v2.0.2：仅做触底自动加载估算，不写观察态（避免每滚动帧触发脏检查）；
     * 分页主入口是「加载更多」按钮，此处只在接近底部时提前拉取 */
    const y = e && e.scrollY || 0;
    if (this.state === 'ok' && this.hasMore && !this.loadingMore) {
      const near = this.items.length * 88 - 300;
      if (near > 0 && y >= near) this.loadMore();
    }
  },
  goBack() {
    router.back();
  }
};</script>
