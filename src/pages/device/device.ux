  </div>
</template>

<style>
  /* band-pro v2.0 BDS-336：主文本 22-26，授权码大字 52（手环 9/10 Pro 336×480） */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
