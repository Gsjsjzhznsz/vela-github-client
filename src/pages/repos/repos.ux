<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <text class="hd-title">{{title}}</text>
    </div>

    <div class="pull" style="height: {{pullY}}px">
      <image class="pull-icon" src="/common/icons/refresh.png" />
      <text class="pull-text">{{pullText}}</text>
    </div>

    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll"
          ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
      <div class="li" for="{{it in items}}" tid="id">
        <div class="cell" onclick="openRepo(it)">
          <div class="ava" style="background-color: {{it.avc}}">
            <text class="ava-t">{{it.avn}}</text>
          </div>
          <div class="cell-main">
            <text class="cell-title">{{it.full}}</text>
            <text class="cell-desc" show="{{!!it.desc}}">{{it.desc}}</text>
            <div class="meta">
              <div class="dot" show="{{!!it.lang}}" style="background-color: {{it.langc}}"></div>
              <text class="meta-t" show="{{!!it.lang}}">{{it.lang}}</text>
              <image class="meta-ic" src="/common/icons/star.png" />
              <text class="meta-t">{{it.stars}}</text>
              <image class="meta-ic" src="/common/icons/clock.png" />
              <text class="meta-t">{{it.updated}}</text>
            </div>
          </div>
        </div>
      </div>
      <div class="li" show="{{state === 'ok' && loadingMore}}">
        <text class="foot" onclick="loadMore">加载更多</text>
      </div>
      <div class="li" show="{{state === 'ok' && !hasMore && items.length > 0}}">
        <text class="foot">— 到底了 —</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">{{emptyText}}</text>
      <text class="state-btn" onclick="doRefresh">重新加载</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doRefresh">点此重试</text>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 44px; height: 44px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 64px; height: 64px; align-items: center; justify-content: center; margin-left: -10px; }
  .hd-title { font-size: 24px; font-weight: bold; color: #e6edf3; margin-left: 7px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .pull { flex-direction: row; align-items: center; justify-content: center; overflow: hidden; }
  .pull-icon { width: 17px; height: 17px; }
  .pull-text { font-size: 20px; color: #8b949e; margin-left: 7px; }
  /* RW5 固件根修：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 60px; }
  .li { padding: 4px 12px; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 12px; padding: 11px 12px; }
  .ava { width: 36px; height: 36px; border-radius: 18px; justify-content: center; align-items: center; }
  .ava-t { font-size: 22px; color: #ffffff; font-weight: bold; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 10px; }
  .cell-title { font-size: 22px; color: #58a6ff; font-weight: bold; lines: 1; text-overflow: ellipsis; }
  .cell-desc { font-size: 19px; color: #8b949e; margin-top: 2px; lines: 2; text-overflow: ellipsis; }
  .meta { flex-direction: row; align-items: center; margin-top: 5px; }
  .dot { width: 10px; height: 10px; border-radius: 5px; margin-right: 4px; }
  .meta-ic { width: 13px; height: 13px; margin-left: 10px; margin-right: 2px; }
  .meta-t { font-size: 20px; color: #8b949e; }
  .foot { font-size: 20px; color: #484f58; text-align: center; width: 100%; padding: 7px 0; }
  .state { position: absolute; left: 0; top: 94px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 22px; color: #8b949e; text-align: center; padding: 0 29px; }
  .state-btn { font-size: 21px; color: #58a6ff; margin-top: 12px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/gh' /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
  import { mapRepo } from '../../utils/view'
  import { query } from '../../utils/view'

  export default {
    protected: {
      user: ''
    },
    private: {
      title: '我的仓库',
      items: [],
      state: 'loading',
      errMsg: '',
      emptyText: '没有仓库',
      page: 1,
      hasMore: true,
      loadingMore: false,
      refreshing: false,
      scY: 0,
      tY: 0,
      pullY: 0,
      pullText: '下拉刷新'
    },
    async onInit(params) {
      const p = query(params, this)
      if (p.user) {
        this.user = p.user
        this.title = this.user + ' 的仓库'
      } else {
        await api.loadToken()
        if (!api.hasToken()) {
          this.state = 'empty'
          this.emptyText = '仓库列表需登录：请到首页 → 设置填入 Token'
          return
        }
      }
      this.reload()
    },
    async fetchPage(page) {
      if (this.user) return api.getUserRepos(this.user, page)
      return api.getMyRepos(page, 'pushed')
    },
    async reload() {
      this.state = 'loading'
      try {
        const list = await this.fetchPage(1)
        if (!Array.isArray(list)) {
          throw { message: '仓库列表响应不完整，请重试' }
        }
        this.items = list.map(mapRepo)
        this.page = 1
        this.hasMore = list.length >= api.lastListPerPage()
        this.state = this.items.length === 0 ? 'empty' : 'ok'
        this.emptyText = this.user ? '该用户暂无公开仓库' : '还没有仓库'
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '加载失败'
      }
    },
    async loadMore() {
      if (!this.hasMore || this.loadingMore || this.state !== 'ok') return
      this.loadingMore = true
      try {
        const next = this.page + 1
        const list = await this.fetchPage(next)
        for (let i = 0; i < list.length; i++) this.items.push(mapRepo(list[i]))
        this.page = next
        this.hasMore = list.length >= api.lastListPerPage()
      } catch (e) {
        prompt.showToast({ message: '加载失败：' + ((e && e.message) || ''), duration: 1500 })
      }
      this.loadingMore = false
    },
    openRepo(item) {
      if (!item) return
      this.$app.$def.hook = { full: item.full }
      router.push({ uri: 'pages/repo' })
    },
    doRefresh() {
      if (this.refreshing) return
      this.refreshing = true
      this.pullY = 60
      this.pullText = '刷新中…'
      this.reload().then(() => {
        this.refreshing = false
        this.pullY = 0
      })
    },
    onListScroll(e) {
      this.scY = (e && e.scrollY) || 0
      // 触底自动加载（scroll 组件无 scrollbottom，用 scrollY 估算）
      if (this.state === 'ok' && this.hasMore && !this.loadingMore) {
        const near = this.items.length * 110 - 420
        if (near > 0 && this.scY >= near) this.loadMore()
      }
    },
    onTouchStart(e) {
      if (this.scY <= 0 && !this.refreshing) {
        const t = e && e.touches && e.touches[0]
        this.tY = (t && (t.pageY || t.clientY)) || 0
      }
    },
    onTouchMove(e) {
      if (this.refreshing || this.tY <= 0 || this.scY > 0) return
      const t = e && e.touches && e.touches[0]
      const y = (t && (t.pageY || t.clientY)) || 0
      const delta = y - this.tY
      if (delta > 0) {
        this.pullY = Math.min(112, Math.floor(delta * 0.45))
        this.pullText = this.pullY > 80 ? '松开刷新' : '下拉刷新'
      }
    },
    onTouchEnd() {
      if (this.refreshing) return
      if (this.pullY > 80) this.doRefresh()
      else this.pullY = 0
      this.tY = 0
    },
    goBack() {
      router.back()
    }
  }
</script>
