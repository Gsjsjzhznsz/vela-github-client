<template>
  <div class="page">
    <div class="hd">
      <image class="hd-act" src="/common/icons/back.png" onclick="goBack" />
      <text class="hd-title">设置</text>
    </div>

    <!-- BandQQ v2.9.6 同构：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
    <scroll class="body" scroll-y="true">
      <div class="wrap">
        <!-- 账户状态 -->
        <div class="card">
          <text class="c-title">GitHub 账户</text>
          <text class="c-row">{{hasTk ? '已登录 · ' + tokenMask : '游客模式（公开数据，限流 60 次/小时）'}}</text>
          <text class="c-row2">API 余量 {{rateText}}</text>
        </div>

        <!-- Token 操作 -->
        <div class="cell" onclick="startInput">
          <image class="cell-icon" src="/common/icons/gear.png" />
          <text class="cell-label">{{hasTk ? '重新输入 Token' : '输入 Personal Access Token'}}</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <div class="cell" show="{{hasTk}}" onclick="logout">
          <image class="cell-icon" src="/common/icons/back.png" />
          <text class="cell-label warn">退出登录（清除本机 Token）</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <!-- 说明 -->
        <div class="card">
          <text class="c-title">如何获取 Token？</text>
          <text class="c-body">1. 电脑打开 github.com → Settings → Developer settings → Personal access tokens → Tokens (classic)</text>
          <text class="c-body">2. Generate new token，勾选 repo 与 notifications 权限即可</text>
          <text class="c-body">3. 把生成的 ghp_ 开头字符串用键盘输入到本机（仅需一次）</text>
          <text class="c-body warn">Token 仅保存在手表本地存储，不会上传到任何服务器</text>
        </div>

        <div class="card">
          <text class="c-title">关于</text>
          <text class="c-body">GitHub for Vela v1.0.0</text>
          <text class="c-body">运行于 Xiaomi Vela OS（NuttX），适配 Redmi Watch 5（432×514）方屏，兼容圆屏</text>
          <text class="c-body">网络：经小米运动健康蓝牙代理或 eSIM 独立联网，直连 api.github.com</text>
          <text class="c-body">开源协议：AGPL-3.0 · 参考 BandQQ 键盘组件架构</text>
        </div>
      </div>
    </scroll>
    </div>

  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 94px; flex-direction: row; align-items: center; padding: 0 12px; }
  .hd-act { width: 44px; height: 44px; }
  .hd-title { font-size: 24px; font-weight: bold; color: #e6edf3; margin-left: 7px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .wrap { flex-direction: column; padding: 5px 12px 50px; }
  .card { background-color: #161b22; border-radius: 12px; padding: 12px; margin-bottom: 10px; flex-direction: column; }
  .c-title { font-size: 19px; color: #e6edf3; font-weight: bold; margin-bottom: 5px; }
  .c-row { font-size: 16px; color: #c9d1d9; }
  .c-row2 { font-size: 14px; color: #3fb950; margin-top: 4px; }
  .c-body { font-size: 14px; color: #8b949e; line-height: 18px; margin-top: 2px; }
  .warn { color: #d29922; }
  .cell { flex-direction: row; align-items: center; background-color: #161b22; border-radius: 12px; padding: 13px 12px; margin-bottom: 10px; }
  .cell-icon { width: 22px; height: 22px; }
  .cell-label { flex: 1; font-size: 20px; color: #e6edf3; margin-left: 10px; lines: 1; text-overflow: ellipsis; }
  .cell-arrow { width: 17px; height: 17px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/api'
  import { maskToken } from '../../utils/fmt'

  export default {
    private: {
      hasTk: false,
      tokenMask: '',
      rateText: '…',
    },
    onInit() {
    },
    async onShow() {
      await api.loadToken()
      this.hasTk = api.hasToken()
      this.tokenMask = this.hasTk ? maskToken(api.currentToken()) : ''
      this.refreshRate()
    },
    async refreshRate() {
      try {
        const r = await api.getRateLimit()
        const core = r && r.resources && r.resources.core
        if (core) this.rateText = core.remaining + '/' + core.limit
      } catch (e) {
        this.rateText = '未知'
      }
    },
    /* ---- Token 输入：跳 BandQQ compose 同构输入页（键盘常驻） ---- */
    startInput() {
      this.$app.$def.hook = { type: 'token', initial: '' }
      router.push({ uri: 'pages/input' })
    },
    async logout() {
      await api.clearToken()
      this.hasTk = false
      this.tokenMask = ''
      prompt.showToast({ message: '已退出登录', duration: 1500 })
    },
    goBack() {
      router.back()
    }
  }
</script>
