
<template>
  <div class="page">
    <div class="hd">
      <div class="hd-act-wrap" onclick="goBack"><image class="hd-act" src="/common/icons/back.png" /></div>
      <div class="hd-main">
        <text class="hd-title">{{full}} #{{n}}</text>
        <text class="hd-sub">{{commentN}} 条评论</text>
      </div>
    </div>

    <div class="body-wrap">
      <scroll class="body" scroll-y="true" onscroll="onListScroll">
      <!-- 标题头 -->
      <div class="li">
        <div class="head-card">
          <div class="badge {{open ? 'b-open' : 'b-closed'}}">
            <text class="badge-t">{{isPR ? (open ? 'PR · 开放' : 'PR · 已合并/关闭') : (open ? 'Issue · 开放' : 'Issue · 已关闭')}}</text>
          </div>
          <text class="h-title">{{title}}</text>
          <text class="h-meta">{{author}} · 创建于 {{created}}</text>
          <text class="lb" show="{{labelsText}}" style="color: {{labelColor}}">{{labelsText}}</text>
        </div>
      </div>

      <!-- 正文块：单 text 节点 + 动态 class（固件 elif 不可靠，readme 页同款修复） -->
      <div class="li" for="{{it in bodyBlocks}}" tid="id">
        <text class="b-{{it.t}}" style="height: {{it.h}}px">{{it.s}}</text>
      </div>
      <!-- v1.3.0：三通道降级到 GraphQL 时正文不可达（fetch/下载器均被截断） -->
      <div class="li" show="{{bodyTrunc}}">
        <div class="trunc-card">
          <text class="trunc-t">正文过长，已省略（网络通道受限）</text>
          <text class="trunc-btn" onclick="copyIssueLink">复制网页链接在手机查看</text>
        </div>
      </div>

      <!-- 评论分隔 -->
      <div class="li">
        <text class="sepa-t">—— 评论 ——</text>
      </div>

      <!-- 写评论入口 -->
      <div class="li">
        <div class="cmt-card" onclick="openComposer">
          <text class="compose-label">写评论{{sending ? ' · 发送中…' : ''}}</text>
          <text class="compose-hint">{{canCmt ? '点击用拼音键盘发表评论' : '需登录 Token 后使用'}}</text>
        </div>
      </div>

      <!-- v1.9.0：关闭/重开（作者/协作者权限，403 由 toast 透出） -->
      <div class="li" show="{{canCmt}}">
        <div class="cmt-card" onclick="toggleIssueState">
          <text class="compose-label">{{open ? '关闭此 Issue' : '重新打开此 Issue'}}{{patching ? ' · 操作中…' : ''}}</text>
          <text class="compose-hint">{{open ? '关闭后对话保留，可随时重开' : '重开后对话继续'}}</text>
        </div>
      </div>

      <!-- 评论项 -->
      <div class="li" for="{{it in comments}}" tid="id">
        <div class="cmt-card">
          <div class="cmt-hd">
            <div class="ava" style="background-color: {{it.avc}}">
              <text class="ava-t">{{it.avn}}</text>
            </div>
            <text class="cmt-author">{{it.author}}</text>
            <text class="cmt-time">{{it.time}}</text>
          </div>
          <text class="cmt-body" show="{{it.text}}">{{it.text}}</text>
          <text class="cmt-empty" show="{{!it.text}}">（无正文）</text>
        </div>
      </div>

      <div class="li" show="{{loadingComments}}">
        <text class="foot">加载评论中…</text>
      </div>
      <div class="li" show="{{state === 'ok' && !hasMoreComments && comments.length > 0}}">
        <text class="foot">— 到底了 —</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="reload">点此重试</text>
    </div>

  </div>
</template>

<style>
  /* band v2.0 BDS-192（手环 9/10/11 标准版 192×490 / 212×520）：
   * 块样式与 md.js H_TABLE 严格对齐（336 版 avail=250/290，readme 页同款）：显式 line-height 保证估算确定性 */
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 56px; flex-direction: row; align-items: center; padding: 8px 14px 0; } /* v2.0.3 R角：顶垫8+侧垫14，图标字形离开手环屏幕圆角裁切区 */
  .hd-act { width: 30px; height: 30px; }
  /* 固件 image onclick 不触发：返回图标包一层 div 承接点击 */
  .hd-act-wrap { width: 48px; height: 48px; align-items: center; justify-content: center; margin-left: -6px; }
  .hd-main { flex: 1; flex-direction: column; margin-left: 6px; }
  .hd-title { font-size: 20px; font-weight: bold; color: #e6edf3; lines: 1; text-overflow: ellipsis; }
  .hd-sub { font-size: 14px; color: #484f58; margin-top: 2px; }
  /* 固件根修保留：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 44px; } /* v2.0.3 R角：尾部缓冲 14→44，末张卡片离开底部圆角+手势区 */
  .li { padding: 3px 10px; flex-direction: column; }
  .head-card { background-color: #161b22; border-radius: 12px; padding: 10px; width: 100%; flex-direction: column; }
  .badge { align-self: flex-start; border-radius: 14px; padding: 3px 12px; }
  .b-open { background-color: #238636; }
  .b-closed { background-color: #8957e5; }
  .badge-t { font-size: 16px; color: #ffffff; }
  .h-title { font-size: 19px; color: #e6edf3; font-weight: bold; margin-top: 8px; lines: 3; text-overflow: ellipsis; }
  .h-meta { font-size: 16px; color: #8b949e; margin-top: 6px; }
  .labels { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
  .lb { font-size: 14px; margin-right: 8px; border: 1px solid #30363d; border-radius: 12px; padding: 2px 10px; }
  .b-h { font-size: 20px; line-height: 26px; color: #58a6ff; font-weight: bold; margin-top: 6px; }
  .b-p { font-size: 17px; line-height: 23px; color: #e6edf3; }
  .b-c { font-size: 16px; line-height: 21px; color: #a5d6ff; background-color: #161b22; border-left: 3px solid #30363d; padding: 10px 12px; margin: 4px 0; }
  .b-q { font-size: 17px; line-height: 23px; color: #8b949e; border-left: 3px solid #30363d; padding-left: 12px; }
  .b-l { font-size: 17px; line-height: 23px; color: #e6edf3; }
  .b-r { font-size: 14px; line-height: 19px; color: #30363d; text-align: center; }
  .sepa-t { font-size: 16px; color: #484f58; text-align: center; width: 100%; padding: 9px 0; }
  .cmt-card { background-color: #161b22; border-radius: 12px; padding: 10px; width: 100%; flex-direction: column; }
  .cmt-hd { flex-direction: row; align-items: center; }
  .ava { width: 30px; height: 30px; border-radius: 15px; justify-content: center; align-items: center; }
  .ava-t { font-size: 17px; color: #ffffff; font-weight: bold; }
  .cmt-author { font-size: 17px; color: #58a6ff; margin-left: 9px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .cmt-time { font-size: 14px; color: #484f58; }
  .cmt-body { font-size: 17px; color: #c9d1d9; line-height: 23px; margin-top: 8px; }
  .cmt-empty { font-size: 14px; color: #484f58; margin-top: 6px; }
  .foot { font-size: 14px; color: #484f58; text-align: center; width: 100%; padding: 8px 0; }
  .state { position: absolute; left: 0; top: 56px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 20px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-btn { font-size: 18px; color: #58a6ff; margin-top: 16px; padding: 12px 22px; background-color: #16233a; border-radius: 16px; }
  .compose-label { font-size: 17px; color: #58a6ff; font-weight: bold; }
  .compose-hint { font-size: 16px; color: #484f58; margin-top: 5px; }
  .trunc-card { background-color: #302018; border-radius: 12px; padding: 10px; width: 100%; flex-direction: column; }
  .trunc-t { font-size: 17px; color: #d29922; }
  .trunc-btn { font-size: 17px; color: #58a6ff; margin-top: 8px; }
</style>

<script>import router from '@system.router';
import api from '../../utils/gh'; /* v1.8.0 全局桥（api.js 只随 app.js 打包一次） */
import { mdToBlocks } from '../../utils/md';
import { relTime, truncate, avatar } from '../../utils/fmt';
import { mapIssue } from '../../utils/view';
import { query } from '../../utils/view';
function _catch(body, recover) {
  try {
    var result = body();
  } catch (e) {
    return recover(e);
  }
  if (result && result.then) {
    return result.then(void 0, recover);
  }
  return result;
}
export default {
  protected: {
    full: '',
    n: ''
  },
  private: {
    title: '',
    open: true,
    isPR: false,
    author: '',
    created: '',
    labelsText: '',
    labelColor: '#8b949e',
    commentN: 0,
    bodyBlocks: [],
    bodyTrunc: false,
    comments: [],
    state: 'loading',
    errMsg: '',
    loadingComments: false,
    hasMoreComments: false,
    sending: false,
    canCmt: false,
    patching: false
  },
  onInit(params) {
    const p = query(params, this);
    if (p.full) this.full = p.full;
    if (p.n) this.n = String(p.n);
  },
  onShow() {
    // 消费独立输入页回传的评论草稿
    const app = this.$app.$def;
    const r = app && app.inputResult;
    if (r && r.type === 'comment' && r.text) {
      app.inputResult = null;
      this.sendComment(r.text);
    }
    this.canCmt = api.hasToken();
    if (this.full && this.n && this.state !== 'ok') this.reload();
  },
  reload: function () {
    try {
      const _this = this;
      _this.state = 'loading';
      return Promise.resolve(_catch(function () {
        return Promise.resolve(api.getIssue(_this.full, _this.n)).then(function (iss) {
          if (!iss || typeof iss !== 'object') {
            throw {
              message: 'Issue 响应不完整，请重试'
            };
          }
          const m = mapIssue(iss);
          _this.title = m.title;
          _this.open = m.open;
          _this.isPR = !!iss.pull_request;
          _this.author = m.author;
          _this.created = m.time;
          _this.labelsText = (iss.labels || []).map(l => l.name).join(' · ');
          _this.labelColor = iss.labels && iss.labels[0] && iss.labels[0].color ? '#' + iss.labels[0].color : '#8b949e';
          _this.commentN = iss.comments || 0;
          _this.canCmt = api.hasToken();
          const body = mdToBlocks(iss.body || '');
          const blocks = [];
          for (let i = 0; i < body.length && i < 80; i++) {
            // h 必须随块传给模板（同 readme 页根因修复）
            blocks.push({
              id: 'b' + i,
              t: body[i].t,
              s: body[i].s,
              h: body[i].h
            });
          }
          _this.bodyBlocks = blocks;
          // v1.3.0：三级通道降级到 GraphQL（无 body）时显示省略提示
          _this.bodyTrunc = !!iss.__bodyTruncated;
          _this._issueUrl = 'https://github.com/' + _this.full + '/' + (iss.pull_request ? 'pull/' : 'issues/') + _this.n;
          _this._cmtsUrl = iss.comments_url || '';
          _this.comments = [];
          _this._cPage = 0;
          _this.hasMoreComments = _this.commentN > 0;
          _this.state = 'ok';
          _this.loadMoreComments();
        });
      }, function (e) {
        _this.state = 'error';
        _this.errMsg = e && e.message || '加载失败';
      }));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  onListScroll(e) {
    const y = e && e.scrollY || 0;
    this._sy = y;
    if (this.state === 'ok' && this.hasMoreComments && !this.loadingComments) {
      const near = this.bodyBlocks.length * 52 + this.comments.length * 115 - 340;
      if (near > 0 && y >= near) this.loadMoreComments();
    }
  },
  loadMoreComments: function () {
    try {
      const _this2 = this;
      function _temp2() {
        _this2.loadingComments = false;
      }
      if (_this2.state !== 'ok' || _this2.loadingComments || !_this2.hasMoreComments) return Promise.resolve();
      _this2.loadingComments = true;
      const _temp = _catch(function () {
        const next = _this2._cPage + 1;
        return Promise.resolve(api.getComments(_this2._cmtsUrl, next)).then(function (list) {
          for (let i = 0; i < list.length; i++) {
            const c = list[i];
            const av = avatar(c.user ? c.user.login : '?');
            _this2.comments.push({
              id: String(c.id),
              author: c.user ? c.user.login : '未知',
              time: relTime(c.created_at),
              text: truncate((c.body || '').replace(/\r/g, ''), 500),
              avn: av.ch,
              avc: av.color
            });
          }
          _this2._cPage = next;
          _this2.hasMoreComments = list.length >= api.lastListPerPage();
        });
      }, function () {});
      return Promise.resolve(_temp && _temp.then ? _temp.then(_temp2) : _temp2(_temp));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  onDestroy() {
    this.bodyBlocks = [];
    this.comments = [];
  },
  /* ---- 评论发表（T9 拼音键盘） ---- */
  /* 写评论：跳 BandQQ compose 同构输入页（键盘常驻），onShow 消费草稿并发送 */
  /** v1.9.0：关闭/重开 Issue（PATCH state；PR 同样适用） */
  toggleIssueState: function () {
    try {
      const _this3 = this;
      function _temp4() {
        _this3.patching = false;
      }
      if (!_this3.canCmt || _this3.patching) return Promise.resolve();
      _this3.patching = true;
      const _temp3 = _catch(function () {
        const target = _this3.open ? 'closed' : 'open';
        return Promise.resolve(api.patchIssueState(_this3.full, _this3.n, target)).then(function () {
          _this3.open = target === 'open';
          prompt.showToast({
            message: _this3.open ? '已重新打开' : '已关闭',
            duration: 1500
          });
        });
      }, function (e) {
        prompt.showToast({
          message: e && e.message || '操作失败',
          duration: 2000
        });
      });
      return Promise.resolve(_temp3 && _temp3.then ? _temp3.then(_temp4) : _temp4(_temp3));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  openComposer() {
    if (!api.hasToken()) {
      prompt.showToast({
        message: '发表评论需登录 Token（设置页）',
        duration: 2000
      });
      return;
    }
    this.$app.$def.hook = {
      type: 'comment',
      initial: ''
    };
    router.push({
      uri: 'pages/input'
    });
  },
  sendComment: function (body) {
    try {
      const _this4 = this;
      function _temp6() {
        _this4.sending = false;
      }
      if (!body) return Promise.resolve();
      if (!_this4._cmtsUrl || _this4.sending) return Promise.resolve();
      _this4.sending = true;
      const _temp5 = _catch(function () {
        return Promise.resolve(api.addComment(_this4._cmtsUrl, body)).then(function (c) {
          const av = avatar(c.user ? c.user.login : '?');
          _this4.comments.push({
            id: String(c.id),
            author: c.user ? c.user.login : '我',
            time: '刚刚',
            text: truncate((c.body || '').replace(/\r/g, ''), 500),
            avn: av.ch,
            avc: av.color
          });
          _this4.commentN += 1;
          prompt.showToast({
            message: '评论已发表',
            duration: 1500
          });
        });
      }, function (e) {
        prompt.showToast({
          message: '发表失败：' + (e && e.message || ''),
          duration: 2000
        });
      });
      return Promise.resolve(_temp5 && _temp5.then ? _temp5.then(_temp6) : _temp6(_temp5));
    } catch (e) {
      return Promise.reject(e);
    }
  },
  goBack() {
    router.back();
  },
  /* v1.3.0：正文省略时引导手机浏览器（快应用无剪贴板 API，用分享型 toast 展示链接） */
  copyIssueLink() {
    prompt.showToast({
      message: this._issueUrl || '',
      duration: 4000
    });
  }
};</script>
