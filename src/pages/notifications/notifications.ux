<template>
  <div class="page">
    <div class="hd">
      <image class="hd-act" src="/common/icons/back.png" onclick="goBack" />
      <text class="hd-title">通知{{unreadN > 0 ? ' (' + unreadN + ')' : ''}}</text>
      <text class="hd-filter" onclick="toggleAll">{{all ? '全部' : '未读'}}</text>
      <image class="hd-act" src="/common/icons/check.png" onclick="markAllRead" />
    </div>

    <div class="pull" style="height: {{pullY}}px">
      <image class="pull-icon" src="/common/icons/refresh.png" />
      <text class="pull-text">{{pullText}}</text>
    </div>

    <list class="body" onscrollbottom="loadMore" onscroll="onListScroll"
          ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
      <list-item type="ntf" class="li" for="{{items}}" tid="id">
        <div class="cell" onclick="openNotif($item)">
          <div class="unread" show="{{$item.unread}}"></div>
          <image class="cell-icon" src="{{$item.icon}}" />
          <div class="cell-main">
            <text class="cell-repo">{{$item.repo}}</text>
            <text class="cell-title">{{$item.title}}</text>
            <text class="cell-time">{{$item.time}}</text>
          </div>
        </div>
      </list-item>
      <list-item type="foot" class="li" if="{{state === 'ok' && loadingMore}}">
        <text class="foot">加载中…</text>
      </list-item>
      <list-item type="foot" class="li" if="{{state === 'ok' && !hasMore && items.length > 0}}">
        <text class="foot">— 到底了 —</text>
      </list-item>
    </list>

    <div class="state" if="{{state === 'loading'}}">
      <text class="state-t">加载中…</text>
    </div>
    <div class="state" if="{{state === 'empty'}}">
      <text class="state-t">{{emptyText}}</text>
      <text class="state-btn" onclick="doRefresh">重新加载</text>
    </div>
    <div class="state" if="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doRefresh">点此重试</text>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 40px; flex-direction: row; align-items: center; padding: 0 10px; }
  .hd-act { width: 20px; height: 20px; }
  .hd-title { font-size: 16px; font-weight: bold; color: #e6edf3; margin-left: 6px; flex: 1; lines: 1; text-overflow: ellipsis; }
  .hd-filter { font-size: 11px; color: #58a6ff; margin-right: 10px; }
  .pull { flex-direction: row; align-items: center; justify-content: center; overflow: hidden; }
  .pull-icon { width: 14px; height: 14px; }
  .pull-text { font-size: 10px; color: #8b949e; margin-left: 6px; }
  .body { flex: 1; }
  .li { padding: 3px 10px; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 10px; padding: 9px 10px; }
  .unread { position: absolute; left: 2px; top: 2px; width: 6px; height: 6px; border-radius: 3px; background-color: #3fb950; }
  .cell-icon { width: 18px; height: 18px; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 8px; }
  .cell-repo { font-size: 10px; color: #8b949e; lines: 1; text-overflow: ellipsis; }
  .cell-title { font-size: 13px; color: #e6edf3; margin-top: 2px; lines: 2; text-overflow: ellipsis; }
  .cell-time { font-size: 9px; color: #484f58; margin-top: 2px; }
  .foot { font-size: 10px; color: #484f58; text-align: center; width: 100%; padding: 6px 0; }
  .state { position: absolute; left: 0; top: 40px; right: 0; bottom: 0; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 13px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-btn { font-size: 12px; color: #58a6ff; margin-top: 10px; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/api'
  import { mapNotif } from '../../utils/view'

  export default {
    private: {
      items: [],
      all: false,
      state: 'loading',   // loading | ok | empty | error
      errMsg: '',
      emptyText: '暂无通知',
      page: 1,
      hasMore: true,
      loadingMore: false,
      refreshing: false,
      scY: 0,
      tY: 0,
      pullY: 0,
      pullText: '下拉刷新',
      unreadN: 0
    },
    onInit() {},
    async onShow() {
      await api.loadToken()
      if (!api.hasToken()) {
        this.state = 'empty'
        this.emptyText = '通知需登录：请到首页 → 设置填入 Token'
        return
      }
      if (this.items.length === 0) this.reload()
    },
    async reload() {
      this.state = 'loading'
      try {
        const list = await api.getNotifications(1, this.all)
        const mapped = list.map(mapNotif)
        this.items = mapped
        this.page = 1
        this.hasMore = list.length >= 10
        this.state = this.items.length === 0 ? 'empty' : 'ok'
        this.emptyText = this.all ? '没有通知' : '没有未读通知'
        this.countUnread()
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '加载失败'
      }
    },
    countUnread() {
      let n = 0
      for (let i = 0; i < this.items.length; i++) {
        if (this.items[i].unread) n++
      }
      this.unreadN = n
    },
    async loadMore() {
      if (!this.hasMore || this.loadingMore || this.state !== 'ok') return
      this.loadingMore = true
      try {
        const next = this.page + 1
        const list = await api.getNotifications(next, this.all)
        for (let i = 0; i < list.length; i++) this.items.push(mapNotif(list[i]))
        this.page = next
        this.hasMore = list.length >= 10
        this.countUnread()
      } catch (e) {
        prompt.showToast({ message: '加载失败：' + ((e && e.message) || ''), duration: 1500 })
      }
      this.loadingMore = false
    },
    toggleAll() {
      this.all = !this.all
      this.reload()
    },
    async markAllRead() {
      try {
        await api.markAllNotificationsRead()
        for (let i = 0; i < this.items.length; i++) this.items[i].unread = false
        this.countUnread()
        prompt.showToast({ message: '已全部标记已读', duration: 1500 })
      } catch (e) {
        prompt.showToast({ message: (e && e.message) || '操作失败', duration: 2000 })
      }
    },
    async openNotif(item) {
      if (!item) return
      if (item.unread) {
        item.unread = false
        this.countUnread()
        api.markThreadRead(item.threadUrl).catch(function () {})
      }
      if ((item.icon === '/common/icons/issue.png' || item.icon === '/common/icons/pull.png') && item.url) {
        const n = item.url.split('/').pop()
        router.push({ uri: '/pages/issue', params: { full: item.repo, n: n } })
      } else {
        router.push({ uri: '/pages/repo', params: { full: item.repo } })
      }
    },
    /* ---- 下拉刷新（list 自定义手势） ---- */
    doRefresh() {
      if (this.refreshing) return
      this.refreshing = true
      this.pullY = 30
      this.pullText = '刷新中…'
      this.reload().then(() => {
        this.refreshing = false
        this.pullY = 0
      })
    },
    onListScroll(e) {
      this.scY = (e && e.scrollY) || 0
    },
    onTouchStart(e) {
      if (this.scY <= 0 && !this.refreshing) {
        const t = e && e.touches && e.touches[0]
        this.tY = (t && (t.pageY || t.clientY)) || 0
      }
    },
    onTouchMove(e) {
      if (this.refreshing || this.tY <= 0 || this.scY > 0) return
      const t = e && e.touches && e.touches[0]
      const y = (t && (t.pageY || t.clientY)) || 0
      const delta = y - this.tY
      if (delta > 0) {
        this.pullY = Math.min(56, Math.floor(delta * 0.45))
        this.pullText = this.pullY > 40 ? '松开刷新' : '下拉刷新'
      }
    },
    onTouchEnd() {
      if (this.refreshing) return
      if (this.pullY > 40) {
        this.doRefresh()
      } else {
        this.pullY = 0
      }
      this.tY = 0
    },
    goBack() {
      router.back()
    }
  }
</script>
