<template>
  <div class="page">
    <div class="hd">
      <image class="hd-act" src="/common/icons/back.png" onclick="goBack" />
      <text class="hd-title">搜索仓库</text>
      <image class="hd-act" src="/common/icons/refresh.png" onclick="doRefresh" />
    </div>

    <div class="srow">
      <div class="sbox" onclick="showKb">
        <text class="stext {{query ? '' : 'ph'}}">{{query ? kbTail : '输入关键词…'}}</text>
      </div>
      <text class="sbtn" onclick="doSearch">搜索</text>
    </div>

    <!-- RW5 固件根修（BandQQ v2.9.6 同构）：wrap flex:1 + scroll absolute 铺满 -->
    <div class="body-wrap">
      <scroll class="body {{kbShow ? 'shrink' : ''}}" scroll-y="true" onscroll="onListScroll">
      <div class="li" for="{{it in items}}" tid="id">
        <div class="cell" onclick="openRepo(it)">
          <div class="ava" style="background-color: {{it.avc}}">
            <text class="ava-t">{{it.avn}}</text>
          </div>
          <div class="cell-main">
            <text class="cell-title">{{it.full}}</text>
            <text class="cell-desc" show="{{!!it.desc}}">{{it.desc}}</text>
            <div class="meta">
              <div class="dot" show="{{!!it.lang}}" style="background-color: {{it.langc}}"></div>
              <text class="meta-t" show="{{!!it.lang}}">{{it.lang}}</text>
              <image class="meta-ic" src="/common/icons/star.png" />
              <text class="meta-t">{{it.stars}}</text>
            </div>
          </div>
        </div>
      </div>
      <div class="li" show="{{state === 'ok' && !hasMore && items.length > 0}}">
        <text class="foot">共 {{total}} 个结果 · 到底了</text>
      </div>
    </scroll>
    </div>

    <div class="state" show="{{state === 'loading'}}">
      <text class="state-t">搜索中…</text>
    </div>
    <div class="state" show="{{state === 'empty'}}">
      <text class="state-t">{{emptyText}}</text>
    </div>
    <div class="state" show="{{state === 'error'}}">
      <text class="state-t">{{errMsg}}</text>
      <text class="state-btn" onclick="doSearch">重试</text>
    </div>

    <!-- 内联键盘（组件在此固件不渲染，改页面内联；数据由 utils/kb.js 提供） -->
    <div class="kb-dock" show="{{kbShow}}">
      <div class="kb-root">
        <div class="kb-pad">
          <div class="kb-row">
            <div class="kb-key" for="{{it in row0}}" onclick="onKey(it)" style="{{it.st}}">
              <text class="kb-key-text">{{it.label}}</text>
            </div>
          </div>
          <div class="kb-row">
            <div class="kb-key" for="{{it in row1}}" onclick="onKey(it)" style="{{it.st}}">
              <text class="kb-key-text">{{it.label}}</text>
            </div>
          </div>
          <div class="kb-row">
            <div class="kb-key" for="{{it in row2}}" onclick="onKey(it)" style="{{it.st}}">
              <text class="kb-key-text">{{it.label}}</text>
            </div>
          </div>
          <div class="kb-row">
            <div class="kb-key" for="{{it in row3}}" onclick="onKey(it)" style="{{it.st}}">
              <text class="kb-key-text">{{it.label}}</text>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 40px; flex-direction: row; align-items: center; padding: 0 10px; }
  .hd-act { width: 20px; height: 20px; }
  .hd-title { font-size: 16px; font-weight: bold; color: #e6edf3; margin-left: 6px; flex: 1; }
  .srow { flex-direction: row; align-items: center; padding: 2px 10px 6px; }
  .sbox { flex: 1; height: 30px; background-color: #161b22; border: 1px solid #30363d; border-radius: 15px; justify-content: center; padding: 0 10px; }
  .stext { font-size: 12px; color: #e6edf3; lines: 1; text-overflow: ellipsis; }
  .ph { color: #484f58; }
  .sbtn { font-size: 12px; color: #ffffff; background-color: #238636; border-radius: 15px; padding: 7px 12px; margin-left: 8px; }
  /* RW5 固件根修：wrap flex:1 + scroll absolute 铺满（BandQQ v2.9.6 同构） */
  .body-wrap { position: relative; flex: 1; flex-direction: column; }
  .body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; }
  .pad-end { width: 100%; height: 14px; }
  .shrink { height: calc(100% - 152px); }
  .li { padding: 3px 10px; }
  .cell { flex-direction: row; align-items: center; width: 100%; background-color: #161b22; border-radius: 10px; padding: 9px 10px; }
  .ava { width: 30px; height: 30px; border-radius: 15px; justify-content: center; align-items: center; }
  .ava-t { font-size: 13px; color: #ffffff; font-weight: bold; }
  .cell-main { flex: 1; flex-direction: column; margin-left: 8px; }
  .cell-title { font-size: 14px; color: #58a6ff; font-weight: bold; lines: 1; text-overflow: ellipsis; }
  .cell-desc { font-size: 11px; color: #8b949e; margin-top: 2px; lines: 2; text-overflow: ellipsis; }
  .meta { flex-direction: row; align-items: center; margin-top: 4px; }
  .dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 3px; }
  .meta-ic { width: 11px; height: 11px; margin-left: 8px; margin-right: 2px; }
  .meta-t { font-size: 10px; color: #8b949e; }
  .foot { font-size: 10px; color: #484f58; text-align: center; width: 100%; padding: 6px 0; }
  .state { position: absolute; left: 0; top: 78px; right: 0; bottom: 40px; flex-direction: column; align-items: center; justify-content: center; }
  .state-t { font-size: 13px; color: #8b949e; text-align: center; padding: 0 24px; }
  .state-btn { font-size: 12px; color: #58a6ff; margin-top: 10px; }
  .kb-dock { position: absolute; left: 0; bottom: 0; width: 100%; height: 152px; }
  @media (shape: rect) {
    .kb-dock { bottom: auto; top: 93px; }
  }
  .kb-hide { display: none; }
  .kb-root { width: 100%; height: 152px; background-color: #161b22; border-top: 1px solid #30363d; flex-direction: column; }
  .kb-pad { flex-direction: column; justify-content: flex-start; width: 100%; height: 150px; padding: 3px 6px; }
  .kb-row { flex-direction: row; height: 33px; margin-bottom: 3px; width: 100%; }
  .kb-key { flex: 1; height: 33px; margin: 0 2px; justify-content: center; align-items: center; background-color: #21262d; border-radius: 4px; }
  .kb-key-text { font-size: 13px; color: #e6edf3; text-align: center; lines: 1; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/api'
  import { mapRepo } from '../../utils/view'

  import { buildRows, applyRows } from '../../utils/kb'

  export default {
    private: {
      query: '',
      kbTail: '',
      kbShow: false,
      row0: [],
      row1: [],
      row2: [],
      row3: [],
      kbMode: 'abc',
      kbShift: false,
      items: [],
      state: 'empty',   // empty | loading | ok | error
      errMsg: '',
      emptyText: '输入关键词开始搜索',
      total: 0,
      page: 1,
      hasMore: true,
      loadingMore: false,
      searched: false
    },
    onInit() {
      this.refreshRows()
    },
    showKb() {
      this.kbShow = true
    },
    refreshRows() {
      const next = buildRows(this.kbMode, this.kbShift)
      if (!this.row0.length) {
        this.row0 = next[0]; this.row1 = next[1]; this.row2 = next[2]; this.row3 = next[3]
        return
      }
      applyRows([this.row0, this.row1, this.row2, this.row3], next)
    },
    onKey(it) {
      if (!it || !it.act) return
      const act = it.act
      if (act === 'char') {
        if (this.query.length < 64) {
          this.query += this.kbShift ? String(it.ch).toUpperCase() : it.ch
        }
        if (this.kbShift && this.kbMode === 'abc') {
          this.kbShift = false
          this.refreshRows()
        }
      } else if (act === 'del') {
        this.query = this.query.slice(0, -1)
      } else if (act === 'space') {
        if (this.query.length < 64) this.query += ' '
      } else if (act === 'ok') {
        this.kbShow = false
        this.onKbOk()
        return
      } else if (act === 'mode') {
        this.kbMode = this.kbMode === 'abc' ? '123' : 'abc'
        this.kbShift = false
        this.refreshRows()
      } else if (act === 'shift') {
        if (this.kbMode === 'abc') {
          this.kbShift = !this.kbShift
          this.refreshRows()
        }
      }
      this.syncTail()
    },
    onKbOk() {
      this.kbShow = false
      if (this.query.trim()) this.doSearch()
    },
    syncTail() {
      const q = this.query
      this.kbTail = q.length > 20 ? '…' + q.slice(-19) : q
    },
    async doSearch() {
      const kw = this.query.trim()
      if (!kw) {
        prompt.showToast({ message: '请先输入关键词', duration: 1500 })
        return
      }
      this.kbShow = false
      this.state = 'loading'
      this.searched = true
      try {
        const r = await api.searchRepos(kw, 1, 'best match')
        const list = (r && r.items) || []
        this.total = (r && r.total_count) || list.length
        this.items = list.map(mapRepo)
        this.page = 1
        this.hasMore = list.length >= 10
        this.state = this.items.length === 0 ? 'empty' : 'ok'
        this.emptyText = '没有找到相关仓库'
      } catch (e) {
        this.state = 'error'
        this.errMsg = (e && e.message) || '搜索失败'
      }
    },
    onListScroll(e) {
      const y = (e && e.scrollY) || 0
      // 触底自动加载（scrollY 估算：单项约 84px）
      if (this.state === 'ok' && this.hasMore && !this.loadingMore) {
        const near = this.items.length * 84 - 340
        if (near > 0 && y >= near) this.loadMore()
      }
    },

    async loadMore() {
      if (!this.searched || !this.hasMore || this.loadingMore || this.state !== 'ok') return
      this.loadingMore = true
      try {
        const next = this.page + 1
        const r = await api.searchRepos(this.query.trim(), next, 'best match')
        const list = (r && r.items) || []
        for (let i = 0; i < list.length; i++) this.items.push(mapRepo(list[i]))
        this.page = next
        this.hasMore = list.length >= 10
      } catch (e) {
        prompt.showToast({ message: '加载失败：' + ((e && e.message) || ''), duration: 1500 })
      }
      this.loadingMore = false
    },
    openRepo(item) {
      if (!item) return
      router.push({ uri: 'pages/repo', params: { full: item.full } })
    },
    doRefresh() {
      if (this.query.trim()) this.doSearch()
    },
    goBack() {
      router.back()
    }
  }
</script>
