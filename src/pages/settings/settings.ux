<template>
  <div class="page">
    <div class="hd">
      <image class="hd-act" src="/common/icons/back.png" onclick="goBack" />
      <text class="hd-title">设置</text>
      <image class="hd-act" src="/common/icons/refresh.png" onclick="refreshRate" />
    </div>

    <scroll class="body {{kbShow ? 'shrink' : ''}}" scroll-y="true">
      <div class="wrap">
        <!-- 账户状态 -->
        <div class="card">
          <text class="c-title">GitHub 账户</text>
          <text class="c-row">{{hasTk ? '已登录 · ' + tokenMask : '游客模式（公开数据，限流 60 次/小时）'}}</text>
          <text class="c-row2">API 余量 {{rateText}}</text>
        </div>

        <!-- Token 操作 -->
        <div class="cell" onclick="startInput">
          <image class="cell-icon" src="/common/icons/gear.png" />
          <text class="cell-label">{{hasTk ? '重新输入 Token' : '输入 Personal Access Token'}}</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <div class="input-card" show="{{inputing}}">
          <text class="c-title">Token 输入</text>
          <text class="tk-preview">{{kbTail || '使用下方键盘输入…'}}</text>
          <div class="tk-btns">
            <text class="tk-btn tk-cancel" onclick="cancelInput">取消</text>
            <text class="tk-btn tk-del" onclick="clearInput">清空</text>
            <text class="tk-btn tk-save" onclick="saveInput">保存</text>
          </div>
        </div>

        <div class="cell" show="{{hasTk}}" onclick="logout">
          <image class="cell-icon" src="/common/icons/back.png" />
          <text class="cell-label warn">退出登录（清除本机 Token）</text>
          <image class="cell-arrow" src="/common/icons/chevron.png" />
        </div>

        <!-- 说明 -->
        <div class="card">
          <text class="c-title">如何获取 Token？</text>
          <text class="c-body">1. 电脑打开 github.com → Settings → Developer settings → Personal access tokens → Tokens (classic)</text>
          <text class="c-body">2. Generate new token，勾选 repo 与 notifications 权限即可</text>
          <text class="c-body">3. 把生成的 ghp_ 开头字符串用键盘输入到本机（仅需一次）</text>
          <text class="c-body warn">Token 仅保存在手表本地存储，不会上传到任何服务器</text>
        </div>

        <div class="card">
          <text class="c-title">关于</text>
          <text class="c-body">GitHub for Vela v1.0.0</text>
          <text class="c-body">运行于 Xiaomi Vela OS（NuttX），适配 Redmi Watch 5（432×514）方屏，兼容圆屏</text>
          <text class="c-body">网络：经小米运动健康蓝牙代理或 eSIM 独立联网，直连 api.github.com</text>
          <text class="c-body">开源协议：AGPL-3.0 · 参考 BandQQ 键盘组件架构</text>
        </div>
      </div>
    </scroll>

    <!-- 内联键盘（组件在此固件不渲染，改页面内联；数据由 utils/kb.js 提供） -->
    <div class="kb-dock" show="{{kbShow}}">
      <div class="kb-root">
        <div class="kb-pad">
          <div class="kb-row">
            <div class="kb-key" for="{{it in row0}}" onclick="onKey(it)" style="{{it.st}}">
              <text class="kb-key-text">{{it.label}}</text>
            </div>
          </div>
          <div class="kb-row">
            <div class="kb-key" for="{{it in row1}}" onclick="onKey(it)" style="{{it.st}}">
              <text class="kb-key-text">{{it.label}}</text>
            </div>
          </div>
          <div class="kb-row">
            <div class="kb-key" for="{{it in row2}}" onclick="onKey(it)" style="{{it.st}}">
              <text class="kb-key-text">{{it.label}}</text>
            </div>
          </div>
          <div class="kb-row">
            <div class="kb-key" for="{{it in row3}}" onclick="onKey(it)" style="{{it.st}}">
              <text class="kb-key-text">{{it.label}}</text>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .page { width: 100%; height: 100%; flex-direction: column; background-color: #0d1117; }
  .hd { height: 40px; flex-direction: row; align-items: center; padding: 0 10px; }
  .hd-act { width: 20px; height: 20px; }
  .hd-title { font-size: 16px; font-weight: bold; color: #e6edf3; margin-left: 6px; flex: 1; }
  .body { flex: 1; }
  .shrink { margin-bottom: 152px; }
  .wrap { flex-direction: column; padding: 4px 10px 16px; }
  .card { background-color: #161b22; border-radius: 10px; padding: 10px; margin-bottom: 8px; flex-direction: column; }
  .c-title { font-size: 13px; color: #e6edf3; font-weight: bold; margin-bottom: 4px; }
  .c-row { font-size: 11px; color: #c9d1d9; }
  .c-row2 { font-size: 10px; color: #3fb950; margin-top: 3px; }
  .c-body { font-size: 10px; color: #8b949e; line-height: 15px; margin-top: 2px; }
  .warn { color: #d29922; }
  .cell { flex-direction: row; align-items: center; background-color: #161b22; border-radius: 10px; padding: 11px 10px; margin-bottom: 8px; }
  .cell-icon { width: 18px; height: 18px; }
  .cell-label { flex: 1; font-size: 13px; color: #e6edf3; margin-left: 8px; }
  .cell-arrow { width: 14px; height: 14px; }
  .input-card { background-color: #161b22; border: 1px solid #1f6feb; border-radius: 10px; padding: 10px; margin-bottom: 8px; flex-direction: column; }
  .tk-preview { font-size: 11px; color: #58a6ff; background-color: #0d1117; border-radius: 6px; padding: 6px 8px; lines: 2; text-overflow: ellipsis; }
  .tk-btns { flex-direction: row; margin-top: 8px; }
  .tk-btn { flex: 1; text-align: center; font-size: 12px; padding: 7px 0; border-radius: 14px; margin-right: 8px; }
  .tk-cancel { color: #8b949e; background-color: #21262d; }
  .tk-del { color: #f85149; background-color: #21262d; }
  .tk-save { color: #ffffff; background-color: #238636; margin-right: 0; }
  .kb-dock { position: absolute; left: 0; bottom: 0; width: 100%; height: 152px; }
  @media (shape: rect) {
    .kb-dock { bottom: auto; top: 93px; }
  }
  .kb-hide { display: none; }
  .kb-root { width: 100%; height: 152px; background-color: #161b22; border-top: 1px solid #30363d; flex-direction: column; }
  .kb-pad { flex-direction: column; justify-content: flex-start; width: 100%; height: 150px; padding: 3px 6px; }
  .kb-row { flex-direction: row; height: 33px; margin-bottom: 3px; width: 100%; }
  .kb-key { flex: 1; height: 33px; margin: 0 2px; justify-content: center; align-items: center; background-color: #21262d; border-radius: 4px; }
  .kb-key-text { font-size: 13px; color: #e6edf3; text-align: center; lines: 1; }
</style>

<script>
  import router from '@system.router'
  import prompt from '@system.prompt'
  import api from '../../utils/api'
  import { maskToken } from '../../utils/fmt'

  import { buildRows, applyRows } from '../../utils/kb'

  export default {
    private: {
      hasTk: false,
      tokenMask: '',
      rateText: '…',
      inputing: false,
      kbShow: false,
      row0: [],
      row1: [],
      row2: [],
      row3: [],
      kbMode: 'abc',
      kbShift: false,
      kbDraft: '',
      kbTail: ''
    },
    onInit() {
      this.refreshRows()
    },
    async onShow() {
      await api.loadToken()
      this.hasTk = api.hasToken()
      this.tokenMask = this.hasTk ? maskToken(api.currentToken()) : ''
      this.refreshRate()
    },
    async refreshRate() {
      try {
        const r = await api.getRateLimit()
        const core = r && r.resources && r.resources.core
        if (core) this.rateText = core.remaining + '/' + core.limit
      } catch (e) {
        this.rateText = '未知'
      }
    },
    /* ---- Token 输入 ---- */
    startInput() {
      this.inputing = true
      this.kbDraft = ''
      this.kbTail = ''
      this.kbShow = true
    },
    refreshRows() {
      const next = buildRows(this.kbMode, this.kbShift)
      if (!this.row0.length) {
        this.row0 = next[0]; this.row1 = next[1]; this.row2 = next[2]; this.row3 = next[3]
        return
      }
      applyRows([this.row0, this.row1, this.row2, this.row3], next)
    },
    onKey(it) {
      if (!it || !it.act) return
      const act = it.act
      if (act === 'char') {
        if (this.kbDraft.length < 64) {
          this.kbDraft += this.kbShift ? String(it.ch).toUpperCase() : it.ch
        }
        if (this.kbShift && this.kbMode === 'abc') {
          this.kbShift = false
          this.refreshRows()
        }
      } else if (act === 'del') {
        this.kbDraft = this.kbDraft.slice(0, -1)
      } else if (act === 'space') {
        if (this.kbDraft.length < 64) this.kbDraft += ' '
      } else if (act === 'ok') {
        this.kbShow = false
        this.onKbOk()
        return
      } else if (act === 'mode') {
        this.kbMode = this.kbMode === 'abc' ? '123' : 'abc'
        this.kbShift = false
        this.refreshRows()
      } else if (act === 'shift') {
        if (this.kbMode === 'abc') {
          this.kbShift = !this.kbShift
          this.refreshRows()
        }
      }
      this.syncTail()
    },
    onKbOk() {
      // 键盘「完成」仅收起键盘，保存走「保存」按钮，防误触
      this.kbShow = false
    },
    syncTail() {
      const d = this.kbDraft
      this.kbTail = d.length > 24 ? '…' + d.slice(-23) : d
    },
    cancelInput() {
      this.inputing = false
      this.kbShow = false
      this.kbDraft = ''
      this.kbTail = ''
    },
    clearInput() {
      this.kbDraft = ''
      this.kbTail = ''
    },
    async saveInput() {
      const t = this.kbDraft.trim()
      if (!t) {
        prompt.showToast({ message: '请先输入 Token', duration: 1500 })
        return
      }
      this.kbShow = false
      prompt.showToast({ message: '正在验证 Token…', duration: 1500 })
      try {
        await api.saveToken(t)
        const me = await api.self()
        this.hasTk = true
        this.tokenMask = maskToken(api.currentToken())
        this.inputing = false
        prompt.showToast({ message: '登录成功：' + (me.login || ''), duration: 2000 })
        this.refreshRate()
      } catch (e) {
        await api.clearToken()
        this.hasTk = api.hasToken()
        prompt.showToast({ message: 'Token 验证失败：' + ((e && e.message) || ''), duration: 2500 })
      }
    },
    async logout() {
      await api.clearToken()
      this.hasTk = false
      this.tokenMask = ''
      this.inputing = false
      this.kbShow = false
      prompt.showToast({ message: '已退出登录', duration: 1500 })
    },
    goBack() {
      router.back()
    }
  }
</script>
